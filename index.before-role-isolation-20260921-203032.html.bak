<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0a0a0c">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="私享衣橱">
<meta name="description" content="私人衣橱 · 你的赛博衣柜">
<title>私享衣橱</title>

<style>
  :root{
    --bg-base:#0a0a0c;
    --card-bg:rgba(18,18,22,.75);
    --card-border:rgba(255,182,193,.15);
    --pink:#ff7597;
    --pink-glow:rgba(255,117,151,.6);
    --text-main:#f5f5f7;
    --text-sub:#8e8e93;
    --drawer-bg:rgba(16,16,20,.97);
    /* 承载文字的表面一律用不透明底色，装饰绝不会从下面透上来 */
    --surface-1:#17171c;   /* 面板、衣物卡片 */
    --surface-2:#1e1e24;   /* 按钮、输入框、标签 */
    --surface-3:#26262e;   /* 选中态 / 略亮一层 */
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{width:100%;height:100%;overflow:hidden;background:var(--bg-base);
    font:14px/1.6 -apple-system,BlinkMacSystemFont,"PingFang SC","Segoe UI",Roboto,sans-serif;
    color:var(--text-main)}

  /* 独立 PWA：直接用标准 env(safe-area-inset-*)，适配刘海屏/小白条 */
  #app{position:relative;width:100%;height:100%;display:flex;flex-direction:column;overflow:hidden;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
    padding-left:env(safe-area-inset-left,0px);
    padding-right:env(safe-area-inset-right,0px);
    background:radial-gradient(circle at 50% 10%,#16151a 0%,var(--bg-base) 100%)}

  /* 被挂进悬浮窗/App 面板时外壳自带关闭键，收起自带顶栏 */
  html[data-nuo-slot] .topbar{display:none}

  /* ---------- 装饰层 ----------
   * 两处，各司其职，都在「文本框之下」：
   *
   * .deco (z 0)       屏幕级：顶栏、分类条、底栏、屏幕边缘的留白
   * .stage-deco (z 1) 卡片级：铺在大黑卡片的底色【之上】，但在内容 .scroll(z 2) 之下
   *                   → 所以它显现在卡片的空白区与面板缝隙里，
   *                     而面板/衣物卡都是不透明的(--surface-*)，绝不会挡住任何文本框。
   *
   * 关键教训：z-index 只决定谁画在上面；半透明的上层等于没有上层。
   * 所以凡是承载文字的表面一律用不透明底色，这才是「不挡文字」的真正保障。
   * 两层都 pointer-events:none，点击一律穿透。
   */
  .deco{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:0}
  .stage-deco{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:1}
  .ribbon{position:absolute;inset:0;width:100%;height:100%}
  /* viewBox 被 preserveAspectRatio="none" 拉伸时线宽会一起放大变成粗带子，
     non-scaling-stroke 让描边保持真实像素宽度，只拉伸路径形状。 */
  .ribbon path{vector-effect:non-scaling-stroke}
  /* ---------- 十字星：三种体型 + 两种节奏 ----------
   * .star     标准四芒星，呼吸式明暗
   * .star.sm  小碎星，更淡更快，用来填缝隙
   * .star.lg  主星，更大更亮，做视觉锚点
   * .star.tw  闪烁节奏（不是呼吸），偶尔"眨"一下，避免满屏同频显得呆板
   * .star.spin 极慢自转，只给主星用
   *
   * 光晕必须「贴着」星形轮廓：drop-shadow 的模糊半径一旦接近或超过星形尺寸，
   * 光晕就会糊成一个圆盘，看起来像个圆圈里嵌了颗星。所以半径一律取小值，
   * 并且绝不叠加第二层大半径阴影。
   */
  .star{position:absolute;fill:var(--pink);filter:drop-shadow(0 0 2px var(--pink-glow));
    opacity:.85;animation:pulse 3s ease-in-out infinite alternate}
  .star.sm{fill:#ffb3c6;filter:drop-shadow(0 0 1.5px rgba(255,179,198,.5));
    animation-duration:2.2s;opacity:.6}
  .star.lg{fill:#ffc2d2;filter:drop-shadow(0 0 3px var(--pink-glow))}
  .star.tw{animation-name:twinkle;animation-duration:4.5s;animation-direction:normal}
  .star.spin{animation-name:pulse-spin;animation-duration:9s;animation-direction:normal;
    animation-timing-function:linear}
  @keyframes pulse{0%{transform:scale(.85);opacity:.45}100%{transform:scale(1.15);opacity:1}}
  /* 闪烁：大部分时间安静，短暂亮起再回落 */
  @keyframes twinkle{
    0%,62%{transform:scale(.7);opacity:.22}
    72%{transform:scale(1.25);opacity:1}
    82%{transform:scale(.92);opacity:.5}
    90%{transform:scale(1.05);opacity:.8}
    100%{transform:scale(.7);opacity:.22}
  }
  /* 自转 + 呼吸，给主星用 */
  @keyframes pulse-spin{
    0%{transform:rotate(0deg) scale(.9);opacity:.5}
    50%{transform:rotate(180deg) scale(1.12);opacity:1}
    100%{transform:rotate(360deg) scale(.9);opacity:.5}
  }

  /* ---------- 顶栏 ---------- */
  .topbar{position:relative;z-index:10;flex-shrink:0;display:flex;flex-direction:column;gap:10px;
    padding:10px 16px 0}
  .bar-row{display:flex;align-items:center;gap:8px}
  .ibtn{width:40px;height:40px;flex:0 0 auto;border:1px solid rgba(255,255,255,.08);
    background:var(--surface-2);border-radius:20px;color:#ddd;font-size:16px;
    display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.18s}
  .ibtn:active{transform:scale(.92)}
  .brand{display:flex;align-items:center;gap:7px;flex:1;min-width:0}
  .brand img{width:22px;height:22px;flex:0 0 auto;border-radius:7px;object-fit:cover;
    box-shadow:0 0 7px rgba(255,117,151,.3)}
  .brand b{font-size:19px;font-weight:700;letter-spacing:.5px;color:#fff;white-space:nowrap}
  .brand i{font-style:normal;font-size:9px;padding:2px 7px;border-radius:10px;
    background:#3a2129;color:var(--pink);font-weight:600;letter-spacing:1px;
    border:1px solid rgba(255,117,151,.3);white-space:nowrap}
  .search{flex:1;display:flex;align-items:center;gap:7px;padding:7px 12px;border-radius:20px;
    background:var(--surface-2);border:1px solid rgba(255,255,255,.08)}
  .search input{flex:1;background:none;border:none;outline:none;color:#fff;font-size:16px;min-width:0}
  .search input::placeholder{color:#6d6d72;font-size:13px}
  .env{font-size:9px;padding:4px 7px;border-radius:8px;border:1px solid rgba(255,255,255,.12);
    background:var(--surface-2);color:var(--text-sub);white-space:nowrap;flex:0 0 auto}

  /* ---------- 分类条 ---------- */
  .cats{position:relative;z-index:10;flex-shrink:0;display:flex;gap:8px;padding:10px 16px 2px;
    overflow-x:auto;scrollbar-width:none}
  .cats::-webkit-scrollbar{display:none}
  .cat{flex:0 0 auto;background:var(--surface-2);border:1px solid rgba(255,255,255,.08);
    color:var(--text-sub);padding:8px 14px;border-radius:16px;font-size:13px;cursor:pointer;
    transition:.18s;white-space:nowrap}
  .cat.on{background:#40222c;border-color:var(--pink);color:#fff;
    box-shadow:0 0 10px rgba(255,117,151,.2)}

  /* ---------- 主舞台 ----------
   * 卡片底色之上叠 .stage-deco(z1)，内容 .scroll(z2) 再叠在装饰上。
   * 层序：卡片底色 → 装饰 → 面板/衣物卡（不透明）→ 文字。 */
  .stage{position:relative;z-index:10;flex:1;min-height:0;margin:10px 16px 0;border-radius:24px;
    background:var(--card-bg);border:1px solid var(--card-border);
    backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
    box-shadow:inset 0 0 20px rgba(0,0,0,.5),0 8px 32px rgba(0,0,0,.4);
    display:flex;flex-direction:column;overflow:hidden}
  .scroll{position:relative;z-index:2;flex:1;min-height:0;overflow-y:auto;
    -webkit-overflow-scrolling:touch;padding:14px}
  .page{display:none}
  .page.on{display:block}

  /* 瀑布流：长图占长格、短图占短格 */
  .grid{column-count:2;column-gap:10px}
  .item{position:relative;break-inside:avoid;margin-bottom:10px;border-radius:14px;overflow:hidden;
    background:var(--surface-1);border:1px solid rgba(255,255,255,.07);cursor:pointer}
  .item.on{border-color:var(--pink);box-shadow:0 0 0 1px var(--pink),0 0 14px rgba(255,117,151,.35)}
  /* 选中的衣物卡左上角冒一颗星，呼应「被他挑中了」 */
  .item.on::after{content:'';position:absolute;top:6px;left:6px;width:13px;height:13px;z-index:3;
    background:#ffd0dd;filter:drop-shadow(0 0 2.5px var(--pink-glow));
    clip-path:polygon(50% 0%,54% 44%,100% 50%,54% 56%,50% 100%,46% 56%,0% 50%,46% 44%);
    animation:pulse 2s ease-in-out infinite alternate;pointer-events:none}
  body.pickmode .item.on::after{display:none}
  .item.shake{animation:shake .32s ease}
  @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-3px)}75%{transform:translateX(3px)}}
  .item .ph{width:100%;background:#15151a;display:flex;align-items:center;justify-content:center}
  .item .ph img{width:100%;height:100%;object-fit:cover;display:block}
  .item .ph span{font-size:26px;opacity:.25}
  .meta{padding:7px 9px 9px}
  .meta .nm{font-size:12.5px;font-weight:600;color:#eee;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .meta .bd{font-size:10px;color:var(--text-sub);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .tagline{display:flex;flex-wrap:wrap;gap:3px;margin-top:5px}
  .mini{font-size:9px;padding:1px 6px;border-radius:7px;background:#3a2129;
    color:#ffa8bf;border:1px solid rgba(255,117,151,.2)}
  .dot{position:absolute;top:7px;right:7px;width:20px;height:20px;border-radius:50%;
    border:1.5px solid rgba(255,255,255,.6);background:rgba(0,0,0,.45);display:none;
    align-items:center;justify-content:center;font-size:11px;color:#fff}
  body.pickmode .dot{display:flex}
  .item.on .dot{background:var(--pink);border-color:var(--pink)}
  .trashbtn{position:absolute;top:7px;left:7px;width:24px;height:24px;border-radius:50%;
    background:rgba(0,0,0,.6);border:1px solid rgba(255,117,151,.4);color:#ffa8bf;font-size:11px;
    display:none;align-items:center;justify-content:center}
  .item.armed .trashbtn{display:flex}

  /* 空状态 */
  .empty{min-height:260px;display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;gap:12px;padding:30px 20px}
  .empty .box{position:relative;width:76px;height:76px;border-radius:20px;
    border:1.5px dashed rgba(255,117,151,.4);overflow:visible;
    display:flex;align-items:center;justify-content:center;background:rgba(255,117,151,.04)}
  .empty svg:not(.star){width:36px;height:36px;stroke:var(--pink);stroke-width:1.5;fill:none}
  .empty h4{font-size:15px;font-weight:600;color:#eee;letter-spacing:.5px}
  .empty p{font-size:12px;color:var(--text-sub);line-height:1.7;max-width:240px}

  /* ---------- 面板通用 ----------
   * 背景必须不透明：之前用 rgba(255,255,255,.03) 几乎全透明，
   * 底层装饰会直接透过面板显在文字上，看起来就像装饰盖住了文字。 */
  .panel{border:1px solid rgba(255,255,255,.08);background:var(--surface-1);
    border-radius:16px;padding:14px;margin-bottom:10px}
  .panel h3{font-size:14px;color:#fff;margin-bottom:8px;display:flex;align-items:center;gap:7px;flex-wrap:wrap}
  /* 面板标题前的小星星，纯 CSS 不占 DOM */
  .panel h3::before{content:'';flex:0 0 auto;width:9px;height:9px;
    background:var(--pink);opacity:.9;
    filter:drop-shadow(0 0 1.5px var(--pink-glow));
    clip-path:polygon(50% 0%,54% 44%,100% 50%,54% 56%,50% 100%,46% 56%,0% 50%,46% 44%);
    animation:pulse 3s ease-in-out infinite alternate}
  /* 抽屉标题同款 */
  .drawer h2::before{content:'';display:inline-block;width:10px;height:10px;margin-right:7px;
    vertical-align:baseline;background:var(--pink);
    filter:drop-shadow(0 0 2px var(--pink-glow));
    clip-path:polygon(50% 0%,54% 44%,100% 50%,54% 56%,50% 100%,46% 56%,0% 50%,46% 44%);
    animation:pulse 3.4s ease-in-out infinite alternate}
  .panel p{font-size:11.5px;color:var(--text-sub);line-height:1.75}
  /* 统计面板：每个维度一行，标题加粗 */
  .stat-line{font-size:11.5px;color:var(--text-sub);line-height:1.75;padding:2px 0}
  .stat-line b{color:#ccc;font-weight:600;margin-right:8px;white-space:nowrap}
  .stat-line + .stat-line{border-top:1px solid rgba(255,255,255,.05)}
  .badge{font-size:9px;padding:2px 7px;border-radius:8px;background:#3a2129;
    color:var(--pink);border:1px solid rgba(255,117,151,.25);font-weight:600}
  /* 搭配册标题：点一下就能改名，虚线下划线提示可编辑 */
  .look-name{font-size:14px;font-weight:600;color:#fff;cursor:pointer;
    border-bottom:1px dashed rgba(255,117,151,.45);padding-bottom:1px}
  .look-name:active{color:var(--pink)}
  .look-name.auto{color:#c8c8cf;font-weight:500}
  .hrow{display:flex;gap:8px;overflow-x:auto;padding:6px 0 2px;scrollbar-width:none}
  .hrow::-webkit-scrollbar{display:none}
  .charchip{flex:0 0 auto;padding:9px 13px;border-radius:14px;font-size:12.5px;cursor:pointer;
    background:var(--surface-2);border:1px solid rgba(255,255,255,.1);color:#ddd;transition:.18s}
  .charchip.on{background:#40222c;border-color:var(--pink);color:#fff}
  .verdict{white-space:pre-wrap;font-size:13px;line-height:1.85;color:#ececf0;
    background:#1c1a1f;border:1px solid rgba(255,117,151,.2);
    border-radius:14px;padding:13px;margin-top:10px;min-height:56px;user-select:text}
  .thumbline{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
  .thumbline img{width:52px;height:66px;object-fit:cover;border-radius:8px;
    border:1px solid rgba(255,255,255,.12);background:#15151a}
  .genbox{margin-top:10px}
  .genbox img{width:100%;border-radius:14px;border:1px solid rgba(255,117,151,.25);display:block}

  /* ---------- 搭配模式：文本 / 识图 二选一 ---------- */
  .mode-block{margin-top:12px;display:flex;flex-direction:column;gap:7px}
  .mode-row{display:flex;align-items:flex-start;gap:9px;padding:10px 11px;border-radius:13px;
    background:var(--surface-2);border:1px solid rgba(255,255,255,.08);cursor:pointer;transition:.18s}
  .mode-row.on{background:#40222c;border-color:rgba(255,117,151,.55)}
  .mode-row input{width:17px;height:17px;flex:0 0 auto;margin-top:1px;accent-color:#ff7597}
  .mode-txt{display:flex;flex-direction:column;gap:2px;min-width:0}
  .mode-txt b{font-size:12.5px;font-weight:600;color:#eee}
  .mode-row.on .mode-txt b{color:#fff}
  .mode-txt i{font-style:normal;font-size:10.5px;color:var(--text-sub);line-height:1.6}
  .vision-opt{display:none;align-items:center;gap:8px;padding:9px 11px;border-radius:13px;
    background:var(--surface-2);border:1px solid rgba(255,117,151,.2);font-size:11.5px;color:var(--text-sub)}
  .vision-opt.on{display:flex}
  .vision-opt .step{width:30px;height:30px;flex:0 0 auto;border-radius:9px;
    border:1px solid rgba(255,255,255,.12);background:var(--surface-3);color:#ddd;
    font-size:15px;line-height:1;cursor:pointer}
  .vision-opt .step:active{transform:scale(.92)}
  .vision-opt .step:disabled{opacity:.35}
  .vision-opt input{width:52px;flex:0 0 auto;text-align:center;padding:7px 4px;border-radius:9px;
    background:var(--surface-3);border:1px solid rgba(255,255,255,.12);color:#fff;
    font-size:16px;font-family:inherit;outline:none;-moz-appearance:textfield}
  .vision-opt input::-webkit-outer-spin-button,
  .vision-opt input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .vision-opt input:focus{border-color:rgba(255,117,151,.6)}
  .vision-tip{flex:1;min-width:0;font-size:10.5px;line-height:1.5}

  /* ---------- 悬浮气泡 ---------- */
  .fabs{position:absolute;right:20px;bottom:96px;z-index:20;display:flex;flex-direction:column;gap:10px}
  .fab{position:relative;width:50px;height:50px;border-radius:25px;border:none;cursor:pointer;color:#fff;
    display:flex;align-items:center;justify-content:center;transition:transform .15s}
  .fab:active{transform:scale(.94)}
  /* 悬浮按钮的伴星，斜挂在右上角 */
  .fab.main::after{content:'';position:absolute;top:-3px;right:-2px;width:12px;height:12px;
    background:#ffd0dd;filter:drop-shadow(0 0 2.5px var(--pink-glow));
    clip-path:polygon(50% 0%,54% 44%,100% 50%,54% 56%,50% 100%,46% 56%,0% 50%,46% 44%);
    animation:pulse 2.6s ease-in-out infinite alternate;pointer-events:none}
  .fab.main{background:linear-gradient(135deg,#ff6b8b,#ff8da5);font-size:22px;
    box-shadow:0 4px 18px rgba(255,107,139,.4)}
  .fab.alt{background:#1a1a20;border:1px solid rgba(255,117,151,.45);font-size:18px;
    box-shadow:0 4px 16px rgba(0,0,0,.5)}

  /* ---------- 底栏 ---------- */
  .nav{position:relative;z-index:20;flex-shrink:0;display:flex;gap:6px;padding:10px 16px}
  .nav button{flex:1;min-height:44px;border-radius:16px;border:1px solid rgba(255,117,151,.65);
    background:var(--surface-2);color:var(--text-sub);font-size:12px;cursor:pointer;transition:.18s}
  .nav button.on{background:#40222c;border-color:#ff8eaf;color:#fff}
  .settings-footer{position:sticky;bottom:0;padding:12px 0;background:var(--surface);z-index:2}
  .settings-footer .btn{width:100%}
  .settings-heading{display:flex;align-items:center;gap:10px;margin-bottom:14px}
  .settings-heading h3{margin:0;overflow-wrap:anywhere}
  .role-link-list{margin:12px 0}
  .role-link-list .btn{display:block;width:100%;text-align:left;margin:6px 0}

  /* ---------- 多选条 ---------- */
  .selbar{position:absolute;left:16px;right:16px;bottom:86px;z-index:30;display:none;gap:6px;
    padding:8px;border-radius:18px;background:#101014;
    border:1px solid rgba(255,117,151,.3);box-shadow:0 8px 28px rgba(0,0,0,.6)}
  body.pickmode .selbar{display:flex}
  .selbar button{flex:1;min-height:40px;border-radius:12px;border:1px solid rgba(255,255,255,.1);
    background:var(--surface-2);color:#ddd;font-size:11px;cursor:pointer;padding:4px 2px}
  .selbar button.danger{color:#ff8fa8;border-color:rgba(255,117,151,.35)}

  /* ---------- 抽屉（绝对定位在 #app 内，不用 vh） ---------- */
  .mask{position:absolute;inset:0;z-index:40;background:rgba(0,0,0,.62);
    opacity:0;pointer-events:none;transition:opacity .25s}
  .mask.open{opacity:1;pointer-events:auto}
  .drawer{position:absolute;left:0;right:0;bottom:0;z-index:50;max-height:92%;overflow-y:auto;
    -webkit-overflow-scrolling:touch;background:var(--drawer-bg);
    border-top:1px solid rgba(255,117,151,.25);border-radius:26px 26px 0 0;
    padding:8px 18px calc(env(safe-area-inset-bottom,0px) + 18px);
    transform:translateY(102%);transition:transform .3s cubic-bezier(.22,.8,.3,1)}
  .drawer.open{transform:translateY(0)}
  .grip{width:42px;height:4px;border-radius:3px;background:rgba(255,255,255,.2);margin:6px auto 12px}
  .drawer h2{font-size:16px;color:#fff;margin-bottom:5px}
  .hint{font-size:11.5px;color:var(--text-sub);margin-bottom:14px;line-height:1.7}
  .f{margin-bottom:12px}
  .f label{display:block;font-size:11px;color:var(--text-sub);margin-bottom:5px}
  .f label i{color:#5a5a5f;font-style:normal}
  /* 注意用 :not() 排除法，别写 input[type=text]——那样 password / number / url
     这些都会掉回浏览器默认样式（API Key 框之前就是这么变成方框的）。 */
  .f input:not([type=color]):not([type=range]):not([type=checkbox]):not([type=radio]):not([type=file]),
  .f textarea,.f select{width:100%;padding:11px 12px;border-radius:12px;
    background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#fff;
    font-size:16px;outline:none;font-family:inherit;
    -webkit-appearance:none;appearance:none;box-sizing:border-box}
  /* 密码点阵默认字间距很挤，单独放宽一点 */
  .f input[type=password]{letter-spacing:2px}
  .f input[type=password]::placeholder{letter-spacing:0}
  .f textarea{min-height:58px;resize:vertical}
  .f input:focus,.f textarea:focus{border-color:rgba(255,117,151,.55)}
  .drop{border:1.5px dashed rgba(255,117,151,.4);border-radius:16px;padding:16px;text-align:center;
    background:rgba(255,117,151,.04);cursor:pointer}
  .drop.hot{background:rgba(255,117,151,.12);border-color:var(--pink)}
  .drop p{font-size:11.5px;color:var(--text-sub);line-height:1.7}
  .pvs{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
  /* ---------- 带下拉的输入框（模型选择）----------
   * 原来用 <datalist>：手机 Chrome 上它不是下拉面板，而是贴在输入法上方的
   * 一条横向候选条，又小又难点，还跟系统键盘的联想混在一起。
   * 所以自己做：输入框右侧一个足够大的按钮，点开一个可搜索的竖向列表。 */
  .combo{position:relative;display:flex;align-items:stretch;gap:0}
  .combo input{flex:1;min-width:0;border-top-right-radius:0!important;
    border-bottom-right-radius:0!important;border-right:none!important}
  .combo .cbtn{flex:0 0 auto;width:46px;border-radius:0 12px 12px 0;
    background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);
    border-left:1px solid rgba(255,255,255,.08);
    color:var(--pink);cursor:pointer;display:flex;align-items:center;
    justify-content:center;padding:0;transition:background .16s}
  .combo .cbtn:active{background:rgba(255,117,151,.2)}
  .combo .cbtn svg{width:13px;height:13px;fill:currentColor;display:block}

  /* 模型列表抽屉 */
  .picklist{max-height:52vh;overflow-y:auto;-webkit-overflow-scrolling:touch;
    margin:4px -4px 0;padding:0 4px}
  .picklist .pk{padding:12px 13px;border-radius:11px;background:var(--surface-2);
    border:1px solid rgba(255,255,255,.07);margin-bottom:6px;font-size:13px;
    color:#e8e8ee;cursor:pointer;word-break:break-all;line-height:1.5;
    transition:background .14s}
  .picklist .pk:active{background:#40222c}
  .picklist .pk.on{border-color:rgba(255,117,151,.5);background:#40222c;color:#fff}
  .picklist .pk b{color:var(--pink);font-weight:600}
  .picklist .none{padding:18px 4px;text-align:center;font-size:12px;color:var(--text-dim)}

  .autotag-row{display:flex;gap:8px;align-items:center;margin-top:10px}
  /* 选衣服抽屉里的网格 */
  .pick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  .pick-cell{position:relative;border-radius:10px;overflow:hidden;cursor:pointer;
    border:2px solid transparent;transition:.18s;background:var(--surface-1)}
  .pick-cell.on{border-color:var(--pink);box-shadow:0 0 10px rgba(255,117,151,.3)}
  .pick-cell img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block}
  .pick-cell .pc-name{font-size:10px;color:var(--text-sub);padding:3px 5px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pick-cell .pc-check{position:absolute;top:4px;right:4px;width:20px;height:20px;border-radius:50%;
    border:1.5px solid rgba(255,255,255,.6);background:rgba(0,0,0,.5);
    display:flex;align-items:center;justify-content:center;font-size:11px;color:#fff}
  .pick-cell.on .pc-check{background:var(--pink);border-color:var(--pink)}
  .pick-cell.disabled{opacity:.35;pointer-events:none}
  .autotag-row select{flex:0 0 auto;width:80px;padding:9px 6px;border-radius:14px;
    background:var(--surface-2);border:1px solid rgba(255,255,255,.1);color:#ddd;
    font-size:12px;font-family:inherit;outline:none;-webkit-appearance:none;appearance:none;
    text-align:center}
  .pv{position:relative;width:62px;height:62px;border-radius:10px;overflow:hidden;
    border:1px solid rgba(255,255,255,.12)}
  .pv img{width:100%;height:100%;object-fit:cover}
  .pv span{position:absolute;top:0;right:0;width:18px;height:18px;background:rgba(0,0,0,.7);
    color:#ff8fa8;font-size:10px;display:flex;align-items:center;justify-content:center}
  .tg{margin-bottom:11px}
  .tg .gn{display:flex;align-items:center;gap:8px;font-size:10px;color:#6d6d72;margin-bottom:5px}
  .tg .gn-del{margin-left:auto;padding:2px 8px;border-radius:8px;font-size:9.5px;
    border:1px solid rgba(255,117,151,.28);background:none;color:#ff8fa8;cursor:pointer;font-family:inherit}
  .chips{display:flex;flex-wrap:wrap;gap:6px}
  .chip{padding:7px 12px;border-radius:14px;font-size:12px;cursor:pointer;
    background:var(--surface-2);border:1px solid rgba(255,255,255,.1);color:#bbb;transition:.15s}
  .chip.on{background:#40222c;border-color:var(--pink);color:#fff}
  /* 自己加的标签带一点粉边，和预设区分开 */
  .chip.mine{border-color:rgba(255,117,151,.32);border-style:dashed}
  .chip.mine.on{border-style:solid}
  /* 每栏的「＋」按钮 */
  .chip.add{border-style:dashed;border-color:rgba(255,117,151,.45);color:var(--pink);
    font-family:inherit;line-height:1;padding:7px 13px}
  .chip.add:active{background:#40222c}
  .chip.add.wide{width:100%;padding:9px;font-size:11.5px}
  /* 就地输入行 */
  .tg-input{display:flex;gap:6px;margin-top:7px}
  .tg-input input{flex:1;min-width:0;padding:9px 11px;border-radius:12px;
    background:var(--surface-3);border:1px solid rgba(255,117,151,.4);color:#fff;
    font-size:16px;font-family:inherit;outline:none}
  .tg-input .tg-ok{flex:0 0 auto;padding:0 15px;border-radius:12px;font-size:12px;
    border:1px solid rgba(255,117,151,.5);background:#40222c;color:#fff;cursor:pointer;font-family:inherit}
  .row{display:flex;gap:8px}
  .row>*{flex:1;min-width:0}
  .btn{width:100%;min-height:46px;padding:12px;border:none;border-radius:18px;font-size:14px;
    font-weight:600;letter-spacing:.5px;cursor:pointer;transition:transform .15s;font-family:inherit}
  .btn:active{transform:scale(.98)}
  .btn:disabled{opacity:.45}
  .btn.pri{background:linear-gradient(135deg,#ff6b8b,#ff8da5);color:#fff;
    box-shadow:0 4px 18px rgba(255,107,139,.32)}
  .btn.gh{background:rgba(255,255,255,.06);color:#ccc;border:1px solid rgba(255,255,255,.1)}
  .btn.dg{background:rgba(255,80,110,.14);color:#ff8fa8;border:1px solid rgba(255,117,151,.35)}
  .btn.sm{min-height:40px;font-size:12.5px;padding:9px;border-radius:14px}
  .lrow{display:flex;align-items:center;gap:8px;padding:9px 11px;border-radius:13px;
    background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);margin-bottom:7px}
  .lrow .nm{flex:1;min-width:0;font-size:13px;color:#eee;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .lrow .ct{font-size:10px;color:var(--text-sub);flex:0 0 auto}
  .lrow button{min-height:36px;padding:6px 11px;border-radius:10px;font-size:11px;
    border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:#ccc;cursor:pointer;flex:0 0 auto}
  .lrow button.d{color:#ff8fa8;border-color:rgba(255,117,151,.3)}
  .lrow img{width:36px;height:36px;border-radius:8px;object-fit:cover;background:#15151a;flex:0 0 auto}

  /* ---------- 大图 ---------- */
  .lb{position:absolute;inset:0;z-index:60;background:rgba(0,0,0,.93);display:none;
    align-items:center;justify-content:center;flex-direction:column;gap:14px;padding:24px;overflow:hidden}
  .lb.open{display:flex}
  /* 大图预览四角的静态星芒，衬托而不抢戏 */
  .lb::before,.lb::after{content:'';position:absolute;width:14px;height:14px;
    background:var(--pink);opacity:.5;filter:drop-shadow(0 0 3px var(--pink-glow));
    clip-path:polygon(50% 0%,54% 44%,100% 50%,54% 56%,50% 100%,46% 56%,0% 50%,46% 44%);
    animation:pulse 3.6s ease-in-out infinite alternate;pointer-events:none}
  .lb::before{top:34px;left:26px}
  .lb::after{bottom:38px;right:30px;width:10px;height:10px;animation-delay:1.4s}
  .lb img{max-width:100%;max-height:68%;border-radius:12px;object-fit:contain}
  .lb .info{text-align:center;font-size:12px;color:var(--text-sub);line-height:1.8;user-select:text}
  .lb .info b{color:#fff;font-size:14px;display:block;margin-bottom:3px}

  /* ---------- Toast ---------- */
  .toasts{position:absolute;left:16px;right:16px;bottom:100px;z-index:70;
    display:flex;flex-direction:column;gap:8px;pointer-events:none}
  .toast{display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:14px;
    background:rgba(20,20,24,.97);border:1px solid rgba(255,117,151,.28);
    box-shadow:0 6px 24px rgba(0,0,0,.6);font-size:12.5px;color:#eee;
    pointer-events:auto;animation:tin .25s ease}
  @keyframes tin{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
  .toast .u{margin-left:auto;color:var(--pink);font-weight:600;cursor:pointer;white-space:nowrap}
  .spin{display:inline-block;width:11px;height:11px;border:2px solid rgba(255,117,151,.3);
    border-top-color:var(--pink);border-radius:50%;animation:sp .7s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}

  /* ================= 聊天页 ================= */
  /* 两级结构：#chatList（选人）↔ #chatRoom（跟某个人聊）。
     同一时刻只显示一个，这样不同角色的对话彻底隔离，不会互相看见。 */
  #pgChat{display:none;flex-direction:column;height:100%;position:relative}
  #pgChat.on{display:flex}

  /* ---------- 一级：会话列表 ---------- */
  .chatlist{flex:1;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;
    display:flex;flex-direction:column;gap:6px;padding:2px 2px 12px}
  .chatlist.hide{display:none}
  /* 细长条：角色多了也能一屏看下好几个 */
  .convo{display:flex;gap:10px;align-items:center;padding:7px 11px;border-radius:13px;
    background:var(--surface-1);border:1px solid rgba(255,255,255,.08);
    cursor:pointer;transition:background .18s,border-color .18s,transform .12s;
    position:relative}
  .convo:active{transform:scale(.99);background:var(--surface-2)}
  .convo.on{border-color:rgba(255,117,151,.35)}
  .convo img{width:34px;height:34px;min-width:34px;min-height:34px;flex:0 0 auto;
    border-radius:50%;object-fit:cover;object-position:center;aspect-ratio:1/1;
    background:#2a2a30;display:block;border:1px solid rgba(255,255,255,.12)}
  .convo .cmeta{flex:1;min-width:0}
  .convo .cname{display:flex;align-items:baseline;gap:6px;margin-bottom:1px}
  .convo .cname b{font-size:13px;color:#fff;overflow:hidden;
    text-overflow:ellipsis;white-space:nowrap;font-weight:600}
  .convo .cname .t{margin-left:auto;font-size:10px;color:var(--text-dim);flex-shrink:0}
  .convo .clast{font-size:11px;color:var(--text-sub);overflow:hidden;
    text-overflow:ellipsis;white-space:nowrap;line-height:1.45}
  .convo .clast.empty{color:var(--text-dim);font-style:italic}
  /* 未读小点 */
  .convo .dot{position:absolute;top:10px;right:11px;width:7px;height:7px;border-radius:50%;
    background:var(--pink);box-shadow:0 0 6px var(--pink-glow)}

  /* ---------- 二级：聊天室 ---------- */
  .chatroom{flex:1;min-height:0;display:none;flex-direction:column;position:relative}
  .chatroom.on{display:flex}

  /* 聊天室顶部：返回 + 当前角色 */
  .roomhead{flex-shrink:0;display:flex;align-items:center;gap:9px;padding:0 2px 9px;
    border-bottom:1px solid rgba(255,255,255,.07);margin-bottom:8px;position:relative;z-index:2}
  .roomhead .back{width:30px;height:30px;flex:0 0 auto;border-radius:9px;
    border:1px solid rgba(255,255,255,.12);background:var(--surface-2);color:var(--pink);
    font-size:17px;line-height:1;cursor:pointer;display:flex;align-items:center;
    justify-content:center;padding:0}
  .roomhead img{width:32px;height:32px;min-width:32px;min-height:32px;flex:0 0 auto;
    border-radius:50%;object-fit:cover;aspect-ratio:1/1;background:#2a2a30;display:block}
  .roomhead .rname{flex:1;min-width:0;font-size:14px;color:#fff;font-weight:600;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .roomhead .rops{display:flex;gap:5px;flex-shrink:0}
  .roomhead .rops button{width:30px;height:30px;border-radius:9px;
    border:1px solid rgba(255,255,255,.12);background:var(--surface-2);
    color:var(--text-sub);font-size:13px;cursor:pointer;padding:0;
    display:flex;align-items:center;justify-content:center}

  /* 聊天背景图：铺在消息流底下，可调暗度 */
  .chatbg{position:absolute;inset:0;z-index:0;pointer-events:none;
    background-size:cover;background-position:center;background-repeat:no-repeat;
    border-radius:12px;overflow:hidden}
  .chatbg::after{content:'';position:absolute;inset:0;
    background:rgba(10,10,12,var(--bg-dim,.55))}

  /* 消息流 */
  .msgs{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;
    display:flex;flex-direction:column;gap:11px;padding:6px 2px 12px;min-height:0;
    position:relative;z-index:1;
    font-size:var(--chat-fs,13.5px);
    font-family:var(--chat-ff,inherit)}
  .msg{display:flex;gap:9px;align-items:flex-start;max-width:100%;animation:min .22s ease}
  @keyframes min{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
  .msg.me{flex-direction:row-reverse}
  .msg .av{width:34px;height:34px;min-width:34px;min-height:34px;flex:0 0 auto;
    border-radius:50%;object-fit:cover;object-position:center;aspect-ratio:1/1;
    background:#2a2a30;border:1px solid rgba(255,255,255,.1);cursor:pointer;display:block}
  .msg .bub{position:relative;max-width:calc(100% - 56px);padding:10px 13px;border-radius:15px;
    font-size:inherit;line-height:1.72;word-break:break-word;white-space:pre-wrap;
    background:var(--panel);border:1px solid rgba(255,255,255,.07);color:#ececf0}
  .msg.me .bub{background:rgba(255,117,151,.15);border-color:rgba(255,117,151,.32);color:#fff}
  .msg .bub .nm{font-size:10.5px;color:var(--text-dim);margin-bottom:4px;letter-spacing:.3px}
  /* 沉浸式动作描写：*抬眼* 渲染成灰色斜体 */
  .msg .bub i.act{color:#9a9aa2;font-style:italic;opacity:.92}
  /* 系统提示（存了搭配、发了卡片…） */
  .msg.sys{justify-content:center}
  .msg.sys .bub{background:rgba(255,255,255,.04);border-style:dashed;border-color:rgba(255,255,255,.12);
    color:var(--text-dim);font-size:11.5px;text-align:center;max-width:86%;white-space:normal}
  .msg .ts{font-size:10px;color:var(--text-dim);text-align:center;margin:2px 0}

  /* 聊天里的穿搭卡片 */
  .lookcard{margin-top:8px;border-radius:12px;overflow:hidden;
    border:1px solid rgba(255,117,151,.3);background:rgba(0,0,0,.34)}
  .lookcard .thumbs{display:flex;gap:3px;padding:3px;flex-wrap:wrap}
  .lookcard .thumbs img{width:52px;height:68px;object-fit:cover;border-radius:7px;background:#222}
  .lookcard .cap{padding:7px 10px 9px;font-size:11.5px;color:var(--text-sub);line-height:1.6}
  .lookcard .cap b{display:block;color:#fff;font-size:12.5px;margin-bottom:2px}

  /* 打字指示 */
  .typing{display:flex;gap:4px;align-items:center;padding:3px 0}
  .typing i{width:6px;height:6px;border-radius:50%;background:var(--pink);opacity:.5;
    animation:bounce 1.15s ease-in-out infinite}
  .typing i:nth-child(2){animation-delay:.16s}
  .typing i:nth-child(3){animation-delay:.32s}
  @keyframes bounce{0%,60%,100%{transform:translateY(0);opacity:.45}
    30%{transform:translateY(-5px);opacity:1}}

  /* ---------- 输入区 ----------
   * 两个按钮，各管各的：
   *   ↑  发送：只把你这句加进对话，他不回复（可以连发好几句）
   *   ✦  回复：让他把你刚才说的几句一起看完再回
   * 这样就能像真人发微信那样一句一句说完再等对方回。 */
  .composer{flex-shrink:0;display:flex;gap:7px;align-items:flex-end;padding:8px 0 2px;
    border-top:1px solid rgba(255,255,255,.07);position:relative;z-index:2}
  .composer textarea{flex:1;min-width:0;resize:none;max-height:110px;
    padding:9px 12px;border-radius:15px;background:var(--input-bg);
    border:1px solid rgba(255,255,255,.1);color:#fff;font-size:16px;line-height:1.5;
    font-family:inherit}
  .composer textarea:focus{outline:none;border-color:rgba(255,117,151,.5)}
  .composer .btns{display:flex;gap:6px;flex-shrink:0;align-items:center}
  /* 两个键统一长相：黑底 + 粉色细边 + 粉色图标。
     区别只在图标：猫爪＝只是发出去，十字星＝让他回。 */
  .composer .sbtn{flex:0 0 auto;width:40px;height:40px;border-radius:50%;
    background:#121216;border:1px solid rgba(255,117,151,.55);
    cursor:pointer;display:flex;align-items:center;justify-content:center;
    transition:transform .14s,opacity .14s,box-shadow .18s;padding:0;position:relative}
  .composer .sbtn svg{fill:var(--pink);display:block;
    filter:drop-shadow(0 0 2px rgba(255,117,151,.45))}
  .composer .sbtn:active{transform:scale(.9)}
  .composer .sbtn:disabled{opacity:.38;cursor:default}
  .composer .sbtn.send svg{width:20px;height:20px}
  /* 回复键是主操作，边框亮一点、带一圈很淡的外发光 */
  .composer .sbtn.reply{border-color:var(--pink);
    box-shadow:0 0 10px rgba(255,117,151,.22)}
  .composer .sbtn.reply svg{width:19px;height:19px}
  .composer .sbtn.reply.busy{animation:replyPulse 1.1s ease-in-out infinite}
  @keyframes replyPulse{0%,100%{opacity:1}50%{opacity:.45}}
  /* 攒了几句没让他回时，回复键上挂个角标 */
  .composer .sbtn.reply{position:relative}
  .composer .sbtn.reply .pend{position:absolute;top:-4px;right:-4px;min-width:16px;height:16px;
    border-radius:9px;background:var(--pink);color:#141418;font-size:10px;font-weight:700;
    display:flex;align-items:center;justify-content:center;padding:0 4px;
    border:1.5px solid #121216;line-height:1}

  /* ================= 设置页 ================= */
  /* 整个设置页垫一层不透明底，彻底断掉装饰层透上来的可能 */
  #pgSet{position:relative;z-index:1}
  .setgrp{margin-bottom:16px}
  .setgrp>h4{font-size:12px;color:var(--pink);letter-spacing:1.2px;text-transform:uppercase;
    margin:0 0 9px;font-weight:600;
    /* 标题直接贴在卡片底色上，给它自己一个不透明衬底 */
    background:var(--card-bg);display:inline-block;padding:2px 8px;border-radius:7px}
  /* 折叠区 */
  /* 注意：这里必须用不透明底色。用 rgba 半透明的话，底下的装饰层（丝带/星星）
     会直接透上来压在文字上——这正是设置页"装饰挡字"的原因。 */
  .fold>summary{cursor:pointer;list-style:none;padding:11px 13px;border-radius:12px;
    background:var(--surface-1);border:1px solid rgba(255,255,255,.08);
    font-size:13px;color:#e8e8ee;display:flex;align-items:center;gap:7px}
  .fold>summary::-webkit-details-marker{display:none}
  .fold>summary::before{content:'▸';color:var(--pink);font-size:11px;transition:transform .2s}
  .fold[open]>summary::before{transform:rotate(90deg)}
  .fold>summary:hover{background:var(--surface-2)}
  /* 展开后的内容区也要盖住装饰，否则输入框之间的缝隙里会透出丝带 */
  .fold[open]{background:var(--surface-1);border-radius:12px;
    border:1px solid rgba(255,255,255,.07);margin-bottom:2px}
  .fold[open]>summary{border-radius:12px 12px 0 0;border:none;
    border-bottom:1px solid rgba(255,255,255,.07)}
  .fold .inner{padding:12px 13px 13px;background:var(--surface-1);
    border-radius:0 0 12px 12px}
  .fold+.fold{margin-top:7px}

  /* 角色卡列表 */
  .rolelist{display:flex;flex-direction:column;gap:8px}
  .rolecard{display:flex;gap:10px;align-items:center;padding:9px 11px;border-radius:13px;
    background:var(--surface-2);border:1px solid rgba(255,255,255,.08)}
  .rolecard.on{border-color:rgba(255,117,151,.45);background:#40222c}
  .rolecard img{width:40px;height:40px;min-width:40px;min-height:40px;flex:0 0 auto;
    border-radius:50%;object-fit:cover;object-position:center;aspect-ratio:1/1;
    background:#2a2a30;cursor:pointer;display:block}
  .rolecard .meta{flex:1;min-width:0}
  .rolecard .meta b{display:block;font-size:13px;color:#fff;margin-bottom:2px;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .rolecard .meta span{font-size:11px;color:var(--text-dim);display:block;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .rolecard .ops{display:flex;gap:5px;flex-shrink:0}
  .rolecard .ops button{width:28px;height:28px;border-radius:8px;border:1px solid rgba(255,255,255,.12);
    background:rgba(255,255,255,.05);color:var(--text-sub);font-size:12px;cursor:pointer;
    display:flex;align-items:center;justify-content:center}

  /* 世界书条目 */
  .wbitem{padding:10px 11px;border-radius:12px;background:var(--surface-2);
    border:1px solid rgba(255,255,255,.08);margin-bottom:7px}
  .wbitem .hd{display:flex;align-items:center;gap:7px;margin-bottom:6px}
  .wbitem .hd b{flex:1;font-size:12.5px;color:#fff;overflow:hidden;
    text-overflow:ellipsis;white-space:nowrap}
  .wbitem .kw{font-size:10.5px;color:var(--pink);margin-bottom:4px;word-break:break-all}
  .wbitem .ct{font-size:11.5px;color:var(--text-sub);line-height:1.6;
    max-height:52px;overflow:hidden}
  /* 小开关 */
  .tgl{position:relative;width:34px;height:19px;border-radius:999px;flex-shrink:0;
    background:rgba(255,255,255,.14);border:none;cursor:pointer;transition:background .2s}
  .tgl::after{content:'';position:absolute;top:2px;left:2px;width:15px;height:15px;
    border-radius:50%;background:#fff;transition:transform .2s}
  .tgl.on{background:var(--pink)}
  .tgl.on::after{transform:translateX(15px)}

  /* 记忆条 */
  .memitem{padding:9px 11px;border-radius:11px;background:var(--surface-2);
    border:1px solid rgba(255,255,255,.07);margin-bottom:6px;font-size:11.5px;
    color:var(--text-sub);line-height:1.65}
  .memitem .mh{display:flex;align-items:center;gap:6px;margin-bottom:4px;
    font-size:10px;color:var(--text-dim)}
  .memitem .mh button{margin-left:auto;background:none;border:none;color:#ff6b6b;
    font-size:11px;cursor:pointer;padding:0 2px}

  /* ---------- 头像：绝不变形 ----------
   * 变形的两个原因都堵掉：
   *   1) img 放在 flex 容器（.row）里会被压扁 → flex:0 0 auto 锁死
   *   2) 原图不是正方形时被拉伸 → object-fit:cover 居中裁切
   * aspect-ratio:1 再保一道，任何布局下都是正圆。 */
  .avatar{flex:0 0 auto;border-radius:50%;object-fit:cover;object-position:center;
    aspect-ratio:1/1;background:#2a2a30;display:block;cursor:pointer;
    border:1px solid rgba(255,255,255,.12)}
  .avatar.sm{width:24px;height:24px;min-width:24px;min-height:24px}
  .avatar.md{width:40px;height:40px;min-width:40px;min-height:40px}
  .avatar.lg{width:56px;height:56px;min-width:56px;min-height:56px}

  /* ---------- 安装引导步骤 ---------- */
  .istep{display:flex;gap:11px;align-items:flex-start;padding:11px 0;
    border-bottom:1px solid rgba(255,255,255,.06)}
  .istep:last-of-type{border-bottom:none}
  .inum{flex:0 0 auto;width:23px;height:23px;border-radius:50%;
    background:var(--pink);color:#1a1a1f;font-size:12px;font-weight:700;
    display:flex;align-items:center;justify-content:center;margin-top:1px}
  .ibody{flex:1;min-width:0}
  .ibody b{display:block;font-size:13px;color:#fff;margin-bottom:3px;line-height:1.5}
  .ibody p{font-size:12px;color:var(--text-sub);line-height:1.75;margin:0}

  /* ---------- 开屏 ----------
   * 盖在最上面，等界面画完再淡出。这样用户看到的第一帧是 logo，
   * 而不是还没渲染完的空壳。 */
  .splash{position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:18px;
    background:radial-gradient(circle at 50% 42%,#1b1016 0%,#0a0a0c 70%);
    transition:opacity .5s ease,visibility .5s}
  .splash.gone{opacity:0;visibility:hidden;pointer-events:none}
  .splash .lg{width:100%;height:100%;object-fit:contain;border-radius:0;display:block}
  .splash{background:#000;gap:0}
  .splash .tt,.splash .ld{display:none}
  @keyframes splashIn{
    from{opacity:0;transform:scale(.86) translateY(10px)}
    to{opacity:1;transform:scale(1) translateY(0)}}
  .splash .tt{display:flex;flex-direction:column;align-items:center;gap:6px;
    animation:splashIn .85s .12s cubic-bezier(.2,.9,.3,1) both}
  .splash .tt b{font-size:21px;color:#fff;letter-spacing:3px;font-weight:700}
  .splash .tt span{font-size:9.5px;color:var(--pink);letter-spacing:4px;
    padding:2px 10px;border-radius:10px;background:#3a2129;
    border:1px solid rgba(255,117,151,.3)}
  .splash .ld{width:18px;height:18px;border:2px solid rgba(255,117,151,.25);
    border-top-color:var(--pink);border-radius:50%;
    animation:sp .8s linear infinite;margin-top:4px}

  /* 头像上传隐藏 input */
  .hidefile{display:none}
</style>
</head>
<body>

<!-- 开屏：JS 里画完界面就淡出 -->
<div class="splash" id="splash">
  <img class="lg" id="splashLogo" alt="">
  <div class="tt">
    <b>私享衣橱</b>
    <span>BOUDOIR</span>
  </div>
  <div class="ld"></div>
</div>

<div id="app">

  <!-- 唯一的装饰层：z-index 0，全屏连续斜跨，位于所有内容之下。
       只在留白处显现（面板缝隙、卡片空白区、屏幕边缘），
       承载文字的表面全部不透明，所以绝不会穿透到文字/按钮/顶栏/底栏上。 -->
  <div class="deco">
    <svg class="ribbon" viewBox="0 0 400 900" preserveAspectRatio="none">
      <defs>
        <linearGradient id="rgA" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ff7597" stop-opacity=".55"/>
          <stop offset="100%" stop-color="#ff94b0" stop-opacity=".26"/>
        </linearGradient>
        <linearGradient id="rgB" x1="100%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#ff6b8b" stop-opacity=".45"/>
          <stop offset="100%" stop-color="#ffb3c6" stop-opacity=".16"/>
        </linearGradient>
        <linearGradient id="rgC" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#ff7597" stop-opacity="0"/>
          <stop offset="35%" stop-color="#ffa8bf" stop-opacity=".7"/>
          <stop offset="100%" stop-color="#ff7597" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <!-- 粗丝带：从顶栏一路斜贯到底栏，连续不断 -->
      <path d="M -20 120 Q 160 66 420 22" stroke="url(#rgA)" stroke-width="5" fill="none" stroke-linecap="round"/>
      <path d="M 420 300 Q 200 430 -20 520" stroke="url(#rgB)" stroke-width="4.5" fill="none" stroke-linecap="round"/>
      <path d="M -20 400 Q 210 540 420 660" stroke="url(#rgA)" stroke-width="3.5" fill="none" stroke-linecap="round"/>
      <path d="M -20 800 Q 190 752 420 700" stroke="url(#rgB)" stroke-width="4" fill="none" stroke-linecap="round"/>
      <path d="M 420 880 Q 180 908 -20 872" stroke="url(#rgA)" stroke-width="3" fill="none" stroke-linecap="round"/>
      <!-- 细光丝：伴随粗带，两端渐隐 -->
      <path d="M -20 100 Q 165 48 420 2" stroke="url(#rgC)" stroke-width="1.4" fill="none"/>
      <path d="M 420 278 Q 205 410 -20 498" stroke="url(#rgC)" stroke-width="1.2" fill="none"/>
      <path d="M -20 780 Q 195 730 420 678" stroke="url(#rgC)" stroke-width="1.3" fill="none"/>
    </svg>
    <!-- 星芒：大小交错、节奏错开，沿边缘与丝带走向散落 -->
    <svg class="star lg spin" style="top:7%;right:14px;width:17px;height:17px" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star" style="top:12%;right:52px;width:11px;height:11px;animation-delay:.5s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm tw" style="top:4%;right:86px;width:8px;height:8px;animation-delay:1.2s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm" style="top:16%;left:9px;width:7px;height:7px;animation-delay:.3s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star" style="top:22%;left:12px;width:10px;height:10px;animation-delay:.8s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm tw" style="top:27%;left:38px;width:8px;height:8px;animation-delay:2.4s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm" style="top:34%;right:10px;width:7px;height:7px;animation-delay:1.6s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star" style="top:46%;right:26px;width:11px;height:11px;animation-delay:1.5s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm tw" style="top:52%;right:58px;width:8px;height:8px;animation-delay:.7s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm" style="top:56%;left:14px;width:7px;height:7px;animation-delay:2s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star lg" style="top:64%;left:32px;width:15px;height:15px;animation-delay:.4s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm tw" style="top:70%;left:66px;width:8px;height:8px;animation-delay:3.1s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star" style="top:80%;right:44px;width:10px;height:10px;animation-delay:1.9s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm" style="top:85%;right:16px;width:7px;height:7px;animation-delay:1.1s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm tw" style="top:88%;left:48px;width:8px;height:8px;animation-delay:.2s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star" style="bottom:4%;left:20px;width:11px;height:11px;animation-delay:1.1s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm" style="bottom:2%;right:70px;width:7px;height:7px;animation-delay:2.7s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    <svg class="star sm tw" style="bottom:7%;right:28px;width:9px;height:9px;animation-delay:1.4s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
  </div>

  <!-- 顶栏：chrome:"none" 下必须自带返回，否则用户被困死 -->
  <div class="topbar">
    <div class="bar-row">
      <button class="ibtn" id="btnBack" aria-label="返回">‹</button>
      <div class="brand">
        <img id="brandLogo" alt="">
        <b>私享衣橱</b><i>BOUDOIR</i>
      </div>
      <button class="ibtn" id="btnTrash" aria-label="回收站">♺</button>
      <button class="ibtn" id="btnMore" aria-label="更多">⋯</button>
    </div>
    <div class="bar-row">
      <div class="search">
        <span style="font-size:13px;color:#6d6d72">⌕</span>
        <input id="kw" type="text" placeholder="搜名字 / 标签，如「粉」「蕾丝」">
      </div>
      <span class="env" id="envPill">检测中</span>
    </div>
  </div>

  <div class="cats" id="cats"></div>

  <div class="stage">
    <!-- 卡片级装饰：铺在大黑卡片底色之上，在内容(.scroll z2)之下。
         只显现在卡片的空白区和面板缝隙里；面板与衣物卡都是不透明的，不会被挡。 -->
    <div class="stage-deco">
      <svg class="ribbon" viewBox="0 0 320 620" preserveAspectRatio="none">
        <defs>
          <linearGradient id="rgS1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ff7597" stop-opacity=".62"/>
            <stop offset="100%" stop-color="#ffb3c6" stop-opacity=".24"/>
          </linearGradient>
          <linearGradient id="rgS2" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#ffb3c6" stop-opacity=".34"/>
            <stop offset="100%" stop-color="#ff6b8b" stop-opacity=".55"/>
          </linearGradient>
          <linearGradient id="rgS3" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ff7597" stop-opacity="0"/>
            <stop offset="40%" stop-color="#ffa8bf" stop-opacity=".8"/>
            <stop offset="100%" stop-color="#ff7597" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <!-- 斜跨整张卡片，不被卡片边缘截断 -->
        <path d="M -20 70 Q 150 18 340 -26" stroke="url(#rgS1)" stroke-width="5" fill="none" stroke-linecap="round"/>
        <path d="M -20 54 Q 156 6 340 -40" stroke="url(#rgS3)" stroke-width="1.3" fill="none"/>
        <path d="M 340 250 Q 160 352 -20 438" stroke="url(#rgS2)" stroke-width="4.5" fill="none" stroke-linecap="round"/>
        <path d="M -20 300 Q 165 396 340 476" stroke="url(#rgS1)" stroke-width="2.2" fill="none" stroke-linecap="round"/>
        <path d="M -20 560 Q 170 516 340 452" stroke="url(#rgS1)" stroke-width="4" fill="none" stroke-linecap="round"/>
        <path d="M 340 596 Q 150 634 -20 600" stroke="url(#rgS2)" stroke-width="3" fill="none" stroke-linecap="round"/>
        <path d="M -20 640 Q 175 600 340 540" stroke="url(#rgS3)" stroke-width="1.4" fill="none"/>
      </svg>
      <!-- 卡片内星芒：在照片与面板的缝隙里闪，内容层(z2)会盖住压到的部分 -->
      <svg class="star sm tw" style="top:6%;left:16px;width:8px;height:8px;animation-delay:.9s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star sm" style="top:14%;right:20px;width:7px;height:7px;animation-delay:2.2s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star" style="top:26%;right:44px;width:10px;height:10px;animation-delay:1.4s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star sm tw" style="top:33%;left:52px;width:8px;height:8px;animation-delay:.1s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star lg" style="top:41%;left:20px;width:14px;height:14px;animation-delay:.6s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star sm" style="top:48%;right:14px;width:7px;height:7px;animation-delay:1.7s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star sm tw" style="top:55%;left:38%;width:9px;height:9px;animation-delay:2.9s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star" style="top:63%;right:26px;width:11px;height:11px;animation-delay:1.8s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star sm" style="top:70%;left:26px;width:7px;height:7px;animation-delay:.4s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star lg spin" style="top:78%;left:42%;width:15px;height:15px" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star sm tw" style="top:84%;left:18px;width:8px;height:8px;animation-delay:1.3s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star" style="top:90%;right:56px;width:10px;height:10px;animation-delay:.3s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star sm" style="top:94%;right:20px;width:7px;height:7px;animation-delay:2.5s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
      <svg class="star sm tw" style="top:97%;left:60px;width:8px;height:8px;animation-delay:1.9s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
    </div>
    <div class="scroll" id="scroll">

      <!-- 我的衣橱 -->
      <div class="page on" id="pgCloset">
        <div class="grid" id="grid"></div>
        <div class="empty" id="emptyBox" style="display:none">
          <div class="box">
            <svg viewBox="0 0 24 24"><path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.5a2 2 0 001.23 1.54L6 11.5V20a2 2 0 002 2h8a2 2 0 002-2v-8.5l1.91-.77a2 2 0 001.23-1.54l.58-3.5a2 2 0 00-1.34-2.23z"/></svg>
            <!-- 环绕衣架图标的点睛星芒 -->
            <svg class="star lg" style="top:-9px;right:-11px;width:15px;height:15px" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
            <svg class="star sm tw" style="bottom:-6px;left:-8px;width:9px;height:9px;animation-delay:1.1s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
            <svg class="star sm" style="top:30%;left:-13px;width:7px;height:7px;animation-delay:.5s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
            <svg class="star sm tw" style="bottom:12%;right:-12px;width:8px;height:8px;animation-delay:2.3s" viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
          </div>
          <h4 id="emptyH">衣柜这层还是空的</h4>
          <p id="emptyP">去挂上你的第一套战袍吧<br>入库自动等比压缩，不拉伸、不占内存</p>
        </div>
      </div>

      <!-- 灵感试衣间 -->
      <div class="page" id="pgFitting">

        <!-- 选衣服（两种模式共用） -->
        <div class="panel">
          <h3>选好要搭的衣服 <span class="badge" id="pickCount">0 件</span> <span class="badge">上限 20</span></h3>
          <div class="thumbline" id="pickThumbs"></div>
          <div class="row" style="margin-top:10px">
            <button class="btn pri sm" id="btnPickDrawer">选取衣服</button>
            <button class="btn gh sm" id="btnRandom">随机抽一套</button>
            <button class="btn gh sm" id="btnClearPick">清空选择</button>
          </div>
        </div>

        <!-- 模式切换：自己搭 / 让角色搭 -->
        <div class="panel">
          <h3>怎么搭</h3>
          <div class="mode-block">
            <label class="mode-row on" id="modeRowSelf">
              <input type="radio" name="whoStyle" value="self" id="modeSelf" checked>
              <span class="mode-txt">
                <b>我自己搭配</b>
                <i>自己选好衣服组合，直接存进搭配册或请他点评</i>
              </span>
            </label>
            <label class="mode-row" id="modeRowChar">
              <input type="radio" name="whoStyle" value="char" id="modeChar">
              <span class="mode-txt">
                <b>让角色帮我搭</b>
                <i>选一位角色，让他根据你的衣服给出搭配方案</i>
              </span>
            </label>
          </div>
        </div>

        <!-- 自己搭配面板 -->
        <div class="panel" id="panelSelf">
          <h3>我的搭配</h3>
          <p id="selfHint">选好衣服后，可以直接存进搭配册，也可以让角色点评一下。</p>
          <div class="f" style="margin-top:10px">
            <label>给这套搭配写句话 <i>（可空）</i></label>
            <textarea id="selfComment" placeholder="今天想走辣妹风 / 和他约会穿这套 / 下雨天通勤…"></textarea>
          </div>
          <div class="row" style="margin-top:10px">
            <button class="btn pri sm" id="btnSelfSave">存进搭配册</button>
            <button class="btn gh sm" id="btnSelfAskChar">请他点评这套</button>
          </div>
          <!-- 点评展示区：请他点评后在这里显示，看完再决定存不存 -->
          <div id="selfReviewBox" style="display:none">
            <div class="verdict" id="selfVerdict"></div>
            <div class="row" style="margin-top:10px">
              <button class="btn pri sm" id="btnSelfReviewSave">满意，存进搭配册</button>
              <button class="btn gh sm" id="btnSelfReviewRetry">不满意，再评一次</button>
            </div>
          </div>
        </div>

        <!-- 角色搭配面板 -->
        <div class="panel" id="panelChar" style="display:none">
          <h3>① 挑一位角色 <span class="badge" id="roleState">未选</span></h3>
          <p>他会读到这几件衣服的名字、标签和备注，用自己的人设给你锐评。</p>
          <div class="hrow" id="charRow"></div>
        </div>

        <div class="panel" id="panelCharMode" style="display:none">
          <h3>② 搭配方式</h3>
          <div class="mode-block">
            <label class="mode-row" id="modeRowText">
              <input type="radio" name="fitMode" value="text" id="modeText" checked>
              <span class="mode-txt">
                <b>只看文本搭配</b>
                <i>读名字、标签、备注来搭。快、省额度，标签打得细就够准</i>
              </span>
            </label>
            <label class="mode-row" id="modeRowVision">
              <input type="radio" name="fitMode" value="vision" id="modeVision">
              <span class="mode-txt">
                <b>让他真的看图点评</b>
                <i>调识图，更准但更慢更费额度</i>
              </span>
            </label>
            <div class="vision-opt" id="visionOpt">
              <span>识图张数</span>
              <button class="step" id="visionMinus" type="button" aria-label="减少">−</button>
              <input type="number" id="visionCount" value="6" min="1" max="20" inputmode="numeric">
              <button class="step" id="visionPlus" type="button" aria-label="增加">+</button>
              <span class="vision-tip" id="visionTip">张</span>
            </div>
          </div>
        </div>

        <div class="panel" id="panelCharAsk" style="display:none">
          <h3>③ 请他开口</h3>
          <button class="btn pri" id="btnAsk">让他点评并搭配</button>
          <div class="verdict" id="verdict">还没有点评。选好角色和衣服，点上面那颗按钮。</div>
          <div class="genbox" id="genBox"></div>
          <div class="row" style="margin-top:10px">
            <button class="btn gh sm" id="btnSendChat">发到私聊</button>
            <button class="btn gh sm" id="btnGenImg">画出返图</button>
          </div>
          <div class="row" style="margin-top:8px">
            <button class="btn gh sm" id="btnSaveLook">存进搭配册</button>
            <button class="btn gh sm" id="btnCopyPrompt">复制英文提示词</button>
          </div>
        </div>
      </div>

      <!-- 过往搭配册 -->
      <div class="page" id="pgArchive">
        <div class="panel">
          <h3>衣橱统计</h3>
          <p id="statText">统计中…</p>
        </div>
        <div id="lookList"></div>
      </div>

      <!-- 聊天：两级结构。一级选人，二级才是具体对话（互相隔离） -->
      <div class="page" id="pgChat">

        <!-- 一级：会话列表 -->
        <div class="chatlist" id="chatList"></div>

        <!-- 二级：跟某个人的聊天室 -->
        <div class="chatroom" id="chatRoom">
          <div class="roomhead">
            <button class="back" id="roomBack" aria-label="返回">‹</button>
            <img id="roomAvatar" src="" alt="">
            <div class="rname" id="roomName">…</div>
            <div class="rops">
              <button id="roomEdit" title="编辑这位角色">✎</button>
              <button id="roomClear" title="清空跟他的聊天">⌫</button>
            </div>
          </div>
          <div class="chatbg" id="chatBg"></div>
          <div class="msgs" id="msgs"></div>
          <div class="composer">
            <textarea id="chatInput" rows="1" placeholder="说点什么…"></textarea>
            <div class="btns">
              <button class="sbtn send" id="chatSend" aria-label="只发出去，先不让他回">
                <svg viewBox="0 0 24 24">
                  <ellipse cx="12" cy="16.2" rx="5.3" ry="4.4"/>
                  <ellipse cx="5.3" cy="10.6" rx="2.35" ry="2.95"/>
                  <ellipse cx="9.5" cy="6.5" rx="2.25" ry="3.05"/>
                  <ellipse cx="14.5" cy="6.5" rx="2.25" ry="3.05"/>
                  <ellipse cx="18.7" cy="10.6" rx="2.35" ry="2.95"/>
                </svg>
              </button>
              <button class="sbtn reply" id="chatReply" aria-label="让他回复">
                <svg viewBox="0 0 24 24"><path d="M12 0 L13 10.6 L24 12 L13 13.4 L12 24 L11 13.4 L0 12 L11 10.6 Z"/></svg>
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- 设置 -->
      <div class="page" id="pgRoleSet">
        <div class="settings-heading">
          <button class="btn gh sm" id="roleSettingsBack">返回通用设置</button>
          <h3 id="roleSettingsTitle">角色设置</h3>
        </div>
        <div class="hint">以下内容仅属于当前角色，不影响其他角色。</div>
        <button class="btn gh sm" id="roleProfileEdit">编辑当前角色资料</button>
        <div id="roleSettingsPanels"></div>
        <div class="settings-footer"><button class="btn pri" id="saveRoleSettings">保存当前角色设置</button></div>
      </div>
      <div class="page" id="pgSet">
        <h3>通用设置</h3>
        <div class="hint">接口、识图和数据管理由所有角色共用；私人配置请进入各自的角色设置。</div>

        <div class="setgrp">
          <h4>接口</h4>
          <details class="fold" id="foldApi">
            <summary>AI 接口配置 <span class="badge" id="apiState" style="margin-left:auto">未配置</span></summary>
            <div class="inner">
              <div class="f">
                <label>预设 <i>（配好一套可以存下来，以后一键切换）</i></label>
                <select id="apiPreset"></select>
                <div class="row" style="margin-top:7px">
                  <button class="btn gh sm" id="btnSavePreset">存为预设</button>
                  <button class="btn gh sm" id="btnDelPreset">删掉这个预设</button>
                </div>
              </div>
              <div class="f">
                <label>Base URL <i>（到 /v1 为止，不要带 /chat/completions）</i></label>
                <input id="apiUrl" type="text" placeholder="https://api.openai.com/v1" autocomplete="off">
              </div>
              <div class="f">
                <label>API Key</label>
                <input id="apiKey" type="password" placeholder="sk-..." autocomplete="off">
              </div>
              <div class="f">
                <label>模型 <i>（识图需要 vision 能力的模型）</i></label>
                <div class="combo">
                  <input id="apiModel" type="text" placeholder="gpt-4o" autocomplete="off">
                  <button type="button" class="cbtn" id="apiModelPick" aria-label="从列表里挑一个模型">
                    <svg viewBox="0 0 24 24"><path d="M12 16.5 2.5 7l1.8-1.8L12 12.9l7.7-7.7L21.5 7z"/></svg>
                  </button>
                </div>
              </div>
              <div class="row">
                <button class="btn gh sm" id="btnPullModels">拉取模型列表</button>
                <button class="btn pri sm" id="btnTestApi">测试连接</button>
              </div>
              <div class="hint" id="apiTestOut" style="margin:8px 0 0;display:none"></div>
              <div class="f" style="margin-top:12px">
                <label>回复方式</label>
                <select id="apiStreamMode">
                  <option value="auto">自动（推荐：先试流式，不行自动转非流式）</option>
                  <option value="stream">强制流式</option>
                  <option value="once">强制非流式</option>
                </select>
              </div>
              <div class="hint" style="margin:6px 0 0">
                Key 只存在你手机本地，不会发给任何第三方，只在调用你自己配的接口时用。
              </div>
            </div>
          </details>

          <details class="fold" id="foldVision">
            <summary>识图 <span class="badge" style="margin-left:auto">衣物自动打标签</span></summary>
            <div class="inner">
              <div class="f">
                <label>识图用的模型 <i>（留空＝跟聊天用同一个）</i></label>
                <div class="combo">
                  <input id="visionModel" type="text" placeholder="留空则用上面的模型" autocomplete="off">
                  <button type="button" class="cbtn" id="visionModelPick" aria-label="从列表里挑一个模型">
                    <svg viewBox="0 0 24 24"><path d="M12 16.5 2.5 7l1.8-1.8L12 12.9l7.7-7.7L21.5 7z"/></svg>
                  </button>
                </div>
              </div>
              <div class="f">
                <label>识图清晰度</label>
                <select id="visionQ">
                  <option value="low">节省（512px，看颜色版型）</option>
                  <option value="auto">标准（720px）</option>
                  <option value="high" selected>高细节（1024px，看蕾丝纹理/logo）</option>
                </select>
              </div>
              <div class="hint" style="margin:0">
                走标准 OpenAI 多模态格式，图片以 base64 直接发给你配的接口。
                只要模型支持看图（gpt-4o / gemini / claude 等），识图就能用。
              </div>
            </div>
          </details>
        </div>

        <div class="setgrp">
          <h4>角色</h4>
          <details class="fold" id="foldRoles" open>
            <summary>他们 <span class="badge" id="roleCount" style="margin-left:auto">0 位</span></summary>
            <div class="inner">
              <div class="rolelist" id="roleList"></div>
              <button class="btn pri sm" id="btnAddRole" style="margin-top:9px">＋ 新建一位</button>
            </div>
          </details>

          <details class="fold" id="foldMe">
            <summary>我 <span class="badge" id="meName" style="margin-left:auto">未设置</span></summary>
            <div class="inner">
              <div class="f">
                <label>我的头像</label>
                <div class="row" style="align-items:center">
                  <img id="meAvatar" class="avatar lg" src="" alt="">
                  <div class="hint" style="margin:0;flex:1">点头像换图</div>
                </div>
                <input type="file" id="meAvatarFile" accept="image/*" class="hidefile">
              </div>
              <div class="f">
                <label>我的名字</label>
                <input id="meNameInput" type="text" placeholder="他会这么叫你">
              </div>
              <div class="f">
                <label>我的人设 <i>（他知道的关于你的事）</i></label>
                <textarea id="mePersona" rows="4"
                  placeholder="比如：25 岁，做设计的，喜欢甜酷风，衣柜里黑色和粉色最多…"></textarea>
              </div>
              <div class="f">
                <label>我的气泡颜色</label>
                <input id="meBubble" type="color" value="#ff7597" style="height:42px;padding:4px">
              </div>
            </div>
          </details>
        </div>

        <div class="setgrp">
          <h4>记忆</h4>
          <details class="fold" id="foldMem">
            <summary>长期记忆 <span class="badge" id="memCount" style="margin-left:auto">0 条</span></summary>
            <div class="inner">
              <div class="f">
                <label>他能记得最近多少轮对话</label>
                <select id="memRounds">
                  <option value="20">20 轮（省 token）</option>
                  <option value="40" selected>40 轮</option>
                  <option value="80">80 轮（费 token，但记得久）</option>
                </select>
              </div>
              <div class="f">
                <label>每多少轮自动总结一次</label>
                <select id="memAuto">
                  <option value="0">不自动总结</option>
                  <option value="10">10 轮</option>
                  <option value="20" selected>20 轮</option>
                  <option value="40">40 轮</option>
                </select>
              </div>
              <div class="row">
                <button class="btn gh sm" id="btnSummarizeNow">立刻总结一次</button>
                <button class="btn gh sm" id="btnClearMem">清空记忆</button>
              </div>
              <div class="hint" style="margin:8px 0 0">
                超出对话轮数的内容会被总结成「记忆」长期保留，这样聊很久他也不会忘掉重要的事。
              </div>
              <div id="memList" style="margin-top:10px"></div>
            </div>
          </details>

          <details class="fold" id="foldWb">
            <summary>世界书 <span class="badge" id="wbCount" style="margin-left:auto">0 条</span></summary>
            <div class="inner">
              <div class="hint" style="margin:0 0 9px">
                聊到关键词时才把对应设定塞给他，省 token。
                适合放：你们的共同回忆、他的背景设定、穿搭偏好规则等。
              </div>
              <div id="wbList"></div>
              <button class="btn pri sm" id="btnAddWb" style="margin-top:8px">＋ 新增条目</button>
            </div>
          </details>
        </div>

        <div class="setgrp">
          <h4>衣橱联动</h4>
          <details class="fold" id="foldWardrobe">
            <summary>他能看到多少衣服 <span class="badge" id="feedState" style="margin-left:auto">全部</span></summary>
            <div class="inner">
              <div class="f">
                <label>给他看衣橱清单</label>
                <select id="wardrobeShare">
                  <option value="all" selected>全部衣服（他能翻你整个衣柜）</option>
                  <option value="stats">只给统计概况（省 token）</option>
                  <option value="none">不给（他不知道你有什么衣服）</option>
                </select>
              </div>
              <div class="hint" style="margin:0">
                选「全部」时，每件衣服的名字、分类、标签、备注都会进他的上下文——
                他可以直接说「穿你那件黑色蕾丝吊带配百褶裙」。衣服多的时候会占一些 token。
              </div>
            </div>
          </details>
        </div>

        <div class="setgrp">
          <h4>聊天风格</h4>
          <details class="fold" id="foldStyle">
            <summary>沉浸式 / 纯对话</summary>
            <div class="inner">
              <div class="f">
                <label>回复风格</label>
                <select id="rpMode">
                  <option value="immersive" selected>沉浸式（带 *动作* 和神态描写）</option>
                  <option value="plain">纯对话（只说话，不描写动作）</option>
                </select>
              </div>
              <div class="f">
                <label>回复温度 <i>（越高越放得开，越低越稳）</i></label>
                <select id="rpTemp">
                  <option value="0.7">0.7 稳</option>
                  <option value="0.95" selected>0.95 推荐</option>
                  <option value="1.1">1.1 放得开</option>
                </select>
              </div>
            </div>
          </details>
        </div>

        <div class="setgrp">
          <h4>聊天外观</h4>
          <details class="fold" id="foldLook">
            <summary>背景 / 字号 / 字体 / 颜色</summary>
            <div class="inner">
              <div class="f">
                <label>聊天背景图</label>
                <div class="row" style="align-items:center">
                  <div id="bgPreview" style="width:66px;height:44px;border-radius:9px;flex:0 0 auto;
                    background:var(--surface-2) center/cover no-repeat;
                    border:1px solid rgba(255,255,255,.12);cursor:pointer"></div>
                  <div class="hint" style="margin:0;flex:1">点方块选一张图。竖图横图都行，会自动铺满。</div>
                </div>
                <input type="file" id="chatBgFile" accept="image/*" class="hidefile">
                <button class="btn gh sm" id="btnClearBg" style="margin-top:7px">不要背景图</button>
              </div>

              <div class="f">
                <label>背景压暗 <i>（背景太花时调高，保证字看得清）</i></label>
                <input type="range" id="bgDim" min="0" max="90" step="5" value="55"
                  style="width:100%;accent-color:var(--pink)">
                <div class="hint" style="margin:3px 0 0" id="bgDimVal">55%</div>
              </div>

              <div class="f">
                <label>字号</label>
                <input type="range" id="chatFs" min="12" max="20" step="0.5" value="13.5"
                  style="width:100%;accent-color:var(--pink)">
                <div class="hint" style="margin:3px 0 0" id="chatFsVal">13.5px</div>
              </div>

              <div class="f">
                <label>字体</label>
                <select id="chatFf">
                  <option value="">跟随系统（默认）</option>
                  <option value="'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif">黑体 · 方正</option>
                  <option value="'Songti SC','SimSun','Noto Serif SC',serif">宋体 · 书卷</option>
                  <option value="'Kaiti SC','KaiTi','STKaiti',serif">楷体 · 手写感</option>
                  <option value="'LXGW WenKai','Kaiti SC',serif">霞鹜文楷（需系统已装）</option>
                  <option value="ui-monospace,'SFMono-Regular',Consolas,monospace">等宽 · 极客</option>
                </select>
              </div>

              <div class="f">
                <label>他的气泡文字颜色</label>
                <div class="row" style="align-items:center">
                  <input type="color" id="aiTextColor" value="#ececf0"
                    style="height:42px;padding:4px;flex:0 0 76px">
                  <div class="hint" style="margin:0;flex:1">气泡底色深就用浅色字，反之用深色字。</div>
                </div>
              </div>

              <div class="f">
                <label>我的气泡文字颜色</label>
                <input type="color" id="meTextColor" value="#ffffff"
                  style="height:42px;padding:4px;width:76px">
              </div>

              <div class="hint" style="margin:0">
                改完切到聊天页就能看到效果。觉得乱了点下面「恢复默认外观」。
              </div>
              <button class="btn gh sm" id="btnResetLook" style="margin-top:8px">恢复默认外观</button>
            </div>
          </details>
        </div>

        <div class="setgrp">
          <h4>数据</h4>
          <button class="btn gh sm" style="margin-bottom:8px" id="btnCatMgr2">分类管理</button>
          <button class="btn gh sm" style="margin-bottom:8px" id="btnExport2">导出全部数据</button>
          <button class="btn gh sm" style="margin-bottom:8px" id="btnImport2">导入数据（换机迁移）</button>
          <input type="file" id="importFile2" accept="application/json,.json" hidden>
          <button class="btn gh sm" style="margin-bottom:8px" id="btnInstallPwa">装到手机桌面</button>
          <div class="hint" id="storeInfo2" style="margin:2px 0 10px">读取中…</div>

          <div style="height:1px;background:rgba(255,255,255,.08);margin:14px 0"></div>
          <div class="hint" style="margin:0 0 8px;color:#ff9b9b">
            下面两个会真的删掉东西，删了找不回来。建议先导出一份备份。
          </div>
          <button class="btn gh sm" style="margin-bottom:8px" id="btnClearChats">清空聊天记录</button>
          <button class="btn gh sm" style="margin-bottom:8px;border-color:rgba(255,90,90,.4);color:#ff8a8a"
            id="btnWipeAll">删除所有数据</button>
        </div>

      </div>

    </div>
  </div>

  <div class="fabs" id="fabs">
    <button class="fab alt" id="fabChar" aria-label="角色点单">♡</button>
    <button class="fab main" id="fabAdd" aria-label="收纳新衣物">＋</button>
  </div>

  <div class="selbar">
    <button id="selAll">全选</button>
    <button id="selTag">打标签</button>
    <button id="selMove">改分类</button>
    <button id="selFit">去搭配</button>
    <button id="selDel" class="danger">删除</button>
    <button id="selExit">退出</button>
  </div>

  <div class="nav">
    <button class="on" data-page="closet">衣橱</button>
    <button data-page="fitting">试衣间</button>
    <button data-page="chat">聊天</button>
    <button data-page="archive">搭配册</button>
    <button data-page="set">设置</button>
  </div>

  <div class="mask" id="mask"></div>

  <!-- 抽屉：添加 / 编辑 -->
  <div class="drawer" id="dwItem">
    <div class="grip"></div>
    <h2 id="itemTitle">收纳新衣物</h2>
    <div class="hint">所有字段都可以不填。想随手存图就一秒搞定，想精细打理再慢慢补标签。</div>

    <div class="f">
      <label>衣物照片 <i>（可多选 / 拖拽 / Ctrl+V 粘贴，一次最多 20 张）</i></label>
      <div class="drop" id="drop">
        <p>点这里选图，或把图片拖进来 / 直接粘贴<br>
          自动生成缩略图 300px + 高清图 1080px，体积砍掉约 95%</p>
      </div>
      <input type="file" id="file" accept="image/*" multiple hidden>
      <div class="pvs" id="pvs"></div>
      <div class="autotag-row" id="autoTagRow" style="display:none">
        <button type="button" class="btn pri sm" id="btnAutoTag" style="flex:1;min-width:0">
          🔍 识图填标签
        </button>
      </div>
      <button type="button" class="btn pri sm" id="btnAutoTagAll"
        style="display:none;width:100%;margin-top:8px">
        ✨ 一键识图并全部入柜
      </button>
      <div class="hint" id="autoTagStatus" style="margin:6px 0 0;display:none"></div>
    </div>

    <div class="row">
      <div class="f">
        <label>战袍名字 <i>（可空）</i></label>
        <input type="text" id="fName" placeholder="黑蕾丝吊带裙">
      </div>
    </div>

    <div class="f">
      <label>品类</label>
      <select id="fCat"></select>
    </div>

    <div class="f">
      <label>属性标签 <i>（点亮即选；点某一栏的＋往该栏加新标签）</i></label>
      <div id="tagBox"></div>
    </div>

    <div class="f">
      <label>备注 <i>（可空，角色会读这句）</i></label>
      <textarea id="fNote" placeholder="尺码、场合、搭配心得、谁送的…"></textarea>
    </div>

    <div class="f">
      <label>英文生图片段 <i>（可空）</i></label>
      <input type="text" id="fPrompt" placeholder="pastel pink pleated mini skirt">
    </div>

    <div class="row">
      <button class="btn gh" id="itemCancel">取消</button>
      <button class="btn pri" id="itemSave">保存入柜</button>
    </div>
  </div>

  <!-- 抽屉：分类 -->
  <div class="drawer" id="dwCat">
    <div class="grip"></div>
    <h2>分类管理</h2>
    <div class="hint">可任意增删改。删掉某个分类时，里面的衣服自动迁到「未分类」，绝不丢件。</div>
    <div id="catList"></div>
    <div class="f" style="margin-top:12px">
      <label>新建分类</label>
      <div class="row">
        <input type="text" id="newCat" placeholder="内衣 / 睡裙">
        <button class="btn pri" style="flex:0 0 94px" id="addCat">添加</button>
      </div>
    </div>
    <button class="btn gh" id="catDone">完成</button>
  </div>

  <!-- 抽屉：从衣橱选衣服（试衣间用） -->
  <div class="drawer" id="dwPick">
    <div class="grip"></div>
    <h2>选取衣服 <span class="badge" id="pickDrawerCount">0 / 20</span></h2>
    <div class="hint">点击勾选，再点取消勾选。最多选 20 件。</div>
    <div class="bar-row" style="margin-bottom:10px">
      <div class="search" style="flex:1">
        <span style="font-size:13px;color:#6d6d72">⌕</span>
        <input id="pickSearch" type="text" placeholder="搜名字 / 标签筛选">
      </div>
    </div>
    <div class="cats" id="pickCats" style="padding:0 0 8px;position:static"></div>
    <div id="pickGrid" style="max-height:52vh;overflow-y:auto;-webkit-overflow-scrolling:touch"></div>
    <div class="row" style="margin-top:12px">
      <button class="btn gh" id="pickDone">完成</button>
    </div>
  </div>

  <!-- 抽屉：回收站 -->
  <div class="drawer" id="dwTrash">
    <div class="grip"></div>
    <h2>回收站</h2>
    <div class="hint">删掉的衣服只是收进这里，随时能满血复活。彻底清空前永远不丢。</div>
    <div id="trashList"></div>
    <div class="row" style="margin-top:12px">
      <button class="btn gh" id="trashDone">返回</button>
      <button class="btn dg" id="trashPurge">彻底清空</button>
    </div>
  </div>

  <!-- 抽屉：给这套搭配命名（存进搭配册 / 之后改名 共用同一个） -->
  <div class="drawer" id="dwLookName">
    <div class="grip"></div>
    <h2 id="lookNameTitle">给这套搭配起个名字</h2>
    <div class="hint" id="lookNameHint">不填也行，会自动用「他的搭配」加日期。想日后好找就起个响亮的名字。</div>

    <div class="thumbline" id="lookNameThumbs" style="margin-bottom:12px"></div>

    <div class="f">
      <label>套装名字 <i>（可空，最多 40 字）</i></label>
      <input type="text" id="lookNameInput" maxlength="40" placeholder="例：今日辣妹 / 暗黑哥特">
    </div>

    <div class="f">
      <label>快速套用</label>
      <div class="chips" id="lookNamePresets"></div>
    </div>

    <div class="row">
      <button class="btn gh" id="lookNameCancel">取消</button>
      <button class="btn pri" id="lookNameSave">保存</button>
    </div>
  </div>

  <!-- 抽屉：更多 -->
  <div class="drawer" id="dwMore">
    <div class="grip"></div>
    <h2>数据</h2>
    <div class="hint" id="storeInfo">读取中…</div>
    <div class="hint" style="margin:0 0 12px">
      角色不需要「供稿」了——他们就在这个 App 里，直接能看到你整个衣柜。
      看到多少可以在「设置 → 衣橱联动」里调。
    </div>
    <button class="btn gh sm" style="margin-bottom:8px" id="btnCatMgr">分类管理</button>
    <button class="btn gh sm" style="margin-bottom:8px" id="btnExport">导出衣橱数据（my_closet.json）</button>
    <button class="btn gh sm" style="margin-bottom:8px" id="btnImport">导入衣橱数据（换机迁移）</button>
    <input type="file" id="importFile" accept="application/json,.json" hidden>
    <button class="btn gh" id="moreDone">关闭</button>
  </div>

  <!-- 抽屉：角色编辑 -->
  <div class="drawer" id="dwRole">
    <div class="grip"></div>
    <h2 id="roleEditTitle">新建角色</h2>

    <div class="f">
      <label>头像</label>
      <div class="row" style="align-items:center">
        <img id="roAvatarPv" class="avatar lg" src="" alt="">
        <div class="hint" style="margin:0;flex:1">点头像换图。不换就用名字首字生成一个。</div>
      </div>
      <input type="file" id="roEditAvatarFile" accept="image/*" class="hidefile">
    </div>

    <div class="f">
      <label>他叫什么</label>
      <input type="text" id="roName" placeholder="例：Antiqua">
    </div>

    <div class="f">
      <label>他是谁 <i>（人设。可以用 {{user}} 指代你、{{char}} 指代他）</i></label>
      <textarea id="roPrompt" rows="7"
        placeholder="例：二十七八岁，开一家只做定制的裁缝铺。话不多，看人先看骨架和布料。&#10;对{{user}}格外上心，嘴上不承认。夸人从不直说，绕着弯说。"></textarea>
    </div>

    <div class="f">
      <label>开场白 <i>（打开聊天时他先说的话，可空）</i></label>
      <textarea id="roGreeting" rows="2" placeholder="例：衣柜我都看过了。今天想穿成什么样？"></textarea>
    </div>

    <div class="f">
      <label>他的气泡颜色</label>
      <input type="color" id="roBubble" value="#1b1b20" style="height:42px;padding:4px">
    </div>

    <div class="row">
      <button class="btn gh" id="roleCancel">取消</button>
      <button class="btn pri" id="roleSave">保存</button>
    </div>
  </div>
  <input type="file" id="roleAvatarFile" accept="image/*" class="hidefile">

  <!-- 抽屉：挑模型 -->
  <div class="drawer" id="dwModels">
    <div class="grip"></div>
    <h2>挑一个模型</h2>
    <div class="hint" id="modelHint">先点「拉取模型列表」才有内容。也可以直接在输入框里手打。</div>
    <div class="f" style="margin-bottom:8px">
      <input id="modelSearch" type="text" placeholder="搜一下，比如 gpt / gemini / vl" autocomplete="off">
    </div>
    <div class="picklist" id="modelPickList"></div>
    <button class="btn gh" id="modelCancel" style="margin-top:10px">关闭</button>
  </div>

  <!-- 抽屉：装到手机桌面 -->
  <div class="drawer" id="dwInstall">
    <div class="grip"></div>
    <h2>装到手机桌面</h2>
    <div class="hint">
      装好之后从桌面图标打开，是全屏的，跟普通 App 一样。数据还是同一份，不会丢。
    </div>
    <div id="installSteps"></div>
    <button class="btn gh" id="installDone" style="margin-top:14px">知道了</button>
  </div>

  <!-- 抽屉：世界书条目 -->
  <div class="drawer" id="dwWb">
    <div class="grip"></div>
    <h2 id="wbEditTitle">新增条目</h2>
    <div class="hint">
      聊到关键词时才把这条塞给他，省 token。勾了「常驻」就一直生效。
    </div>

    <div class="f">
      <label>条目名 <i>（自己看的，可空）</i></label>
      <input type="text" id="wbName" placeholder="例：我们第一次见面">
    </div>

    <div class="f">
      <label>触发关键词 <i>（逗号分隔。常驻条目可不填）</i></label>
      <input type="text" id="wbKeys" placeholder="例：裁缝铺，第一次，量尺">
    </div>

    <div class="f">
      <label>内容</label>
      <textarea id="wbContent" rows="6"
        placeholder="例：两年前的雨天，她推错门进了他的裁缝铺，他没赶人，给她量了尺。那份尺寸他一直留着。"></textarea>
    </div>

    <div class="f">
      <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
        <input type="checkbox" id="wbConst" style="width:auto;margin:0">
        <span>常驻（每次都给他看）</span>
      </label>
    </div>

    <div class="row">
      <button class="btn gh" id="wbCancel">取消</button>
      <button class="btn pri" id="wbSave">保存</button>
    </div>
  </div>

  <!-- 大图 -->
  <div class="lb" id="lb">
    <img id="lbImg" alt="">
    <div class="info" id="lbInfo"></div>
    <button class="btn gh" style="max-width:220px" id="lbEdit">编辑这件</button>
  </div>

  <div class="toasts" id="toasts"></div>
</div>

<script>
/* =============================================================================
 * 私享衣橱 v4.0 —— 独立 PWA 版
 *
 * 跟 v3.x（糯叽机 App 版）的根本区别：
 *   不再依赖任何平台 API。AI 调用直接打你自己配的 OpenAI 兼容接口，
 *   角色、聊天、记忆、世界书全部自建并存在本机。
 *
 * 为什么要脱离：糯叽机的 nuo.ai.vision 在 App 沙盒里是坏的——
 *   6 种带图方式（流式/非流式 × image/images/多模态）全部试过，
 *   要么报 callFailed（平台内部对数组 content 调 substring），
 *   要么图片被静默丢弃（AI 回 NOIMAGE）。识图功能在那个环境里做不出来。
 *   自己直连中转站后，标准多模态格式原生支持，识图不再有任何障碍。
 *
 * 存储：IndexedDB（主）→ localStorage（降级）→ 内存（兜底）
 * 键位：cfg / it:<id> 元数据+缩略图 / im:<id> 高清图 / lk:<id> 搭配记录
 *       ai:cfg 接口配置 / roles 角色表 / me 用户人设
 *       msg:<roleId> 聊天记录 / mem:<roleId> 长期记忆 / wb:<roleId> 世界书
 * ============================================================================= */

/* ------------------------- 0. 基础工具 ------------------------- */
const sleep = (ms) => new Promise(r => setTimeout(r, ms));

/* App 的 logo（丝带 + 十字星）。整个 App 只存这一份，
   开屏、顶栏、PWA 桌面图标都从它来。 */
const LOGO_SRC = 'data:image/png;base64,';

/* 这些错误码沿用平台时期的命名，方便老数据和提示文案复用 */
const ERR_MSG = {
  noApi: '还没配接口，去「设置 → AI 接口配置」填上 Base URL、Key 和模型',
  noKey: '缺 API Key，去「设置 → AI 接口配置」填一下',
  noModel: '没填模型名，去「设置 → AI 接口配置」填一下（识图要用支持看图的模型）',
  unauthorized: 'Key 不对或没权限（401），检查一下 API Key',
  forbidden: '接口拒绝了这次请求（403），可能是 Key 权限或模型不可用',
  notFound: '找不到这个接口地址（404），检查 Base URL 是不是写到 /v1 为止',
  rateLimited: '对方接口说太快了（429），歇一下再试',
  serverErr: '对方接口出错了（5xx），稍后再试',
  netErr: '连不上接口。检查网络、Base URL，以及这个域名是否允许跨域（CORS）',
  timeout: '超时了，再试一次',
  tooLarge: '内容太大了，图片需要再缩小',
  badJson: '接口返回的内容看不懂（不是合法 JSON）',
  noVision: '这个模型好像不支持看图。换成 gpt-4o / gemini / claude 这类带视觉的模型',
  aborted: '已取消'
};
const humanErr = (e) => {
  const k = (e && e.message) || String(e);
  return ERR_MSG[k] || ('失败：' + k);
};

/* ------------------------- 1. AI 接口层 ------------------------- */
/* 直连 OpenAI 兼容接口。所有 AI 能力（聊天、点评、识图、总结）都从这里出去。 */

const API_PRESETS = [
  { name: '自定义 / 中转站', url: '', model: '' },
  { name: 'OpenAI', url: 'https://api.openai.com/v1', model: 'gpt-4o' },
  { name: 'Google Gemini', url: 'https://generativelanguage.googleapis.com/v1beta/openai', model: 'gemini-2.0-flash' },
  { name: 'DeepSeek（不支持识图）', url: 'https://api.deepseek.com/v1', model: 'deepseek-chat' },
  { name: 'SiliconFlow', url: 'https://api.siliconflow.cn/v1', model: 'Qwen/Qwen2.5-VL-72B-Instruct' },
  { name: 'OpenRouter', url: 'https://openrouter.ai/api/v1', model: 'google/gemini-2.0-flash-001' },
  { name: 'Moonshot Kimi', url: 'https://api.moonshot.cn/v1', model: 'moonshot-v1-8k-vision-preview' }
];

/* ---------- 聊天外观（存 look） ----------
 * 背景图、压暗度、字号、字体、两侧气泡的文字颜色。
 * 文字颜色单独可调很重要：气泡底色是用户自己选的，
 * 万一选了深色底又用默认深色字就什么都看不见了。 */
let Look = {
  bg: '',            // 背景图 dataURL，空 = 不用背景
  dim: 55,           // 背景压暗 0-90（%）
  fs: 13.5,          // 字号 px
  ff: '',            // 字体族，空 = 跟随系统
  aiText: '',        // 他的气泡文字色，空 = 默认
  meText: ''         // 我的气泡文字色，空 = 默认
};
const LOOK_DEFAULT = { bg:'', dim:55, fs:13.5, ff:'', aiText:'', meText:'' };
async function loadLook() {
  const raw = dec(await Store.get('look'), null);
  if (raw && typeof raw === 'object') Look = Object.assign({}, LOOK_DEFAULT, raw);
}
async function saveLookCfg() { await Roles.save(); }

/* 拉取回来的模型列表。存一份到本地，下次打开不用重新拉。 */
let ModelList = [];
async function loadModelList() {
  const raw = dec(await Store.get('ai:models'), null);
  ModelList = Array.isArray(raw) ? raw : [];
}

/* ---------- 模型选择器 ----------
 * 不用 <datalist>：手机上它会变成贴着输入法的横条，点不准也看不全。
 * 自己做一个抽屉：可搜索、竖向滚动、点一下就填进去。 */
const ModelPicker = {
  target: '',        // 要把结果填进哪个 input
  open(targetSel) {
    this.target = targetSel;
    const hint = $('#modelHint');
    if (hint) {
      hint.textContent = ModelList.length
        ? '一共 ' + ModelList.length + ' 个。点一下就填进去，也可以先搜一下。'
        : '还没拉过模型列表。先关掉这里，点「拉取模型列表」；或者直接在输入框里手打模型名。';
    }
    const se = $('#modelSearch');
    if (se) se.value = '';
    this.draw('');
    closeDw();
    openDw('#dwModels');
  },
  draw(kw) {
    const box = $('#modelPickList');
    if (!box) return;
    box.innerHTML = '';
    const cur = (($(this.target) || {}).value || '').trim();
    const q = String(kw || '').trim().toLowerCase();
    const list = q ? ModelList.filter(m => m.toLowerCase().indexOf(q) >= 0) : ModelList;

    if (!list.length) {
      const d = document.createElement('div');
      d.className = 'none';
      d.textContent = ModelList.length ? '没有匹配「' + kw + '」的模型' : '列表是空的';
      box.appendChild(d);
      return;
    }
    /* 一次最多渲染 300 条，列表特别长时不至于卡住 */
    list.slice(0, 300).forEach(m => {
      const el = document.createElement('div');
      el.className = 'pk' + (m === cur ? ' on' : '');
      if (q) {
        /* 把命中的那段高亮出来，长列表里好定位 */
        const i = m.toLowerCase().indexOf(q);
        el.appendChild(document.createTextNode(m.slice(0, i)));
        const b = document.createElement('b');
        b.textContent = m.slice(i, i + q.length);
        el.appendChild(b);
        el.appendChild(document.createTextNode(m.slice(i + q.length)));
      } else {
        el.textContent = m;
      }
      el.onclick = async () => {
        const input = $(this.target);
        if (input) {
          input.value = m;
          /* 手动派发 change，让绑定在上面的保存逻辑照常跑 */
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
        closeDw();
        toast('模型已选：' + cut(m, 28));
      };
      box.appendChild(el);
    });
    if (list.length > 300) {
      const d = document.createElement('div');
      d.className = 'none';
      d.textContent = '还有 ' + (list.length - 300) + ' 个没显示，搜一下更快';
      box.appendChild(d);
    }
  }
};

/* 用户自己存的接口预设（存 ai:presets）。
 * 跟内置预设分开放，这样内置的改不坏，用户的也不会被覆盖。 */
let MyPresets = [];
async function loadPresets() {
  const raw = dec(await Store.get('ai:presets'), null);
  MyPresets = Array.isArray(raw) ? raw : [];
}
async function savePresets() { await Store.set('ai:presets', enc(MyPresets)); }

/* 接口配置（存 ai:cfg） */
let AI = {
  url: '',
  key: '',
  model: '',
  visionModel: '',     // 空 = 跟 model 一样
  visionQuality: 'high',
  streamMode: 'auto',  // auto | stream | once
  temp: 0.95,
  /* auto 模式下探测到的结果：'stream' 能流式 / 'once' 只能非流式 */
  autoResolved: ''
};

/* Base URL 规整：去掉尾斜杠、去掉误填的 /chat/completions */
function normApiUrl(u) {
  let s = String(u || '').trim();
  if (!s) return '';
  s = s.replace(/\s+/g, '');
  s = s.replace(/\/+$/, '');
  s = s.replace(/\/chat\/completions$/i, '');
  return s;
}
const apiReady = () => !!(AI.url && AI.key && AI.model);

function apiEndpoint(path) {
  const base = normApiUrl(AI.url);
  if (!base) throw new Error('noApi');
  return base + path;
}

/* 把 HTTP 状态码翻成我们的错误码 */
function statusToErr(status) {
  if (status === 401) return 'unauthorized';
  if (status === 403) return 'forbidden';
  if (status === 404) return 'notFound';
  if (status === 429) return 'rateLimited';
  if (status === 413) return 'tooLarge';
  if (status >= 500) return 'serverErr';
  return 'httpErr' + status;
}

/* 从接口返回的错误体里挖出人能看懂的说明 */
function extractApiErr(bodyText, status) {
  let detail = '';
  try {
    const j = JSON.parse(bodyText);
    detail = (j.error && (j.error.message || j.error.code))
      || j.message || j.detail || '';
  } catch (e) { detail = String(bodyText || '').slice(0, 200); }

  /* 模型不支持图片时，各家措辞不同，统一归到 noVision 好给建议 */
  if (/vision|image|multimodal|not support|unsupported|invalid.*content/i.test(detail)
      && /image|vision|content/i.test(detail)) {
    const e = new Error('noVision');
    e.detail = detail;
    return e;
  }
  const e = new Error(statusToErr(status));
  e.detail = detail;
  return e;
}

/* ---------- 核心：一次对话请求 ----------
 * messages: OpenAI 格式，content 可以是字符串或多模态数组
 * opt: { model, temp, stream, onDelta, signal, maxTokens }
 * 返回完整文本。
 */
async function aiRequest(messages, opt) {
  opt = opt || {};
  if (!AI.url) throw new Error('noApi');
  if (!AI.key) throw new Error('noKey');
  const model = opt.model || AI.model;
  if (!model) throw new Error('noModel');

  /* 决定这次用不用流式：
     强制流式/强制非流式直接照办；auto 模式下第一次试流式，
     如果对方接口不吐 SSE（有些中转站只支持非流式，或返回"假流式"整块 JSON），
     下面的解析会自动兜住，并把结论记在 AI.autoResolved 里供后续复用。 */
  let wantStream;
  if (opt.stream != null) wantStream = !!opt.stream;
  else if (AI.streamMode === 'stream') wantStream = true;
  else if (AI.streamMode === 'once') wantStream = false;
  else wantStream = AI.autoResolved !== 'once';   // auto：默认试流式

  const body = {
    model: model,
    messages: messages,
    temperature: opt.temp != null ? opt.temp : Number(RolePrefs.temp || 0.95),
    stream: wantStream
  };
  if (opt.maxTokens) body.max_tokens = opt.maxTokens;

  let resp;
  try {
    resp = await fetch(apiEndpoint('/chat/completions'), {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + AI.key
      },
      body: JSON.stringify(body),
      signal: opt.signal
    });
  } catch (e) {
    if (e && e.name === 'AbortError') throw new Error('aborted');
    console.warn('fetch 失败', e);
    throw new Error('netErr');
  }

  if (!resp.ok) {
    const t = await resp.text().catch(() => '');
    const err = extractApiErr(t, resp.status);
    console.warn('接口返回错误', resp.status, err.detail || t);
    throw err;
  }

  const ctype = (resp.headers.get('content-type') || '').toLowerCase();
  const isSSE = ctype.indexOf('event-stream') >= 0;

  /* ——— 情况一：真流式（SSE） ——— */
  if (wantStream && isSSE && resp.body && typeof resp.body.getReader === 'function') {
    if (AI.streamMode === 'auto') AI.autoResolved = 'stream';
    return await readSSE(resp, opt.onDelta);
  }

  /* ——— 情况二：要了流式但对方给了整块 JSON（"假流式"/不支持） ——— */
  const raw = await resp.text();
  if (wantStream && AI.streamMode === 'auto') {
    AI.autoResolved = 'once';
    console.info('这个接口不支持真流式，已自动切换为非流式（后续不再尝试流式）');
  }

  /* 有些中转站即使 content-type 不是 event-stream，body 里仍然是 data: 行 */
  if (raw.indexOf('data:') === 0 || raw.indexOf('\ndata:') >= 0) {
    const text = parseSSEText(raw);
    if (text && opt.onDelta) opt.onDelta(text, text);
    if (text) return text;
  }

  let j;
  try { j = JSON.parse(raw); } catch (e) {
    console.warn('返回不是 JSON：', raw.slice(0, 300));
    throw new Error('badJson');
  }
  if (j.error) throw extractApiErr(raw, 200);

  const text = pickContent(j);
  if (opt.onDelta && text) opt.onDelta(text, text);
  return text;
}

/* 从标准响应体里取出文本（兼容几种常见变体） */
function pickContent(j) {
  const ch = j && j.choices && j.choices[0];
  if (!ch) return '';
  const m = ch.message || ch.delta || {};
  let c = m.content;
  /* 少数接口把 content 返回成数组分片 */
  if (Array.isArray(c)) {
    c = c.map(p => (typeof p === 'string' ? p : (p && (p.text || p.content)) || '')).join('');
  }
  if (c == null) c = ch.text || '';
  /* 有些推理模型把正文放 reasoning_content 之外的字段，正文为空时兜一下 */
  if (!c && m.reasoning_content) c = '';
  return String(c || '');
}

/* 逐块读 SSE，边读边回调 onDelta(增量, 累计) */
async function readSSE(resp, onDelta) {
  const reader = resp.body.getReader();
  const dec = new TextDecoder('utf-8');
  let buf = '', full = '';
  for (;;) {
    const { done, value } = await reader.read();
    if (done) break;
    buf += dec.decode(value, { stream: true });

    /* 按空行切分事件块 */
    let idx;
    while ((idx = buf.search(/\r?\n\r?\n/)) >= 0) {
      const chunk = buf.slice(0, idx);
      buf = buf.slice(idx).replace(/^\r?\n\r?\n/, '');
      const piece = handleSSEChunk(chunk);
      if (piece) { full += piece; if (onDelta) onDelta(piece, full); }
    }
  }
  /* 收尾：残留的最后一块 */
  if (buf.trim()) {
    const piece = handleSSEChunk(buf);
    if (piece) { full += piece; if (onDelta) onDelta(piece, full); }
  }
  return full;
}

function handleSSEChunk(chunk) {
  let out = '';
  chunk.split(/\r?\n/).forEach(line => {
    line = line.trim();
    if (!line || line.indexOf(':') === 0) return;      // 注释/心跳
    if (line.indexOf('data:') !== 0) return;
    const data = line.slice(5).trim();
    if (!data || data === '[DONE]') return;
    try {
      const j = JSON.parse(data);
      out += pickContent(j);
    } catch (e) { /* 半个 JSON，忽略 */ }
  });
  return out;
}

/* 把整块"假流式"文本按 SSE 规则解析出正文 */
function parseSSEText(raw) {
  let out = '';
  String(raw || '').split(/\r?\n/).forEach(line => {
    line = line.trim();
    if (line.indexOf('data:') !== 0) return;
    const d = line.slice(5).trim();
    if (!d || d === '[DONE]') return;
    try { out += pickContent(JSON.parse(d)); } catch (e) { /* ignore */ }
  });
  return out;
}

/* 拉模型列表 */
async function aiListModels() {
  if (!AI.url) throw new Error('noApi');
  if (!AI.key) throw new Error('noKey');
  let resp;
  try {
    resp = await fetch(apiEndpoint('/models'), {
      headers: { 'Authorization': 'Bearer ' + AI.key }
    });
  } catch (e) { throw new Error('netErr'); }
  if (!resp.ok) {
    const t = await resp.text().catch(() => '');
    throw extractApiErr(t, resp.status);
  }
  const j = await resp.json().catch(() => null);
  const list = (j && (j.data || j.models || j)) || [];
  return (Array.isArray(list) ? list : [])
    .map(m => (typeof m === 'string' ? m : (m.id || m.name || '')))
    .filter(Boolean)
    .sort();
}

/* 生图：/images/generations。不是所有中转站都开这个，失败就返回空。 */
async function aiGenImage(prompt) {
  if (!apiReady()) throw new Error('noApi');
  let resp;
  try {
    resp = await fetch(apiEndpoint('/images/generations'), {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + AI.key
      },
      body: JSON.stringify({
        prompt: String(prompt || '').slice(0, 3800),
        n: 1,
        size: '1024x1024',
        response_format: 'b64_json'
      })
    });
  } catch (e) { throw new Error('netErr'); }
  if (!resp.ok) {
    const t = await resp.text().catch(() => '');
    throw extractApiErr(t, resp.status);
  }
  const j = await resp.json().catch(() => null);
  const d = j && j.data && j.data[0];
  if (!d) return '';
  if (d.b64_json) return 'data:image/png;base64,' + d.b64_json;
  return d.url || '';
}

/* ------------------------- 2. 兼容桥（保留 Bridge 名字，改走自有接口） -------------------------
 * 原来的调用点很多，保留同名方法可以不动业务代码。 */
const Bridge = {
  /* PWA 里没有"退回聊天页"，返回键改成回衣橱 */
  close() { go('closet'); },

  /* 名册 → 自建角色表 */
  async roster() {
    return (Roles.list || []).map(r => ({ id: r.id, name: r.name }));
  },

  /* 带角色身份的对话：自己组 system prompt */
  async chat(messages, roleId, opt) {
    const msgs = (messages || []).slice();
    /* 调用方给的 system 放前面，角色人设追加进去 */
    if (roleId) {
      const r = Roles.byId(roleId);
      if (r && r.prompt) {
        const i = msgs.findIndex(m => m.role === 'system');
        const add = '\n\n【你的身份】\n' + applyVars(r.prompt, r);
        if (i >= 0) msgs[i] = { role: 'system', content: String(msgs[i].content || '') + add };
        else msgs.unshift({ role: 'system', content: add.trim() });
      }
    }
    return await aiRequest(msgs, opt);
  },

  /* 识图：标准 OpenAI 多模态，图片 base64 直接进 content 数组 */
  async vision(prompt, dataUrl, quality) {
    return await visionSafe(prompt, dataUrl, quality);
  },

  async genImage(prompt) {
    try { return await aiGenImage(prompt); }
    catch (e) { console.warn('生图失败', e); throw e; }
  },

  /* 发卡片 → 直接写进本机聊天记录 */
  async sendCard(card, fallbackText) {
    const rid = S.charId || Roles.activeId;
    if (!rid) throw new Error('还没建角色，去「设置 → 角色」建一位');
    await Chat.pushCard(rid, card, fallbackText);
  },

  /* 选图：一次最多多选 20 张 */
  pickImages() {
    return new Promise((resolve) => {
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.multiple = true;
      input.style.display = 'none';
      document.body.appendChild(input);
      let done = false;
      const finish = (v) => {
        if (done) return; done = true;
        if (input.parentNode) input.parentNode.removeChild(input);
        window.removeEventListener('focus', onFocus);
        resolve(v);
      };
      function onFocus() {
        setTimeout(() => { if (!done && !(input.files && input.files.length)) finish([]); }, 1200);
      }
      input.onchange = () => finish(input.files ? Array.prototype.slice.call(input.files) : []);
      input.oncancel = () => finish([]);
      window.addEventListener('focus', onFocus);
      input.click();
    });
  },

  /* 存图：PWA 里用下载 */
  async savePhoto(dataUrl, name) {
    const a = document.createElement('a');
    a.href = dataUrl;
    a.download = name || 'look.png';
    document.body.appendChild(a);
    a.click();
    setTimeout(() => { if (a.parentNode) a.parentNode.removeChild(a); }, 100);
  },

  /* 震动 */
  vibrate(ms) {
    try { if (navigator.vibrate) navigator.vibrate(ms || 12); } catch (e) { /* ignore */ }
  }
};

/* ------------------------- 2.5 角色 / 我 / 聊天 数据层 -------------------------
 * 这些原来都由糯叽机提供（名册、人设、聊天记录、长期记忆），现在全部自建。
 * 存储键：roles / me / msg:<roleId> / mem:<roleId> / wb:<roleId>
 */

/* 默认头像：用首字生成一张纯色圆底 SVG，省得强制用户上传 */
function defaultAvatar(name, color) {
  const ch = String(name || '?').trim().charAt(0) || '?';
  const bg = color || '#2f2f37';
  const svg = '<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96">'
    + '<rect width="96" height="96" rx="48" fill="' + bg + '"/>'
    + '<text x="48" y="62" font-size="42" text-anchor="middle" fill="#fff"'
    + ' font-family="sans-serif">' + ch.replace(/[<>&"]/g, '') + '</text></svg>';
  return 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svg)));
}

/* ---------- 角色表 ---------- */
const Roles = {
  list: [],
  activeId: '',

  byId(id) { return this.list.filter(r => r.id === String(id))[0] || null; },
  get active() { return this.byId(this.activeId) || this.list[0] || null; },

  async load() {
    const raw = dec(await Store.get('roles'), null);
    if (raw && Array.isArray(raw.list)) {
      this.list = raw.list;
      this.activeId = raw.activeId || (raw.list[0] && raw.list[0].id) || '';
    } else {
      this.list = [];
      this.activeId = '';
    }
    /* 补齐缺省字段，老数据也能用 */
    this.list.forEach(r => {
      if (!r.avatar) r.avatar = defaultAvatar(r.name, '#3a2f38');
      if (!r.bubble) r.bubble = '#1b1b20';
      if (r.greeting == null) r.greeting = '';
    });
  },
  async save() {
    await Store.set('roles', enc({ list: this.list, activeId: this.activeId }));
  },

  async add(data) {
    const r = Object.assign({
      id: uid('ro_'),
      name: '',
      prompt: '',
      greeting: '',
      avatar: '',
      bubble: '#1b1b20',
      createdAt: Date.now()
    }, data || {});
    if (!r.name) r.name = '他 ' + (this.list.length + 1);
    if (!r.avatar) r.avatar = defaultAvatar(r.name, '#3a2f38');
    ensureRoleSettings(r, false);
    this.list.push(r);
    if (!this.activeId) this.activeId = r.id;
    await this.save();
    return r;
  },
  async update(id, patch) {
    const r = this.byId(id);
    if (!r) return null;
    Object.assign(r, patch || {});
    await this.save();
    return r;
  },
  async remove(id) {
    this.list = this.list.filter(r => r.id !== String(id));
    if (this.activeId === String(id)) this.activeId = (this.list[0] && this.list[0].id) || '';
    await this.save();
    /* 连带清掉他的聊天、记忆、世界书 */
    await Store.remove('msg:' + id);
    await Store.remove('mem:' + id);
    await Store.remove('wb:' + id);
  }
};

/* ---------- 我 ---------- */
let Me = {
  name: '',
  persona: '',
  avatar: '',
  bubble: '#ff7597'
};
async function loadMe() {
  const raw = dec(await Store.get('me'), null);
  if (raw && typeof raw === 'object') Me = Object.assign(Me, raw);
  if (!Me.avatar) Me.avatar = defaultAvatar(Me.name || '我', '#4a2b38');
}
const ME_DEFAULT = { name:'', persona:'', avatar:'', bubble:'#ff7597' };
const CHAT_DEFAULT = { temp:0.95, rpMode:'immersive', wardrobeShare:'all', memRounds:40, memAuto:20 };
let RolePrefs = Object.assign({}, CHAT_DEFAULT);

function newRoleSettings(legacy) {
  const chat = Object.assign({}, CHAT_DEFAULT);
  if (legacy) Object.keys(chat).forEach(k => { if (AI[k] != null) chat[k] = AI[k]; });
  return {
    me: Object.assign({}, ME_DEFAULT, legacy ? Me : {}),
    look: Object.assign({}, LOOK_DEFAULT, legacy ? Look : {}),
    chat: chat
  };
}
function ensureRoleSettings(role, legacy) {
  const base = newRoleSettings(legacy);
  const saved = role.settings || {};
  role.settings = {
    me: Object.assign(base.me, saved.me || {}),
    look: Object.assign(base.look, saved.look || {}),
    chat: Object.assign(base.chat, saved.chat || {})
  };
  return role.settings;
}
function useRoleSettings(role) {
  const cfg = role ? (role.settings || ensureRoleSettings(role, false)) : newRoleSettings(false);
  Me = cfg.me;
  Look = cfg.look;
  RolePrefs = cfg.chat;
}
async function saveMe() { await Roles.save(); }
function roleSwitchBlocked() {
  if (Chat.busy || Chat.summarizing || Chat.switching) {
    toast('请等待当前回复、总结或角色切换完成');
    return true;
  }
  return false;
}
async function openRoleSettings(roleId) {
  const role = Roles.byId(roleId);
  if (!role || roleSwitchBlocked()) return;
  Chat.switching = true;
  try {
    Roles.activeId = role.id;
    S.charId = role.id;
    S.charName = role.name;
    await Chat.open(role.id);
    await Roles.save();
    await saveCfg();
    chatView = 'list';
    go('roleSet');
    drawWb();
    drawMem();
  } catch (e) { toast('角色设置加载失败：' + humanErr(e)); }
  finally { Chat.switching = false; }
}
function setupSettingsPages() {
  const box = $('#roleSettingsPanels');
  const me = $('#foldMe');
  box.appendChild(me);
  ['foldMem','foldWardrobe','foldStyle','foldLook'].forEach(id => {
    box.appendChild($('#' + id).closest('.setgrp'));
  });
  const footer = document.createElement('div');
  footer.className = 'settings-footer';
  const save = document.createElement('button');
  save.className = 'btn pri';
  save.id = 'saveGlobalSettings';
  save.textContent = '保存通用设置';
  footer.appendChild(save);
  $('#pgSet').appendChild(footer);
  $('#roleSettingsBack').onclick = () => go('set');
  $('#roleProfileEdit').onclick = () => RoleEditor.open(Roles.activeId);
  $('#saveRoleSettings').onclick = () => saveSettingsPage(true);
  save.onclick = () => saveSettingsPage(false);
}
async function saveSettingsPage(privatePage) {
  const button = $(privatePage ? '#saveRoleSettings' : '#saveGlobalSettings');
  button.disabled = true;
  try {
    if (privatePage) {
      if (!Roles.byId(Roles.activeId)) throw new Error('请先选择角色');
      Me.name = $('#meNameInput').value.trim();
      Me.persona = $('#mePersona').value;
      Me.bubble = $('#meBubble').value;
      RolePrefs.temp = Number($('#rpTemp').value);
      RolePrefs.rpMode = $('#rpMode').value;
      RolePrefs.wardrobeShare = $('#wardrobeShare').value;
      RolePrefs.memRounds = Number($('#memRounds').value);
      RolePrefs.memAuto = Number($('#memAuto').value);
      Look.dim = Number($('#bgDim').value);
      Look.fs = Number($('#chatFs').value);
      Look.ff = $('#chatFf').value;
      Look.aiText = $('#aiTextColor').value;
      Look.meText = $('#meTextColor').value;
      await Roles.save();
      await saveWb();
      await saveMem();
      applyChatLook();
    } else {
      await saveAIFromForm();
      await saveCfg();
    }
    toast(privatePage ? '当前角色设置已保存' : '通用设置已保存');
  } catch (e) { toast('保存失败：' + humanErr(e)); }
  finally { button.disabled = false; }
}

/* ---------- 聊天记录 ----------
 * 每个角色一条独立记录，结构：
 *   { role:'user'|'ai'|'sys', text, ts, look?:{...}, imgs?:[...] }
 * look 用来在聊天里渲染穿搭卡片。
 */
const Chat = {
  cur: '',              // 当前打开的角色 id
  msgs: [],             // 当前角色的消息数组
  busy: false,          // 正在等 AI 回复
  abort: null,          // AbortController

  async open(roleId) {
    this.cur = String(roleId || '');
    this.msgs = dec(await Store.get('msg:' + this.cur), []) || [];
    if (!Array.isArray(this.msgs)) this.msgs = [];
    useRoleSettings(Roles.byId(this.cur));
    await loadWb();
    await loadMem();
    applyChatLook();
    return this.msgs;
  },
  async persist() {
    if (!this.cur) return;
    /* 只留最近 400 条，避免无限膨胀 */
    if (this.msgs.length > 400) this.msgs = this.msgs.slice(-400);
    await Store.set('msg:' + this.cur, enc(this.msgs));
  },

  /* 往指定角色（不一定是当前打开的）追加一条 */
  async pushTo(roleId, m) {
    const rid = String(roleId);
    if (rid === this.cur) {
      this.msgs.push(m);
      await this.persist();
      if (typeof drawMsgs === 'function') drawMsgs();
    } else {
      const arr = dec(await Store.get('msg:' + rid), []) || [];
      arr.push(m);
      if (arr.length > 400) arr.splice(0, arr.length - 400);
      await Store.set('msg:' + rid, enc(arr));
    }
  },

  /* 把一套搭配作为「卡片消息」发进聊天，并让角色回应 */
  async pushLook(roleId, look, text) {
    const items = S.items.filter(i => (look.itemIds || []).indexOf(i.id) >= 0);
    await this.pushTo(roleId, {
      role: 'user',
      ts: Date.now(),
      text: '（发来一套搭配）',
      look: {
        name: look.name || '',
        plan: pickSection(look.comment, '搭配') || '',
        thumbs: items.slice(0, 8).map(i => i.thumb).filter(Boolean),
        names: items.map(i => i.name || i.category || '单品'),
        promptEn: look.promptEn || '',
        genImage: look.genImage || ''
      },
      /* raw 给 AI 看：卡片本身 AI 读不了，得有文字版 */
      raw: text || ''
    });
  },

  /* Bridge.sendCard 的落地实现 */
  async pushCard(roleId, card, fallbackText) {
    await this.pushTo(roleId, {
      role: 'user', ts: Date.now(),
      text: '（发来一张卡片）',
      raw: fallbackText || ''
    });
  },

  async switchTo(roleId) {
    Roles.activeId = String(roleId);
    await Roles.save();
    await this.open(roleId);
    if (typeof drawChatList === 'function') drawChatList();
    if (typeof drawMsgs === 'function') drawMsgs();
  }
};

/* {{char}} / {{user}} 占位替换 */
function applyVars(str, role) {
  const cn = (role && role.name) || '他';
  const un = (Me.name || '你');
  return String(str || '')
    .replace(/\{\{char\}\}/gi, cn)
    .replace(/\{\{user\}\}/gi, un);
}

/* ------------------------- 3. 存储层 ------------------------- */
const Store = (() => {
  const DB_NAME = 'boudoir_closet';
  const STORE = 'kv';
  const LS_PREFIX = 'bc:';
  let driver = 'memory';
  let idb = null;
  const mem = new Map();

  function openIdb() {
    /* 不写死版本号：早期版本用过同名库但表结构不同，
       写死版本会导致 onupgradeneeded 不触发、目标表永远建不出来。 */
    return new Promise((res, rej) => {
      if (!('indexedDB' in window)) return rej(new Error('no idb'));
      let probe;
      try { probe = indexedDB.open(DB_NAME); } catch (e) { return rej(e); }
      probe.onerror = () => rej(probe.error || new Error('open failed'));
      probe.onsuccess = () => {
        const d = probe.result;
        if (d.objectStoreNames.contains(STORE)) return res(d);
        const next = d.version + 1;
        d.close();
        let up;
        try { up = indexedDB.open(DB_NAME, next); } catch (e) { return rej(e); }
        up.onupgradeneeded = (e) => {
          const d2 = e.target.result;
          if (!d2.objectStoreNames.contains(STORE)) d2.createObjectStore(STORE, { keyPath: 'k' });
        };
        up.onsuccess = () => res(up.result);
        up.onerror = () => rej(up.error || new Error('upgrade failed'));
      };
    });
  }
  function idbRun(mode, fn) {
    return new Promise((res, rej) => {
      let t;
      try { t = idb.transaction(STORE, mode); } catch (e) { return rej(e); }
      let rq;
      try { rq = fn(t.objectStore(STORE)); } catch (e) { return rej(e); }
      rq.onsuccess = () => res(rq.result);
      rq.onerror = () => rej(rq.error);
      t.onabort = () => rej(t.error || new Error('tx aborted'));
    });
  }

  return {
    get driver() { return driver; },

    async init() {
      try {
        idb = await openIdb();
        driver = 'indexedDB';
      } catch (e) {
        console.warn('IndexedDB 不可用，退到 localStorage', e);
        try {
          localStorage.setItem(LS_PREFIX + '__t', '1');
          localStorage.removeItem(LS_PREFIX + '__t');
          driver = 'localStorage';
        } catch (e2) {
          driver = 'memory';
          console.warn('localStorage 也不可用，退化为内存模式（关掉页面就丢）', e2);
        }
      }
      return driver;
    },

    async set(k, v) {
      if (driver === 'indexedDB') return idbRun('readwrite', s => s.put({ k, v }));
      if (driver === 'localStorage') {
        try { localStorage.setItem(LS_PREFIX + k, typeof v === 'string' ? v : JSON.stringify(v)); }
        catch (e) { throw new Error('tooLarge'); }
        return;
      }
      mem.set(k, v);
    },
    async get(k) {
      if (driver === 'indexedDB') {
        const row = await idbRun('readonly', s => s.get(k));
        return row ? row.v : undefined;
      }
      if (driver === 'localStorage') {
        const s = localStorage.getItem(LS_PREFIX + k);
        return s == null ? undefined : s;
      }
      return mem.get(k);
    },
    async remove(k) {
      if (driver === 'indexedDB') return idbRun('readwrite', s => s.delete(k));
      if (driver === 'localStorage') { localStorage.removeItem(LS_PREFIX + k); return; }
      mem.delete(k);
    },
    async all() {
      if (driver === 'indexedDB') {
        const rows = await idbRun('readonly', s => s.getAll());
        const map = {};
        (rows || []).forEach(r => { map[r.k] = r.v; });
        return map;
      }
      if (driver === 'localStorage') {
        const map = {};
        for (let i = 0; i < localStorage.length; i++) {
          const kk = localStorage.key(i);
          if (kk && kk.indexOf(LS_PREFIX) === 0) map[kk.slice(LS_PREFIX.length)] = localStorage.getItem(kk);
        }
        return map;
      }
      const map = {};
      mem.forEach((v, k) => { map[k] = v; });
      return map;
    }
  };
})();

const enc = (o) => JSON.stringify(o);
const dec = (s, dflt) => {
  if (s == null) return dflt;
  if (typeof s === 'object') return s;
  try { return JSON.parse(s); } catch (e) { return dflt; }
};

/* ------------------------- 2. 常量与状态 ------------------------- */
const DEFAULT_CATS = ['上装', '下装', '连衣裙', '内衣 / 睡裙', '鞋履', '配饰 / 饰品', '特殊道具', '未分类'];

const TAG_PRESETS = [
  { group: '颜色', tags: ['粉色', '纯白', '深黑', '雾霾蓝', '红黑撞色', '奶油杏'] },
  { group: '材质', tags: ['丝缎', '真丝', '蕾丝', '皮革', '雪纺', '针织'] },
  { group: '版型 / 细节', tags: ['露背', '吊带', '百褶', '修身', '微透', '系带', '绑带'] },
  { group: '风格 / 场合', tags: ['甜酷', '哥特', '居家', '约会', '私密场景', '通勤'] },
  { group: '季节', tags: ['春季', '夏季', '秋季', '冬季', '四季通用'] },
  { group: '厚薄程度', tags: ['薄款', '适中', '厚款', '加厚'] },
  { group: '角色绑定', tags: [] }
];
const PRESET_SET = new Set(TAG_PRESETS.reduce((a, g) => a.concat(g.tags), []));
const PRESET_GROUPS = TAG_PRESETS.map(g => g.group);
/* 找不到归属的自定义标签（旧数据、角色写入、批量打标）落在这一栏 */
const MISC_GROUP = '其它';

/* ---------- 标签池：按维度归档 ----------
 * 结构 { '颜色': ['雾灰'], '材质': ['天鹅绒'], '我的场合': [...] }
 * 旧版本存的是扁平数组，迁移时整体并入「其它」，不丢标签。
 */
function removedTagGroup(value) {
  return /品牌|渠道|brand|channel/i.test(String(value || ''));
}
function removedTag(value) {
  return /^(?:品牌|渠道|brand|channel)\s*[:：/]/i.test(String(value || '').trim());
}
function cleanItemTags(item, pool) {
  const obsolete = new Set([item.brand, item.channel, item.brandChannel, item.brand_channel].filter(Boolean));
  Object.keys(pool || {}).forEach(g => {
    if (removedTagGroup(g) && Array.isArray(pool[g])) pool[g].forEach(t => obsolete.add(t));
  });
  ['brand','channel','brandChannel','brand_channel'].forEach(k => { delete item[k]; });
  item.tags = (Array.isArray(item.tags) ? item.tags : []).filter(t => typeof t === 'string' && !obsolete.has(t) && !removedTag(t));
  return item;
}
function normalizePool(raw) {
  const pool = {};
  if (Array.isArray(raw)) {
    const rest = raw.filter(t => typeof t === 'string' && t && !PRESET_SET.has(t) && !removedTag(t));
    if (rest.length) pool[MISC_GROUP] = Array.from(new Set(rest));
    return pool;
  }
  if (raw && typeof raw === 'object') {
    Object.keys(raw).forEach(g => {
      if (removedTagGroup(g) || !Array.isArray(raw[g])) return;
      const list = Array.from(new Set(raw[g].filter(t => typeof t === 'string' && t && !removedTag(t))));
      if (list.length) pool[g] = list;
    });
  }
  return pool;
}

/* 自定义标签落进指定维度；group 省略则进「其它」。返回是否真的新增 */
function addToPool(tag, group) {
  tag = (tag || '').trim();
  if (!tag) return false;
  const g = (group || MISC_GROUP).trim() || MISC_GROUP;
  if (removedTagGroup(g) || removedTag(tag)) return false;
  /* 预设里已有这个词就不必重复收录 */
  const preset = TAG_PRESETS.find(x => x.group === g);
  if (preset && preset.tags.indexOf(tag) >= 0) return false;
  if (!S.pool[g]) S.pool[g] = [];
  if (S.pool[g].indexOf(tag) >= 0) return false;
  S.pool[g].push(tag);
  return true;
}

/* 这个标签已经存在于哪个维度（用于避免同名标签重复收录） */
function groupOfTag(tag) {
  for (const g of TAG_PRESETS) {
    if (g.tags.indexOf(tag) >= 0) return g.group;
  }
  const keys = Object.keys(S.pool);
  for (const k of keys) {
    if (S.pool[k].indexOf(tag) >= 0) return k;
  }
  return null;
}

/* 渲染顺序：预设维度 → 用户自建维度 → 其它 */
function tagGroups() {
  const out = TAG_PRESETS.map(g => ({
    group: g.group,
    preset: g.tags,
    custom: (S.pool[g.group] || []).slice()
  }));
  Object.keys(S.pool).forEach(g => {
    if (PRESET_GROUPS.indexOf(g) >= 0 || g === MISC_GROUP) return;
    out.push({ group: g, preset: [], custom: S.pool[g].slice(), userMade: true });
  });
  if (S.pool[MISC_GROUP] && S.pool[MISC_GROUP].length) {
    out.push({ group: MISC_GROUP, preset: [], custom: S.pool[MISC_GROUP].slice(), userMade: true });
  }
  return out;
}

const S = {
  items: [],
  looks: [],
  cats: [],
  pool: {},   // 按维度归档的自定义标签
  cat: '__all__',
  kw: '',
  page: 'closet',
  pickMode: false,
  picked: new Set(),
  editing: null,
  pending: [],
  draft: new Set(),
  charId: null,
  charName: '',
  chars: [],
  lastVerdict: null   // { comment, promptEn, itemIds, charId, charName, genImage }
};

const $ = (s) => document.querySelector(s);
const $$ = (s) => Array.prototype.slice.call(document.querySelectorAll(s));
/* 供稿 id 只能用 A-Z a-z 0-9 _ . -，角色要原样写回来 */
const uid = (p) => p + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
const cut = (s, n) => { s = (s == null ? '' : String(s)); return s.length > n ? s.slice(0, n) : s; };

/* ------------------------- 3. Toast ------------------------- */
function toast(msg, opt) {
  opt = opt || {};
  const el = document.createElement('div');
  el.className = 'toast';
  if (opt.loading) {
    const sp = document.createElement('span');
    sp.className = 'spin';
    el.appendChild(sp);
  }
  const tx = document.createElement('span');
  tx.textContent = msg;
  el.appendChild(tx);

  let timer = null;
  const close = () => { if (timer) clearInterval(timer); if (el.parentNode) el.remove(); };

  if (typeof opt.undo === 'function') {
    let left = opt.sec || 5;
    const b = document.createElement('span');
    b.className = 'u';
    b.textContent = '撤回 ' + left + 's';
    b.onclick = () => { close(); opt.undo(); };
    el.appendChild(b);
    timer = setInterval(() => {
      left -= 1;
      if (left <= 0) return close();
      b.textContent = '撤回 ' + left + 's';
    }, 1000);
  } else if (opt.action && typeof opt.onAction === 'function') {
    /* 带一个快捷操作按钮，比如「去看看」「发给他看」 */
    const b = document.createElement('span');
    b.className = 'u';
    b.textContent = opt.action;
    b.onclick = () => { close(); opt.onAction(); };
    el.appendChild(b);
    setTimeout(close, opt.duration || 5000);
  } else if (!opt.loading) {
    setTimeout(close, opt.duration || 2300);
  }
  $('#toasts').appendChild(el);
  return { close, update: (t) => { tx.textContent = t; } };
}

/* ------------------------- 4. 图片处理 ------------------------- */
/* 卡片单图上限 18 万字符（≈130KB），超了那一块会被整块丢掉 */
const CARD_MAX_CHARS = 175000;

function loadImg(src) {
  return new Promise((res, rej) => {
    const im = new Image();
    im.onload = () => res(im);
    im.onerror = () => rej(new Error('图片解码失败'));
    im.src = src;
  });
}
function readFile(f) {
  return new Promise((res, rej) => {
    const fr = new FileReader();
    fr.onload = () => res(fr.result);
    fr.onerror = () => rej(fr.error);
    fr.readAsDataURL(f);
  });
}
/* ---------- 等比缩放：永远不拉伸、不压扁 ----------
 * k 取长边比例，宽高同乘一个 k —— 原始宽高比被完整保留。
 * 横图、竖图、方图、极端长图都能正确处理。 */
function scale(img, maxEdge, q) {
  const iw = img.naturalWidth || img.width;
  const ih = img.naturalHeight || img.height;
  const k = Math.min(1, maxEdge / Math.max(iw, ih));   // 只缩不放，小图保持原样
  const w = Math.max(1, Math.round(iw * k));
  const h = Math.max(1, Math.round(ih * k));
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  const g = c.getContext('2d');
  /* 缩图质量：浏览器默认的双线性在大幅缩小时会糊，开高质量插值 */
  g.imageSmoothingEnabled = true;
  g.imageSmoothingQuality = 'high';
  g.fillStyle = '#15151a';
  g.fillRect(0, 0, w, h);
  g.drawImage(img, 0, 0, w, h);
  return { url: c.toDataURL('image/jpeg', q), w, h };
}

/* ---------- 方图裁切：用于头像 ----------
 * 从原图中心切一个最大的正方形再缩放。
 * 这样竖构图的人像不会被横向压扁，也不会留黑边。 */
function squareCrop(img, side, q) {
  const iw = img.naturalWidth || img.width;
  const ih = img.naturalHeight || img.height;
  const cut = Math.min(iw, ih);              // 原图里能切出的最大正方形
  const sx = Math.round((iw - cut) / 2);     // 居中
  const sy = Math.round((ih - cut) / 2);
  const out = Math.min(side, cut);           // 小图不放大
  const c = document.createElement('canvas');
  c.width = out; c.height = out;
  const g = c.getContext('2d');
  g.imageSmoothingEnabled = true;
  g.imageSmoothingQuality = 'high';
  g.fillStyle = '#2a2a30';
  g.fillRect(0, 0, out, out);
  g.drawImage(img, sx, sy, cut, cut, 0, 0, out, out);
  return c.toDataURL('image/jpeg', q);
}

/* ---------- 智能压缩 ----------
 * 目标：肉眼看不出差别，但体积可控。
 * 做法是先按长边缩，再看结果多大：太大就一档一档降画质，
 * 降到 0.62 还嫌大就继续缩尺寸。绝不因为"太大"而拒绝一张图。
 *   budget 单位是 base64 字符数（≈ 实际字节 × 1.37）
 */
function shrinkTo(img, maxEdge, budget, minQ) {
  let q = 0.88;
  let edge = maxEdge;
  let out = scale(img, edge, q);
  const floorQ = minQ || 0.62;
  while (out.url.length > budget && q > floorQ) {
    q = Math.round((q - 0.06) * 100) / 100;
    out = scale(img, edge, q);
  }
  /* 画质已经降到底线还超预算 → 改缩尺寸，每轮 82%，最多缩到 480px */
  while (out.url.length > budget && edge > 480) {
    edge = Math.round(edge * 0.82);
    out = scale(img, edge, floorQ + 0.06);
  }
  return out;
}

/* 一张衣服照片 → 缩略图 + 高清图。
 * 高清图给足 1600px / 约 420KB 的预算，放大看细节也清楚；
 * 缩略图 400px，瀑布流滑动不掉帧。 */
async function processFile(file) {
  const raw = await readFile(file);
  const img = await loadImg(raw);
  const t = shrinkTo(img, 400, 90000);      // ≈ 65KB
  const f = shrinkTo(img, 1600, 580000);    // ≈ 420KB
  return {
    thumb: t.url,
    full: f.url,
    w: img.naturalWidth || img.width,
    h: img.naturalHeight || img.height
  };
}

/* 发卡片 / 识图前用的尺寸：720px、0.7，超长再降质，直到进得了卡片 */
async function toCardImage(dataUrl) {
  if (!dataUrl) return '';
  const img = await loadImg(dataUrl);
  let edge = 720, q = 0.7, out = scale(img, edge, q).url;
  while (out.length > CARD_MAX_CHARS && q > 0.38) {
    q -= 0.12;
    out = scale(img, edge, q).url;
  }
  while (out.length > CARD_MAX_CHARS && edge > 320) {
    edge = Math.round(edge * 0.8);
    out = scale(img, edge, 0.6).url;
  }
  return out.length > CARD_MAX_CHARS ? '' : out;
}

/* ================= 识图层 =================
 * 脱离糯叽机之后，识图就是一次普通的 chat 请求，只是 content 变成多模态数组：
 *   [{type:'text',...}, {type:'image_url', image_url:{url:'data:image/jpeg;base64,...'}}]
 * 这是 OpenAI 的标准格式，所有兼容接口（中转站、OpenAI、Gemini 兼容层…）都认。
 * 不再需要路径探测、降级重试、频率闸门那一整套——那些是为了绕平台 bug 才有的。
 *
 * 唯一的前提：模型本身得支持看图（gpt-4o / gemini / claude / qwen-vl 这类）。
 * 模型不支持时接口会明确报错，我们翻成「换个带视觉的模型」提示给用户。
 */

/* 这些错误意味着「配置本身不对」，批量识图时后面每一张都会同样失败，
 * 没必要继续发请求——直接停下来，剩下的照片无标签入柜。 */
const VISION_STOP = ['noApi', 'noKey', 'noModel', 'unauthorized', 'forbidden', 'notFound', 'noVision', 'netErr'];

/* 识图发出去的图片尺寸。越大越清楚也越贵。 */
const VISION_PRESET = {
  low:  { edge: 512,  q: 0.6  },
  auto: { edge: 720,  q: 0.7  },
  high: { edge: 1024, q: 0.82 }
};
/* 单张图 base64 的上限。太大容易被接口拒（413）或超模型上下文。 */
const VISION_MAX_CHARS = 900000;   // ≈ 660KB

async function buildVisionImage(dataUrl, quality) {
  if (!dataUrl) return '';
  const p = VISION_PRESET[quality] || VISION_PRESET[AI.visionQuality] || VISION_PRESET.high;
  const img = await loadImg(dataUrl);
  let edge = p.edge, q = p.q, out = scale(img, edge, q).url;
  while (out.length > VISION_MAX_CHARS && q > 0.4) {
    q -= 0.1;
    out = scale(img, edge, q).url;
  }
  while (out.length > VISION_MAX_CHARS && edge > 384) {
    edge = Math.round(edge * 0.8);
    out = scale(img, edge, 0.62).url;
  }
  return out.length > VISION_MAX_CHARS ? '' : out;
}

/* 统一识图入口。所有「让 AI 看图」的地方都走这里。
 * 返回 { text }，保持跟老代码一样的形状，调用点不用改。 */
async function visionSafe(prompt, rawDataUrl, quality, roleId, onWait) {
  if (!apiReady()) throw new Error('noApi');

  const img = await buildVisionImage(rawDataUrl, quality);
  if (!img) throw new Error('tooLarge');

  const messages = [{
    role: 'user',
    content: [
      { type: 'text', text: String(prompt || '') },
      { type: 'image_url', image_url: { url: img } }
    ]
  }];

  /* 识图用固定低温度：要的是稳定、可解析的客观描述，不要它发挥 */
  const text = await aiRequest(messages, {
    model: AI.visionModel || AI.model,
    temp: 0.3,
    stream: false          // 识图不需要逐字，整块拿回来最省事
  });
  return { text: text || '' };
}


/* 一次最多入库的张数。放宽到 50——一次性整理一批衣服时 20 张不太够用。
 * 不是不能更多，是再多会让"压缩 N 张"的等待变得难熬，而且识图额度也吃不消。 */
const UPLOAD_MAX = 50;

async function ingest(files) {
  const all = Array.prototype.slice.call(files || []).filter(f => f.type && f.type.indexOf('image/') === 0);
  if (!all.length) return;

  const room = Math.max(0, UPLOAD_MAX - S.pending.length);
  if (!room) return toast('一次最多 ' + UPLOAD_MAX + ' 张，先保存这一批再传下一批');
  const list = all.slice(0, room);
  const dropped = all.length - list.length;

  const t = toast('正在等比压缩 ' + list.length + ' 张图…', { loading: true });
  for (let i = 0; i < list.length; i++) {
    try {
      if (t.update) t.update('正在等比压缩 ' + (i + 1) + ' / ' + list.length + ' 张…');
      S.pending.push(await processFile(list[i]));
    } catch (e) {
      console.warn('压缩失败', e);
      toast('有一张图读不出来，已跳过');
    }
  }
  t.close();
  if (dropped) toast('一次最多 ' + UPLOAD_MAX + ' 张，这次先收了 ' + list.length + ' 张，还有 ' + dropped + ' 张没进来', { duration: 5000 });
  drawPvs();
}

function drawPvs() {
  const box = $('#pvs');
  box.innerHTML = '';
  S.pending.forEach((im, i) => {
    const d = document.createElement('div');
    d.className = 'pv';
    const img = document.createElement('img');
    img.src = im.thumb;
    const x = document.createElement('span');
    x.textContent = '✕';
    x.onclick = () => { S.pending.splice(i, 1); drawPvs(); };
    d.appendChild(img); d.appendChild(x);
    box.appendChild(d);
  });
  /* 有图才显示识图按钮行 */
  const n = S.pending.length;
  const row = $('#autoTagRow');
  if (row) row.style.display = n ? 'flex' : 'none';

  /* 单张 → 识图填进表单；多张 → 每张各自识别、各自入柜 */
  const one = $('#btnAutoTag');
  if (one) one.textContent = n > 1 ? '🔍 只识第 1 张，填进下面表单' : '🔍 识图填标签';
  const allBtn = $('#btnAutoTagAll');
  if (allBtn) {
    allBtn.style.display = n > 1 ? 'block' : 'none';
    allBtn.textContent = '✨ 一键识图并全部入柜（' + n + ' 张，各自打标签）';
  }

  const st = $('#autoTagStatus');
  if (st && !n) st.style.display = 'none';
}

/* ---------- AI 识图自动填标签 ----------
 * 把第一张待入库的图发给 nuo.ai.vision，让 AI 返回结构化 JSON：
 *   { category, name, tags: { 颜色:[...], 材质:[...], ... }, note, promptEn }
 * 然后自动选中对应标签（已有的点亮，没有的新建到对应维度），填充品类/名字/备注。
 * 全都是「预填」——用户可以改，保存前什么都没落盘。
 */
/* 拼一份给 AI 的识图提示词（单张衣物 → 结构化 JSON） */
function buildTagPrompt() {
  const groups = tagGroups();
  let existing = groups.map(g => {
    const all = g.preset.concat(g.custom);
    return g.group + '：' + (all.length ? all.join('、') : '暂无');
  }).join('\n');
  /* 标签池会越用越多，prompt 跟着无限变长也可能拖累识图成功率，这里做个上限 */
  if (existing.length > 1200) existing = existing.slice(0, 1200) + '…（更多已有标签省略）';

  return '你是衣橱管理助手。请仔细观察这张衣物照片，返回一个 JSON 对象（不要 markdown 代码块，只要纯 JSON），格式如下：\n'
    + '{\n'
    + '  "category": "从以下选一个：' + S.cats.join('、') + '",\n'
    + '  "name": "给这件衣服起一个简短的中文名",\n'
    + '  "tags": {\n'
    + '    "维度名": ["标签1", "标签2"]\n'
    + '  },\n'
    + '  "note": "一句话描述这件衣服的特点（可空）",\n'
    + '  "promptEn": "英文生图关键词，逗号分隔"\n'
    + '}\n\n'
    + '不要输出或创建品牌、渠道字段及标签。请判断季节和厚薄程度，不能确认时留空。\n'
    + '现有的维度和标签如下，请优先从已有标签里选，如果确实没有合适的才新建：\n'
    + existing + '\n\n'
    + '注意：tags 里的维度名必须和上面列出的维度名一致（如「颜色」「材质」），新建的标签也归到对应维度下。如果某件衣服属于一个全新的维度（比如面料上印了角色名），可以新建维度。';
}

/* 从 AI 返回的文本里抠出 JSON 对象；抠不出来抛错 */
function parseTagJson(text) {
  let json = String(text || '').replace(/```json\s*/gi, '').replace(/```\s*/g, '').trim();
  const m = json.match(/\{[\s\S]*\}/);
  if (m) json = m[0];
  return JSON.parse(json);
}

/* ---------- 单张识图：图片 → 结构化数据 ----------
 * 真正发出去的调用统一走 visionSafe（自动选可用路径 + 节流 + 错误分类），
 * 这里只负责拼 prompt、解析返回的 JSON。
 */
async function recognizeImage(rawDataUrl, quality, onWait) {
  if (!apiReady()) {
    /* 本地预览：给一份假数据，好让整条流程能跑通 */
    await sleep(600);
    const mock = [
      { category: '上装', name: '黑色蕾丝吊带', tags: { '颜色': ['深黑'], '材质': ['蕾丝'], '版型 / 细节': ['吊带', '微透'], '风格 / 场合': ['甜酷'] }, note: '薄款蕾丝面料，适合夏季内搭或单穿', promptEn: 'black lace camisole, sheer fabric, delicate straps' },
      { category: '下装', name: '粉色百褶短裙', tags: { '颜色': ['粉色'], '材质': ['雪纺'], '版型 / 细节': ['百褶'], '风格 / 场合': ['甜酷'] }, note: '高腰百褶，走动时很飘', promptEn: 'pastel pink pleated mini skirt, high waist' },
      { category: '连衣裙', name: '酒红丝缎吊带裙', tags: { '颜色': ['红黑撞色'], '材质': ['丝缎'], '版型 / 细节': ['吊带', '修身'], '风格 / 场合': ['约会'] }, note: '垂坠感很好的缎面长裙', promptEn: 'wine red satin slip dress, bias cut' }
    ];
    return { data: mock[Math.floor(Math.random() * mock.length)], route: 'mock' };
  }

  const r = await visionSafe(buildTagPrompt(), rawDataUrl, quality, null, onWait);
  let data;
  try { data = parseTagJson(r.text || ''); }
  catch (e) { throw new Error('AI 返回格式不对，请手动填写或再试一次'); }
  return { data: data, route: r.route };
}

/* 把识图结果里的标签并进标签池，返回 { tags, added, selected } */
function absorbTags(data) {
  const tags = [];
  let added = 0;
  if (data.tags && typeof data.tags === 'object') {
    Object.keys(data.tags).forEach(groupName => {
      if (removedTagGroup(groupName)) return;
      const tagList = data.tags[groupName];
      if (!Array.isArray(tagList)) return;
      tagList.forEach(tag => {
        tag = (tag || '').trim();
        if (!tag || removedTag(tag) || tags.indexOf(tag) >= 0) return;
        if (!groupOfTag(tag)) {
          const g = (groupName || '').trim() || MISC_GROUP;
          if (PRESET_GROUPS.indexOf(g) < 0 && !S.pool[g]) S.pool[g] = [];
          addToPool(tag, g);
          added++;
        }
        tags.push(tag);
      });
    });
  }
  return { tags: tags, added: added, selected: tags.length };
}

/* ---------- AI 识图自动填标签（单张，填进当前表单） ---------- */
async function autoTag() {
  if (!S.pending.length) return toast('先上传一张照片');
  const statusEl = $('#autoTagStatus');
  statusEl.style.display = 'block';
  statusEl.textContent = '正在识图…';
  const btn = $('#btnAutoTag');
  btn.disabled = true;

  try {
    const quality = AI.visionQuality || 'high';
    const qLabel = { auto: '标准', low: '节省', high: '高细节' };
    const busy = '正在让 AI 看图（' + (qLabel[quality] || quality) + '）…';
    statusEl.textContent = busy;

    /* 撞到平台频率闸门时告诉用户在等什么，别让界面看起来像卡死了 */
    const onWait = (sec, why) => {
      statusEl.textContent = why === 'hit'
        ? '⏳ 平台每分钟只让调 20 次，正在等 ' + sec + ' 秒后自动重试…（跟你 API 的余额无关）'
        : '⏳ 为了不撞平台的每分钟上限，正在排队（约 ' + sec + ' 秒）…';
    };

    const { data } = await recognizeImage(S.pending[0].full || S.pending[0].thumb, quality, onWait);
    statusEl.textContent = busy;

    if (data.category && S.cats.indexOf(data.category) >= 0) $('#fCat').value = data.category;
    if (data.name && !$('#fName').value.trim()) $('#fName').value = data.name;
    if (data.note && !$('#fNote').value.trim()) $('#fNote').value = data.note;
    if (data.promptEn && !$('#fPrompt').value.trim()) $('#fPrompt').value = data.promptEn;

    const r = absorbTags(data);
    r.tags.forEach(t => S.draft.add(t));

    drawTags();
    saveCfg();

    const parts = [];
    if (data.category) parts.push('品类→' + data.category);
    if (r.selected) parts.push('选中 ' + r.selected + ' 个标签');
    if (r.added) parts.push('新建 ' + r.added + ' 个');
    if (data.name) parts.push('名字→' + data.name);
    statusEl.textContent = '✅ ' + (parts.length ? parts.join('，') : '识别完成') + '。可以修改后再保存。';
  } catch (e) {
    console.error('autoTag', e);
    const msg = (e && e.message) || String(e);
    if (msg === 'noApi' || msg === 'noKey' || msg === 'noModel') {
      statusEl.innerHTML = '⚠️ 还没配好接口。<b>去「设置 → AI 接口配置」</b>填上 Base URL、Key 和模型。';
    } else if (msg === 'noVision') {
      statusEl.textContent = '⚠️ 这个模型不支持看图。去「设置 → 识图」单独指定一个带视觉的模型'
        + '（gpt-4o / gemini-2.0-flash / claude-3.5 / Qwen-VL 等都行）。';
    } else if (msg === 'netErr') {
      statusEl.textContent = '⚠️ 连不上接口。检查网络和 Base URL；'
        + '如果是浏览器直接打开 HTML，也可能是对方不允许跨域（CORS）。';
    } else {
      statusEl.textContent = '识图失败：' + humanErr(e)
        + (e.detail ? '（' + String(e.detail).slice(0, 120) + '）' : '');
    }
  } finally {
    btn.disabled = false;
  }
}

/* ---------- 批量识图入柜：每张图各自识别、各自打标签、各自入柜 ----------
 * 一次传 N 张衣服照片时，它们是 N 件不同的衣服，
 * 不能共用同一份名字和标签（旧版就是这么干的，等于 N 件一模一样的记录）。
 * 这里逐张调识图，每张单独建一条记录。
 * 中途某张失败不影响其它张：失败的那张仍然入柜，只是没有标签，留给你手动补。
 */
async function autoTagAll() {
  const n = S.pending.length;
  if (!n) return toast('先上传照片');
  if (n === 1) return autoTag();

  const statusEl = $('#autoTagStatus');
  statusEl.style.display = 'block';
  const btnOne = $('#btnAutoTag');
  const btnAll = $('#btnAutoTagAll');
  btnOne.disabled = true;
  btnAll.disabled = true;

  const quality = AI.visionQuality || 'high';
  /* 表单里已经填的内容作为兜底，所有衣服共享 */
  const fallbackCat = $('#fCat').value || '未分类';
  const manualTags = Array.from(S.draft);

  let done = 0, failed = 0, newTags = 0;
  /* 只有「配置本身不对」才停止后续识图（没配接口 / Key 错 / 模型不支持看图）——
   * 那种情况下后面每张都会同样失败，继续发只是白花钱。
   * 就算停了，停的也只是「识图」，剩下的照片照常无标签入柜，一张都不会丢。 */
  let stopReason = '';

  try {
    for (let i = 0; i < n; i++) {
      const im = S.pending[i];
      const head = '第 ' + (i + 1) + ' / ' + n + ' 张';
      if (!stopReason) {
        statusEl.textContent = '正在识别 ' + head + '…'
          + (failed ? '（已有 ' + failed + ' 张没认出来）' : '');
      } else {
        statusEl.textContent = '识图已停止，正在把剩下的照片直接入柜（' + head + '）…';
      }

      let data = null;
      if (!stopReason) {
        try {
          const r = await recognizeImage(im.full || im.thumb, quality);
          data = r.data;
        } catch (e) {
          console.warn('第 ' + (i + 1) + ' 张识图失败', e);
          failed++;
          const msg = (e && e.message) || String(e);
          /* 配置类错误：后面每张都会同样失败，没必要继续烧请求 */
          if (VISION_STOP.indexOf(msg) >= 0) {
            stopReason = msg;
            console.warn('识图整体不可用（' + msg + '），剩余 ' + (n - i - 1) + ' 张直接无标签入柜');
          } else if (msg === 'rateLimited') {
            /* 对方接口限速：等一会儿继续跑后面的，不整批放弃 */
            statusEl.textContent = '⏳ ' + head + ' 被接口限速挡住了，缓 20 秒再继续…';
            await sleep(20000);
          }
        }
      }

      let tags = manualTags.slice();
      if (data) {
        const r = absorbTags(data);
        newTags += r.added;
        r.tags.forEach(t => { if (tags.indexOf(t) < 0) tags.push(t); });
      }

      const it = {
        id: uid('it_'),
        createdAt: Date.now() + i,   // +i 保证批量入柜时顺序稳定
        isDeleted: false,
        thumb: im.thumb,
        w: im.w,
        h: im.h,
        name: (data && data.name) || '',
        note: (data && data.note) || '',
        promptEn: (data && data.promptEn) || '',
        category: (data && data.category && S.cats.indexOf(data.category) >= 0)
          ? data.category : fallbackCat,
        tags: tags
      };
      S.items.push(it);
      await saveMeta(it);
      await Store.set('im:' + it.id, im.full);
      done++;
    }

    await saveCfg();
    S.pending = [];
    S.editing = null;
    closeDw();
    drawGrid();
    drawStats();

    const msg = ['已收纳 ' + done + ' 件'];
    if (newTags) msg.push('新建 ' + newTags + ' 个标签');
    if (stopReason === 'noVision') msg.push('这个模型不支持看图，剩下的已无标签入柜');
    else if (stopReason) msg.push('识图中断（' + humanErr({ message: stopReason }) + '），剩下的已无标签入柜');
    else if (failed) msg.push(failed + ' 张没认出来，已无标签入柜，回头可以手动补或重新识');
    toast(msg.join('，'), { duration: (failed || stopReason) ? 6000 : 4000 });
    /* 配置类失败：直接把设置页推给用户，别让人干瞪眼 */
    if (stopReason === 'noApi' || stopReason === 'noKey' || stopReason === 'noModel' || stopReason === 'noVision') {
      go('set');
      const fo = $('#foldApi'); if (fo) fo.open = true;
    }
  } catch (e) {
    console.error('autoTagAll', e);
    statusEl.textContent = '批量识图中断：' + humanErr(e) + '（已入柜 ' + done + ' 件）';
    if (done) { drawGrid(); drawStats(); }
  } finally {
    btnOne.disabled = false;
    btnAll.disabled = false;
  }
}

/* ------------------------- 5. 渲染：分类 / 瀑布流 ------------------------- */
function drawCats() {
  const box = $('#cats');
  box.innerHTML = '';
  const mk = (label, key) => {
    const b = document.createElement('button');
    b.className = 'cat' + (S.cat === key ? ' on' : '');
    b.textContent = label;
    b.onclick = () => { S.cat = key; drawCats(); drawGrid(); };
    return b;
  };
  box.appendChild(mk('全部', '__all__'));
  S.cats.forEach(c => box.appendChild(mk(c, c)));
  const p = document.createElement('button');
  p.className = 'cat';
  p.textContent = '＋ 分类';
  p.onclick = openCats;
  box.appendChild(p);
}

function hit(it, kw) {
  if (!kw) return true;
  const hay = [it.name, it.note, it.category, it.promptEn, (it.tags || []).join(' ')]
    .filter(Boolean).join(' ').toLowerCase();
  return hay.indexOf(kw.toLowerCase()) >= 0;
}
const live = () => S.items.filter(i => !i.isDeleted);
function shown() {
  return live()
    .filter(i => S.cat === '__all__' || i.category === S.cat)
    .filter(i => hit(i, S.kw))
    .sort((a, b) => b.createdAt - a.createdAt);
}

function drawGrid() {
  const grid = $('#grid');
  const list = shown();
  grid.innerHTML = '';

  if (!list.length) {
    grid.style.display = 'none';
    $('#emptyBox').style.display = 'flex';
    if (S.kw) {
      $('#emptyH').textContent = '没有找到「' + S.kw + '」';
      $('#emptyP').innerHTML = '换个词试试，比如颜色、材质或季节<br>标签打得越细，翻衣柜越快';
    } else {
      $('#emptyH').textContent = '衣柜这层还是空的';
      $('#emptyP').innerHTML = '去挂上你的第一套战袍吧<br>入库自动等比压缩，不拉伸、不占内存';
    }
    return;
  }
  grid.style.display = 'block';
  $('#emptyBox').style.display = 'none';

  list.forEach(it => {
    const card = document.createElement('div');
    card.className = 'item' + (S.picked.has(it.id) ? ' on' : '');

    const ph = document.createElement('div');
    ph.className = 'ph';
    ph.style.aspectRatio = (it.w && it.h) ? (it.w + ' / ' + it.h) : '3 / 4';
    if (it.thumb) {
      const img = document.createElement('img');
      img.src = it.thumb;
      img.alt = it.name || '';
      ph.appendChild(img);
    } else {
      const sp = document.createElement('span');
      sp.textContent = '👗';
      ph.appendChild(sp);
    }
    card.appendChild(ph);

    if (it.name || (it.tags && it.tags.length)) {
      const m = document.createElement('div');
      m.className = 'meta';
      const nm = document.createElement('div');
      nm.className = 'nm';
      nm.textContent = it.name || '未命名单品';
      m.appendChild(nm);
      if (it.tags && it.tags.length) {
        const tl = document.createElement('div');
        tl.className = 'tagline';
        it.tags.slice(0, 3).forEach(t => {
          const c = document.createElement('span');
          c.className = 'mini';
          c.textContent = t;
          tl.appendChild(c);
        });
        m.appendChild(tl);
      }
      card.appendChild(m);
    }

    const dot = document.createElement('div');
    dot.className = 'dot';
    dot.textContent = S.picked.has(it.id) ? '✓' : '';
    card.appendChild(dot);

    const tb = document.createElement('div');
    tb.className = 'trashbtn';
    tb.textContent = '🗑';
    tb.onclick = (e) => { e.stopPropagation(); softDel([it.id]); };
    card.appendChild(tb);

    gestures(card, it);
    grid.appendChild(card);
  });
}

/* 长按 600ms 抖动进多选；轻点放大 */
function gestures(card, it) {
  let timer = null, longed = false;
  const start = () => {
    longed = false;
    timer = setTimeout(() => {
      longed = true;
      card.classList.add('shake', 'armed');
      setTimeout(() => card.classList.remove('shake'), 340);
      Bridge.vibrate(18);
      enterPick(it.id);
    }, 600);
  };
  const cancel = () => { if (timer) clearTimeout(timer); };
  card.addEventListener('pointerdown', start);
  card.addEventListener('pointerup', cancel);
  card.addEventListener('pointerleave', cancel);
  card.addEventListener('pointercancel', cancel);
  card.addEventListener('contextmenu', e => e.preventDefault());
  card.addEventListener('click', () => {
    if (longed) { longed = false; return; }
    if (S.pickMode) return togglePick(it.id);
    openLb(it.id);
  });
}

/* ---------- 选衣服抽屉（试衣间直接勾选，不用回衣橱长按） ---------- */
const PICK_MAX = 20;
const PickDrawer = {
  kw: '',
  cat: '__all__',

  open() {
    this.kw = '';
    this.cat = '__all__';
    $('#pickSearch').value = '';
    this.drawCats();
    this.drawGrid();
    this.updateCount();
    closeDw();
    openDw('#dwPick');
  },

  updateCount() {
    $('#pickDrawerCount').textContent = S.picked.size + ' / ' + PICK_MAX;
  },

  drawCats() {
    const box = $('#pickCats');
    box.innerHTML = '';
    const mk = (label, key) => {
      const b = document.createElement('button');
      b.className = 'cat' + (this.cat === key ? ' on' : '');
      b.textContent = label;
      b.onclick = () => { this.cat = key; this.drawCats(); this.drawGrid(); };
      return b;
    };
    box.appendChild(mk('全部', '__all__'));
    S.cats.forEach(c => box.appendChild(mk(c, c)));
  },

  drawGrid() {
    const box = $('#pickGrid');
    box.innerHTML = '';
    const grid = document.createElement('div');
    grid.className = 'pick-grid';

    const kw = this.kw.toLowerCase();
    const list = live()
      .filter(i => this.cat === '__all__' || i.category === this.cat)
      .filter(i => !kw || hit(i, kw))
      .sort((a, b) => b.createdAt - a.createdAt);

    if (!list.length) {
      box.innerHTML = '<div class="hint" style="text-align:center;margin:20px 0">没有衣服</div>';
      return;
    }

    list.forEach(it => {
      const cell = document.createElement('div');
      const isOn = S.picked.has(it.id);
      const full = S.picked.size >= PICK_MAX && !isOn;
      cell.className = 'pick-cell' + (isOn ? ' on' : '') + (full ? ' disabled' : '');

      if (it.thumb) {
        const img = document.createElement('img');
        img.src = it.thumb;
        img.alt = it.name || '';
        cell.appendChild(img);
      } else {
        const ph = document.createElement('div');
        ph.style.cssText = 'width:100%;aspect-ratio:3/4;background:#15151a;display:flex;align-items:center;justify-content:center;font-size:22px;opacity:.25';
        ph.textContent = '👗';
        cell.appendChild(ph);
      }

      const name = document.createElement('div');
      name.className = 'pc-name';
      name.textContent = it.name || it.category || '未命名';
      cell.appendChild(name);

      const check = document.createElement('div');
      check.className = 'pc-check';
      check.textContent = isOn ? '✓' : '';
      cell.appendChild(check);

      cell.onclick = () => {
        if (S.picked.has(it.id)) {
          S.picked.delete(it.id);
        } else {
          if (S.picked.size >= PICK_MAX) {
            toast('最多选 ' + PICK_MAX + ' 件');
            return;
          }
          S.picked.add(it.id);
        }
        this.drawGrid();
        this.updateCount();
      };

      grid.appendChild(cell);
    });
    box.appendChild(grid);
  }
};

function enterPick(id) {
  S.pickMode = true;
  document.body.classList.add('pickmode');
  if (id) S.picked.add(id);
  drawGrid(); drawPickInfo();
}
function exitPick() {
  S.pickMode = false;
  document.body.classList.remove('pickmode');
  $$('.item').forEach(c => c.classList.remove('armed'));
  drawGrid();
}
function togglePick(id) {
  if (S.picked.has(id)) S.picked.delete(id); else S.picked.add(id);
  drawGrid(); drawPickInfo();
}

/* ------------------------- 6. 增删改 ------------------------- */
async function saveMeta(it) { await Store.set('it:' + it.id, enc(cleanItemTags(it, S.pool))); }

async function softDel(ids) {
  const hit = [];
  for (const id of ids) {
    const it = S.items.find(x => x.id === id);
    if (!it || it.isDeleted) continue;
    it.isDeleted = true;
    it.deletedAt = Date.now();
    hit.push(it);
    await saveMeta(it);
  }
  if (!hit.length) return;
  exitPick(); drawGrid(); drawStats();
  toast('已移入回收站 ' + hit.length + ' 件', {
    undo: async () => {
      for (const it of hit) {
        it.isDeleted = false;
        delete it.deletedAt;
        await saveMeta(it);
      }
      drawGrid(); drawStats();
      toast('已还原 ' + hit.length + ' 件');
    }
  });
}

async function restore(id) {
  const it = S.items.find(x => x.id === id);
  if (!it) return;
  it.isDeleted = false;
  delete it.deletedAt;
  await saveMeta(it);
  drawTrash(); drawGrid(); drawStats();
  toast('已放回衣柜');
}

async function hardDel(id) {
  await Store.remove('it:' + id);
  await Store.remove('im:' + id);
  S.items = S.items.filter(x => x.id !== id);
  drawTrash(); drawGrid(); drawStats();
  toast('已彻底删除');
}

/* ------------------------- 7. 抽屉 ------------------------- */
function openDw(sel) { $('#mask').classList.add('open'); $(sel).classList.add('open'); }
function closeDw() { $('#mask').classList.remove('open'); $$('.drawer').forEach(d => d.classList.remove('open')); }

function drawCatSelect() {
  const sel = $('#fCat');
  sel.innerHTML = '';
  S.cats.forEach(c => {
    const o = document.createElement('option');
    o.value = c; o.textContent = c;
    sel.appendChild(o);
  });
}

/* 记录哪一栏正展开着输入框，重绘后保持展开 */
let openTagInput = null;

function drawTags() {
  const box = $('#tagBox');
  box.innerHTML = '';

  tagGroups().forEach(g => {
    const w = document.createElement('div');
    w.className = 'tg';

    const head = document.createElement('div');
    head.className = 'gn';
    const label = document.createElement('span');
    label.textContent = g.group;
    head.appendChild(label);
    /* 用户自建的维度可以删（里面的标签一并移除，已打在衣服上的不受影响） */
    if (g.userMade) {
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'gn-del';
      del.textContent = '删除该栏';
      del.onclick = () => removeTagGroup(g.group);
      head.appendChild(del);
    }
    w.appendChild(head);

    const cs = document.createElement('div');
    cs.className = 'chips';

    const mk = (t, custom) => {
      const c = document.createElement('span');
      c.className = 'chip' + (S.draft.has(t) ? ' on' : '') + (custom ? ' mine' : '');
      c.textContent = t;
      c.onclick = () => {
        if (S.draft.has(t)) S.draft.delete(t); else S.draft.add(t);
        drawTags();
      };
      /* 自定义标签长按可从池里删掉，避免手滑打错的词永久留着 */
      if (custom) {
        let timer = null;
        const start = () => { timer = setTimeout(() => removePoolTag(g.group, t), 650); };
        const cancel = () => { if (timer) clearTimeout(timer); };
        c.addEventListener('pointerdown', start);
        c.addEventListener('pointerup', cancel);
        c.addEventListener('pointerleave', cancel);
        c.addEventListener('pointercancel', cancel);
        c.title = '长按可从标签池移除';
      }
      return c;
    };

    g.preset.forEach(t => cs.appendChild(mk(t, false)));
    g.custom.forEach(t => cs.appendChild(mk(t, true)));

    /* 每一栏自己的「＋」：点开就地输入，新标签直接归到这一栏 */
    const add = document.createElement('button');
    add.type = 'button';
    add.className = 'chip add';
    add.textContent = '＋';
    add.title = '往「' + g.group + '」加标签';
    add.onclick = () => {
      openTagInput = (openTagInput === g.group) ? null : g.group;
      drawTags();
    };
    cs.appendChild(add);
    w.appendChild(cs);

    if (openTagInput === g.group) {
      const row = document.createElement('div');
      row.className = 'tg-input';
      const ipt = document.createElement('input');
      ipt.type = 'text';
      ipt.placeholder = '新的「' + g.group + '」标签，回车确认';
      ipt.maxLength = 20;
      const commit = () => {
        const v = ipt.value.trim();
        if (!v) { openTagInput = null; drawTags(); return; }
        const existing = groupOfTag(v);
        if (existing && existing !== g.group) {
          toast('「' + v + '」已经在「' + existing + '」里了，直接点亮它就行');
          return;
        }
        S.draft.add(v);
        addToPool(v, g.group);
        saveCfg();
        ipt.value = '';
        drawTags();
        /* 连续录入：重绘后把焦点还给输入框 */
        const next = $('#tagBox .tg-input input');
        if (next) next.focus();
      };
      ipt.addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); commit(); }
        else if (e.key === 'Escape') { openTagInput = null; drawTags(); }
      });
      const ok = document.createElement('button');
      ok.type = 'button';
      ok.className = 'tg-ok';
      ok.textContent = '加入';
      ok.onclick = commit;
      row.appendChild(ipt);
      row.appendChild(ok);
      w.appendChild(row);
    }

    box.appendChild(w);
  });

  /* 末尾：新建一个自定义维度 */
  const more = document.createElement('div');
  more.className = 'tg';
  const nb = document.createElement('button');
  nb.type = 'button';
  nb.className = 'chip add wide';
  nb.textContent = '＋ 新建一栏维度';
  nb.onclick = newTagGroup;
  more.appendChild(nb);
  box.appendChild(more);
}

async function newTagGroup() {
  const r = window.prompt('新维度叫什么？\n例如：季节 / 洗护 / 角色绑定', '');
  if (r === null) return;
  const g = r.trim();
  if (!g || removedTagGroup(g)) return;
  if (PRESET_GROUPS.indexOf(g) >= 0 || S.pool[g]) return toast('这一栏已经有了');
  S.pool[g] = [];
  openTagInput = g;
  await saveCfg();
  drawTags();
  const ipt = $('#tagBox .tg-input input');
  if (ipt) ipt.focus();
}

async function removeTagGroup(group) {
  if (!S.pool[group]) return;
  const n = S.pool[group].length;
  const backup = S.pool[group].slice();
  delete S.pool[group];
  if (openTagInput === group) openTagInput = null;
  await saveCfg();
  drawTags();
  toast('已删除「' + group + '」栏' + (n ? '（' + n + ' 个标签）' : '') + '，衣服上已打的标签不受影响', {
    undo: async () => {
      S.pool[group] = backup;
      await saveCfg();
      drawTags();
      toast('已恢复「' + group + '」栏');
    }
  });
}

async function removePoolTag(group, tag) {
  if (!S.pool[group]) return;
  const i = S.pool[group].indexOf(tag);
  if (i < 0) return;
  S.pool[group].splice(i, 1);
  if (!S.pool[group].length) delete S.pool[group];
  await saveCfg();
  drawTags();
  toast('已把「' + tag + '」从标签池移除', {
    undo: async () => {
      addToPool(tag, group);
      await saveCfg();
      drawTags();
      toast('已放回「' + tag + '」');
    }
  });
}

function openItem(id) {
  S.editing = id || null;
  S.pending = [];
  S.draft = new Set();
  openTagInput = null;
  drawCatSelect();
  if (id) {
    const it = S.items.find(x => x.id === id);
    $('#itemTitle').textContent = '编辑单品';
    $('#fName').value = it.name || '';
    $('#fNote').value = it.note || '';
    $('#fPrompt').value = it.promptEn || '';
    $('#fCat').value = S.cats.indexOf(it.category) >= 0 ? it.category : '未分类';
    (it.tags || []).forEach(t => S.draft.add(t));
  } else {
    $('#itemTitle').textContent = '收纳新衣物';
    $('#fName').value = '';
    $('#fNote').value = '';
    $('#fPrompt').value = '';
    $('#fCat').value = S.cat !== '__all__' ? S.cat : S.cats[0];
  }
  drawTags(); drawPvs();
  closeDw(); openDw('#dwItem');
}

async function saveItem() {
  const base = {
    name: $('#fName').value.trim(),
    note: $('#fNote').value.trim(),
    promptEn: $('#fPrompt').value.trim(),
    category: $('#fCat').value || '未分类',
    tags: Array.from(S.draft)
  };

  if (S.editing) {
    const it = S.items.find(x => x.id === S.editing);
    Object.assign(it, base);
    if (S.pending.length) {
      const im = S.pending[0];
      it.thumb = im.thumb; it.w = im.w; it.h = im.h;
      await Store.set('im:' + it.id, im.full);
    }
    await saveMeta(it);
    toast('已更新');
  } else {
    const imgs = S.pending.length ? S.pending : [null];
    for (const im of imgs) {
      const it = Object.assign({
        id: uid('it_'),
        createdAt: Date.now(),
        isDeleted: false,
        thumb: im ? im.thumb : '',
        w: im ? im.w : 0,
        h: im ? im.h : 0
      }, base);
      S.items.push(it);
      await saveMeta(it);
      if (im) await Store.set('im:' + it.id, im.full);
    }
    toast('已收纳 ' + imgs.length + ' 件');
  }

  /* 用户在抽屉里手打的标签已在提交时归好栏；这里兜底收录来源不明的（如导入的衣服） */
  base.tags.forEach(t => { if (!groupOfTag(t)) addToPool(t, MISC_GROUP); });
  await saveCfg();

  S.pending = []; S.editing = null;
  closeDw(); drawGrid(); drawStats();
}

/* ------------------------- 8. 分类 ------------------------- */
async function saveCfg() {
  await Store.set('cfg', enc({
    cats: S.cats,
    pool: S.pool,
    charId: S.charId,
    fitMode: fitMode(),
    visionCount: visionCount()
  }));
}

function drawCatList() {
  const box = $('#catList');
  box.innerHTML = '';
  S.cats.forEach(c => {
    const n = live().filter(i => i.category === c).length;
    const row = document.createElement('div');
    row.className = 'lrow';
    const nm = document.createElement('div');
    nm.className = 'nm';
    nm.textContent = c;
    row.appendChild(nm);
    const ct = document.createElement('span');
    ct.className = 'ct';
    ct.textContent = n + ' 件';
    row.appendChild(ct);
    const r = document.createElement('button');
    r.textContent = '改名';
    r.onclick = () => renameCat(c);
    row.appendChild(r);
    if (c !== '未分类') {
      const d = document.createElement('button');
      d.className = 'd';
      d.textContent = '删除';
      d.onclick = () => delCat(c);
      row.appendChild(d);
    }
    box.appendChild(row);
  });
}

async function flushCats() {
  await saveCfg();
  drawCats(); drawCatList(); drawCatSelect(); drawStats();
}
async function addCat() {
  const n = $('#newCat').value.trim();
  if (!n) return toast('分类名还没填');
  if (S.cats.indexOf(n) >= 0) return toast('这个分类已经有了');
  S.cats.splice(Math.max(0, S.cats.length - 1), 0, n);
  $('#newCat').value = '';
  await flushCats();
  toast('已新建分类「' + n + '」');
}
async function renameCat(old) {
  const r = window.prompt('把「' + old + '」改成：', old);
  if (r === null) return;
  const n = r.trim();
  if (!n || n === old) return;
  if (S.cats.indexOf(n) >= 0) return toast('已存在同名分类');
  S.cats = S.cats.map(c => c === old ? n : c);
  for (const it of S.items) {
    if (it.category === old) { it.category = n; await saveMeta(it); }
  }
  if (S.cat === old) S.cat = n;
  await flushCats(); drawGrid();
  toast('已改名为「' + n + '」');
}
async function delCat(name) {
  const moved = S.items.filter(i => i.category === name);
  S.cats = S.cats.filter(c => c !== name);
  for (const it of moved) { it.category = '未分类'; await saveMeta(it); }
  if (S.cat === name) S.cat = '__all__';
  await flushCats(); drawGrid();
  toast(moved.length ? '分类已删，' + moved.length + ' 件已迁到「未分类」' : '分类已删除');
}
function openCats() { drawCatList(); closeDw(); openDw('#dwCat'); }

/* ------------------------- 9. 回收站 ------------------------- */
function drawTrash() {
  const box = $('#trashList');
  const list = S.items.filter(i => i.isDeleted).sort((a, b) => (b.deletedAt || 0) - (a.deletedAt || 0));
  box.innerHTML = '';
  if (!list.length) {
    const p = document.createElement('div');
    p.className = 'hint';
    p.style.margin = '0';
    p.textContent = '回收站是空的，你还没舍弃过任何一件。';
    box.appendChild(p);
    return;
  }
  list.forEach(it => {
    const row = document.createElement('div');
    row.className = 'lrow';
    if (it.thumb) {
      const img = document.createElement('img');
      img.src = it.thumb;
      row.appendChild(img);
    }
    const nm = document.createElement('div');
    nm.className = 'nm';
    nm.textContent = it.name || '未命名单品';
    row.appendChild(nm);
    const r = document.createElement('button');
    r.textContent = '还原';
    r.onclick = () => restore(it.id);
    row.appendChild(r);
    const d = document.createElement('button');
    d.className = 'd';
    d.textContent = '删除';
    d.onclick = () => hardDel(it.id);
    row.appendChild(d);
    box.appendChild(row);
  });
}

async function purge() {
  const list = S.items.filter(i => i.isDeleted);
  if (!list.length) return toast('回收站已经是空的');
  for (const it of list) {
    await Store.remove('it:' + it.id);
    await Store.remove('im:' + it.id);
  }
  S.items = S.items.filter(i => !i.isDeleted);
  drawTrash(); drawGrid(); drawStats();
  toast('已彻底清空 ' + list.length + ' 件');
}

/* ------------------------- 10. 大图预览 ------------------------- */
async function openLb(id) {
  const it = S.items.find(x => x.id === id);
  if (!it) return;
  const full = await Store.get('im:' + id);
  $('#lbImg').src = full || it.thumb || '';
  const info = $('#lbInfo');
  info.innerHTML = '';
  const b = document.createElement('b');
  b.textContent = it.name || '未命名单品';
  info.appendChild(b);
  const line = [it.category, (it.tags || []).join(' · '), it.note].filter(Boolean).join('　|　');
  info.appendChild(document.createTextNode(line));
  $('#lbEdit').onclick = () => { closeLb(); openItem(id); };
  $('#lb').classList.add('open');
}
function closeLb() { $('#lb').classList.remove('open'); $('#lbImg').src = ''; }

/* ------------------------- 11. 灵感试衣间 ------------------------- */
async function drawChars() {
  const row = $('#charRow');
  row.innerHTML = '';
  S.chars = await Bridge.roster();
  S.chars.forEach(c => {
    const id = String((c && (c.id != null ? c.id : c.charId)) || '');
    const name = (c && (c.name || c.title)) || ('角色 ' + id);
    const el = document.createElement('div');
    el.className = 'charchip' + (S.charId === id ? ' on' : '');
    el.textContent = name;
    el.onclick = async () => {
      if (roleSwitchBlocked()) return;
      Chat.switching = true;
      try {
        S.charId = id; S.charName = name;
        Roles.activeId = id;
        await Chat.open(id);
        await Roles.save();
        await saveCfg();
        chatView = 'list';
        await drawChars();
        $('#roleState').textContent = name;
      } finally { Chat.switching = false; }
    };
    row.appendChild(el);
  });
  if (!(Roles.list || []).length) {
    const t = document.createElement('div');
    t.className = 'charchip';
    t.style.borderStyle = 'dashed';
    t.style.color = '#6d6d72';
    t.textContent = '还没建角色，去「设置 → 角色」建一位';
    row.appendChild(t);
  }
  if (S.charId) {
    const c = S.chars.find(x => String(x.id != null ? x.id : x.charId) === S.charId);
    S.charName = (c && (c.name || c.title)) || S.charName;
    $('#roleState').textContent = S.charName || '已选';
  }
}

function drawPickInfo() {
  $('#pickCount').textContent = S.picked.size + ' 件';
  const box = $('#pickThumbs');
  box.innerHTML = '';
  S.items.filter(i => S.picked.has(i.id)).forEach(it => {
    if (!it.thumb) return;
    const img = document.createElement('img');
    img.src = it.thumb;
    img.alt = it.name || '';
    box.appendChild(img);
  });
  syncModeUI();
  /* 自己搭模式下更新提示 */
  try {
    if ($('#modeSelf') && $('#modeSelf').checked) {
      const n = S.picked.size;
      $('#selfHint').textContent = n
        ? '已选 ' + n + ' 件。可以直接存进搭配册，也可以让角色点评一下。'
        : '还没选衣服，回衣橱长按选几件，或点上面的随机抽卡。';
    }
  } catch (e) {}
}

function describe(it) {
  const bits = [];
  bits.push('id=' + it.id);
  bits.push(it.name || '未命名');
  if (it.category) bits.push('品类:' + it.category);
  if (it.tags && it.tags.length) bits.push('标签:' + it.tags.join('/'));
  if (it.note) bits.push('备注:' + it.note);
  return '- ' + bits.join('，');
}

/* ---------- 搭配模式 ----------
 * 一套完整的搭配可能有：内搭、衬衫、外套、裤子、衬裙、袜子、鞋、戒指、发饰、腰带、项链、耳饰…
 * 所以识图张数放开到和选衣服上限一样（20），不再卡在 8。
 * 选得越多、看的图越多，AI 的点评就越具体。 */
const VISION_MIN = 1;
const VISION_MAX = 20;

function fitMode() {
  return $('#modeVision').checked ? 'vision' : 'text';
}

/* 读取用户填的张数：允许空着，越界自动收敛到 1~20 */
function visionCount() {
  const el = $('#visionCount');
  let n = parseInt(el.value, 10);
  if (!isFinite(n)) n = 6;
  n = Math.max(VISION_MIN, Math.min(VISION_MAX, n));
  return n;
}

function syncModeUI() {
  const vision = fitMode() === 'vision';
  $('#modeRowText').classList.toggle('on', !vision);
  $('#modeRowVision').classList.toggle('on', vision);
  $('#visionOpt').classList.toggle('on', vision);

  const withImg = S.items.filter(i => S.picked.has(i.id) && !i.isDeleted && i.thumb).length;
  const n = visionCount();
  const real = Math.min(n, withImg);
  $('#visionMinus').disabled = n <= VISION_MIN;
  $('#visionPlus').disabled = n >= VISION_MAX;

  const tip = $('#visionTip');
  if (!withImg) {
    tip.textContent = '张 · 选中的衣服里还没有带照片的，会自动只按文本搭';
  } else if (n > withImg) {
    tip.textContent = '张 · 选中的只有 ' + withImg + ' 张带照片，实际看 ' + real + ' 张';
  } else {
    tip.textContent = '张 · 实际看 ' + real + ' 张，其余按文本信息搭';
  }
}

function stepVision(d) {
  const el = $('#visionCount');
  el.value = Math.max(VISION_MIN, Math.min(VISION_MAX, visionCount() + d));
  syncModeUI();
}

async function askChar() {
  const chosen = S.items.filter(i => S.picked.has(i.id) && !i.isDeleted);
  if (!chosen.length) return toast('先去衣橱长按选几件衣服');
  if (!S.charId) return toast('先挑一位角色');

  const btn = $('#btnAsk');
  btn.disabled = true;
  const mode = fitMode();
  const t = toast('正在请 ' + (S.charName || '他') + ' 过目…', { loading: true });

  try {
    let visionNote = '';
    let looked = 0;

    if (mode === 'vision') {
      const withImg = chosen.filter(i => i.thumb).slice(0, visionCount());
      if (!withImg.length) {
        t.update('选中的衣服都没有照片，改为按文本搭配…');
      }
      for (let i = 0; i < withImg.length; i++) {
        t.update('正在看第 ' + (i + 1) + '/' + withImg.length + ' 张图…');
        const full = await Store.get('im:' + withImg[i].id);
        try {
          const r = await visionSafe('用一句话客观描述这件衣服的颜色、材质观感和版型细节。',
            full || withImg[i].thumb, 'auto');
          if (r && r.text) {
            visionNote += '\n（' + (withImg[i].name || withImg[i].id) + '看起来）' + r.text;
            looked++;
          }
        } catch (e) {
          console.warn('识图失败，跳过这张', e);
          /* 单张失败不影响整体：剩下的仍按文本信息搭 */
          const msg = (e && e.message) || String(e);
          if (VISION_STOP.indexOf(msg) >= 0) {
            /* 配置问题，后面每张都一样会失败 → 直接转纯文本搭配 */
            t.update('识图用不了（' + humanErr(e) + '），改为按标签和备注搭配…');
            await sleep(1200);
            break;
          }
          if (msg === 'rateLimited') {
            /* 被限速：已看过的照样算，剩下的不硬等 */
            t.update('接口限速，已看 ' + looked + ' 张，剩下的按标签搭…');
            await sleep(1200);
            break;
          }
        }
      }
      t.update('正在组织点评…');
    }

    const sys = '你是用户的私人穿搭顾问。用户会给你她衣橱里的几件衣服，'
      + '请你挑出其中能搭在一起的，给出一套搭配方案和你自己的点评。\n'
      + (visionNote
          ? '其中部分单品附有视觉观察，请优先采信视觉观察；没有视觉观察的按文本信息判断。\n'
          : '你看不到照片，请完全依据名字、品类、标签和备注来判断颜色、材质与风格。\n')
      + '严格按下面三段输出，不要加别的小标题：\n'
      + '【搭配】一两句话说清这套怎么穿（点名用到哪几件）\n'
      + '【点评】三到五句你自己的审美和感受，保持你的说话方式\n'
      + '【英文提示词】一行英文，逗号分隔的生图关键词，描述人穿着这套衣服的画面';

    const user = '这是我衣橱里的衣服：\n'
      + chosen.map(describe).join('\n')
      + (visionNote ? '\n\n补充的视觉观察：' + visionNote : '')
      + '\n\n帮我搭一套。';

    const text = await Bridge.chat(
      [{ role: 'system', content: sys }, { role: 'user', content: user }],
      S.charId
    );

    const promptEn = pickSection(text, '英文提示词') || buildPromptEn(chosen);
    S.lastVerdict = {
      comment: text,
      promptEn: promptEn,
      itemIds: chosen.map(i => i.id),
      charId: S.charId,
      charName: S.charName,
      genImage: '',
      mode: mode,
      looked: looked
    };
    $('#verdict').textContent = text || '（没有拿到内容，再试一次）';
    $('#genBox').innerHTML = '';
    t.close();
    toast(looked ? '点评来了（看了 ' + looked + ' 张图）' : '点评来了（按文本信息搭的）');
  } catch (e) {
    t.close();
    $('#verdict').textContent = humanErr(e);
    toast(humanErr(e), { duration: 4000 });
  } finally {
    btn.disabled = false;
  }
}

function pickSection(text, name) {
  if (!text) return '';
  const re = new RegExp('【' + name + '】([\\s\\S]*?)(?:\\n【|$)');
  const m = text.match(re);
  return m ? m[1].trim() : '';
}
function buildPromptEn(items) {
  const parts = [];
  items.forEach(i => { if (i.promptEn) parts.push(i.promptEn.trim()); });
  return Array.from(new Set(parts)).join(', ');
}

async function genImage() {
  if (!S.lastVerdict) return toast('先让他点评一套');
  const prompt = S.lastVerdict.promptEn;
  if (!prompt) return toast('没有可用的英文提示词');
  const t = toast('正在画返图…', { loading: true });
  try {
    const url = await Bridge.genImage(prompt + ', full body fashion photo, soft studio light');
    t.close();
    if (!url) return toast('没拿到图。你配的接口可能没开生图（/images/generations）');
    S.lastVerdict.genImage = url;
    const box = $('#genBox');
    box.innerHTML = '';
    const img = document.createElement('img');
    img.src = url;
    box.appendChild(img);
    const b = document.createElement('button');
    b.className = 'btn gh sm';
    b.style.marginTop = '8px';
    b.textContent = '保存到相册';
    b.onclick = () => Bridge.savePhoto(url, 'look.png').then(() => toast('已交给系统保存'));
    box.appendChild(b);
    toast('返图画好了');
  } catch (e) {
    t.close();
    toast(humanErr(e), { duration: 4000 });
  }
}

/* 卡片格式与 feed.publish 的 card 完全一致，两处共用同一个函数 */
async function buildLookCard(v) {
  const items = S.items.filter(i => v.itemIds.indexOf(i.id) >= 0);
  const blocks = [];

  let img = v.genImage;
  if (!img && items.length) {
    const full = await Store.get('im:' + items[0].id);
    img = await toCardImage(full || items[0].thumb);
  } else if (img) {
    img = await toCardImage(img);
  }
  if (img) blocks.push({ type: 'image', src: img, ratio: '3 / 4' });

  const plan = pickSection(v.comment, '搭配');
  const say = pickSection(v.comment, '点评') || v.comment;
  /* 起了名字就用名字当大标题，套装名比方案描述更像「这一套」的身份 */
  if (v.name) blocks.push({ type: 'heading', text: cut(v.name, 60) });
  if (plan) blocks.push({ type: 'heading', text: cut(plan, 60), size: 'sm' });
  if (say) blocks.push({ type: 'text', text: cut(say, 600), size: 'sm', clamp: 6 });
  const tags = [];
  items.forEach(i => (i.tags || []).forEach(t => { if (tags.indexOf(t) < 0 && tags.length < 12) tags.push(t); }));
  if (tags.length) blocks.push({ type: 'tags', items: tags });

  return {
    title: cut(v.name || plan || '今日穿搭', 60),
    footer: '🖤 私享衣橱',
    layout: 'poster',
    theme: {
      background: '#101014',
      color: '#f5f5f7',
      labelColor: '#8e8e93',
      borderColor: 'rgba(255,117,151,.25)',
      accent: '#ff7597',
      radius: 18,
      width: 250,
      font: 'rounded',
      hideHeader: true,
      divider: false,
      scrim: 0.25
    },
    blocks: blocks.slice(0, 24)
  };
}

async function sendToChat() {
  if (!S.lastVerdict) return toast('先让他点评一套');
  const v = S.lastVerdict;
  const t = toast('正在发送…', { loading: true });
  try {
    /* 组装格式化文字 */
    const plan = pickSection(v.comment, '搭配') || '';
    const say = pickSection(v.comment, '点评') || v.comment || '';
    const items = S.items.filter(i => (v.itemIds || []).indexOf(i.id) >= 0 && !i.isDeleted);
    const names = items.map(i => i.name || i.category || '单品').join(' + ');
    const lines = [];
    if (v.name) lines.push('━━━ ' + v.name + ' ━━━');
    if (plan) lines.push('👗 ' + plan);
    if (say) lines.push('💬 ' + say);
    if (names) lines.push('🏷️ ' + names);
    if (v.promptEn) lines.push('✨ ' + v.promptEn);
    lines.push('── 来自「私享衣橱」──');
    const text = lines.join('\n');

    /* PWA 版：直接写进本机的聊天记录，不依赖任何平台接口 */
    const rid = S.charId || Roles.activeId;
    if (!rid) { t.close(); return toast('还没建角色，去「设置 → 角色」建一位'); }

    await Chat.pushLook(rid, v, text);
    t.close();
    const r = Roles.byId(rid);
    toast('已发到' + ((r && r.name) || '他') + '的聊天里', {
      action: '去看看', onAction: async () => { go('chat'); await openRoom(rid); }
    });
  } catch (e) {
    t.close();
    toast(humanErr(e), { duration: 4000 });
  }
}

/* ------------------------- 12. 过往搭配册 ------------------------- */

/* 没起名字时的兜底显示名，不写进数据，改名后立刻让位给真名 */
function lookTitle(l) {
  if (l.name) return l.name;
  const d = new Date(l.createdAt || Date.now());
  const date = (d.getMonth() + 1) + '月' + d.getDate() + '日';
  return (l.charName ? l.charName + '的搭配' : '一套搭配') + ' · ' + date;
}

async function saveLook(v, from) {
  const look = {
    id: uid('lk_'),
    createdAt: Date.now(),
    name: (v.name || '').trim(),
    charId: v.charId || '',
    charName: v.charName || '',
    itemIds: v.itemIds || [],
    comment: v.comment || '',
    promptEn: v.promptEn || '',
    genImage: v.genImage || '',
    mode: v.mode || '',
    looked: v.looked || 0,
    from: from || 'app'
  };
  S.looks.unshift(look);
  await Store.set('lk:' + look.id, enc(look));
  drawLooks();
  return look;
}

async function renameLook(id, name) {
  const l = S.looks.find(x => x.id === id);
  if (!l) return;
  l.name = (name || '').trim();
  await Store.set('lk:' + l.id, enc(l));
  drawLooks();
}

/* ---------- 命名抽屉：新存与改名共用 ----------
 * mode 'create'：确认后才真正写入搭配册（取消则什么都不存）
 * mode 'rename'：确认后只改名字，其余字段不动
 */
const LookNamer = {
  mode: 'create',
  lookId: null,
  payload: null,

  presets(l) {
    const tags = [];
    const items = S.items.filter(i => (l.itemIds || []).indexOf(i.id) >= 0);
    items.forEach(i => (i.tags || []).forEach(t => { if (tags.indexOf(t) < 0) tags.push(t); }));
    const d = new Date(l.createdAt || Date.now());
    const date = (d.getMonth() + 1) + '月' + d.getDate() + '日';
    const out = [];
    if (tags.length) out.push(tags.slice(0, 2).join(''));
    if (tags.length > 2) out.push(tags[2] + '系');
    out.push(date + '这套');
    if (l.charName) out.push(l.charName + '挑的');
    out.push('今日辣妹', '暗黑哥特');
    return out.filter((v, i) => v && out.indexOf(v) === i).slice(0, 6);
  },

  open(mode, arg) {
    this.mode = mode;
    const l = mode === 'rename' ? S.looks.find(x => x.id === arg) : arg;
    if (!l) return;
    this.lookId = mode === 'rename' ? arg : null;
    this.payload = mode === 'create' ? l : null;

    $('#lookNameTitle').textContent = mode === 'rename' ? '改个名字' : '给这套搭配起个名字';
    $('#lookNameHint').textContent = mode === 'rename'
      ? '清空保存就回到自动命名。'
      : '不填也行，会自动用「他的搭配」加日期。想日后好找就起个响亮的名字。';
    $('#lookNameSave').textContent = mode === 'rename' ? '保存改名' : '存进搭配册';
    $('#lookNameInput').value = l.name || '';

    const tb = $('#lookNameThumbs');
    tb.innerHTML = '';
    if (l.genImage) {
      const im = document.createElement('img');
      im.src = l.genImage;
      tb.appendChild(im);
    }
    S.items.filter(i => (l.itemIds || []).indexOf(i.id) >= 0).forEach(i => {
      if (!i.thumb) return;
      const im = document.createElement('img');
      im.src = i.thumb;
      im.alt = i.name || '';
      tb.appendChild(im);
    });

    const pb = $('#lookNamePresets');
    pb.innerHTML = '';
    this.presets(l).forEach(name => {
      const c = document.createElement('span');
      c.className = 'chip';
      c.textContent = name;
      c.onclick = () => {
        $('#lookNameInput').value = name;
        $('#lookNameInput').focus();
      };
      pb.appendChild(c);
    });

    closeDw();
    openDw('#dwLookName');
    /* 抽屉滑入动画结束后再聚焦，否则 iOS 上键盘会把动画顶歪 */
    setTimeout(() => { try { $('#lookNameInput').focus(); } catch (e) {} }, 320);
  },

  async confirm() {
    const name = $('#lookNameInput').value.trim();
    if (this.mode === 'rename') {
      await renameLook(this.lookId, name);
      closeDw();
      toast(name ? '已改名为「' + name + '」' : '已恢复自动命名');
      return;
    }
    const v = Object.assign({}, this.payload, { name: name });
    const look = await saveLook(v, 'app');
    closeDw();
    /* 存进搭配册是本地动作，不主动打扰角色；
       想让他看就点这个快捷操作，走 sendToChat 发进聊天。 */
    S.lastVerdict = v;
    toast('已存进搭配册：' + lookTitle(look), {
      duration: 5000,
      action: '发给他看',
      onAction: () => sendToChat()
    });
  }
};

async function delLook(id) {
  await Store.remove('lk:' + id);
  S.looks = S.looks.filter(l => l.id !== id);
  drawLooks();
  toast('已从搭配册移除');
}

function drawLooks() {
  const box = $('#lookList');
  box.innerHTML = '';
  if (!S.looks.length) {
    const p = document.createElement('div');
    p.className = 'panel';
    p.innerHTML = '<h3>还没有存下任何搭配</h3>'
      + '<p>去「灵感试衣间」让角色点评一套，点「存进搭配册」就会归档在这里。<br>'
      + '角色自己在聊天里挑的搭配，也会自动写进来。</p>';
    box.appendChild(p);
    return;
  }
  S.looks.forEach(l => {
    const p = document.createElement('div');
    p.className = 'panel';

    const h = document.createElement('h3');
    /* 点标题也能改名，跟右下角「改名」按钮等效 */
    const nameEl = document.createElement('span');
    nameEl.className = 'look-name' + (l.name ? '' : ' auto');
    nameEl.textContent = lookTitle(l);
    nameEl.title = '点这里改名';
    nameEl.onclick = () => LookNamer.open('rename', l.id);
    h.appendChild(nameEl);

    const bd = document.createElement('span');
    bd.className = 'badge';
    bd.textContent = new Date(l.createdAt).toLocaleDateString();
    h.appendChild(bd);
    if (l.charName) {
      const bc = document.createElement('span');
      bc.className = 'badge';
      bc.textContent = l.charName;
      h.appendChild(bc);
    }
    if (l.from === 'char') {
      const b2 = document.createElement('span');
      b2.className = 'badge';
      b2.textContent = '他写的';
      h.appendChild(b2);
    }
    if (l.looked) {
      const b3 = document.createElement('span');
      b3.className = 'badge';
      b3.textContent = '看图 ' + l.looked + ' 张';
      h.appendChild(b3);
    } else if (l.mode === 'text') {
      const b3 = document.createElement('span');
      b3.className = 'badge';
      b3.textContent = '纯文本';
      h.appendChild(b3);
    } else if (l.mode === 'self') {
      const b3 = document.createElement('span');
      b3.className = 'badge';
      b3.textContent = '自己搭的';
      h.appendChild(b3);
    } else if (l.mode === 'self-review') {
      const b3 = document.createElement('span');
      b3.className = 'badge';
      b3.textContent = '自己搭 · 他点评';
      h.appendChild(b3);
    }
    p.appendChild(h);

    if (l.genImage) {
      const g = document.createElement('div');
      g.className = 'genbox';
      const img = document.createElement('img');
      img.src = l.genImage;
      g.appendChild(img);
      p.appendChild(g);
    }

    const tl = document.createElement('div');
    tl.className = 'thumbline';
    S.items.filter(i => (l.itemIds || []).indexOf(i.id) >= 0).forEach(i => {
      if (!i.thumb) return;
      const im = document.createElement('img');
      im.src = i.thumb;
      tl.appendChild(im);
    });
    if (tl.children.length) p.appendChild(tl);

    const v = document.createElement('div');
    v.className = 'verdict';
    v.textContent = l.comment;
    p.appendChild(v);

    const row = document.createElement('div');
    row.className = 'row';
    row.style.marginTop = '10px';
    const bRename = document.createElement('button');
    bRename.className = 'btn gh sm';
    bRename.textContent = '改名';
    bRename.onclick = () => LookNamer.open('rename', l.id);
    const b1 = document.createElement('button');
    b1.className = 'btn gh sm';
    b1.textContent = '重发到私聊';
    b1.onclick = async () => {
      const backup = S.lastVerdict;
      S.lastVerdict = l;
      await sendToChat();
      S.lastVerdict = backup;
    };
    const b2 = document.createElement('button');
    b2.className = 'btn dg sm';
    b2.textContent = '删除';
    b2.onclick = () => delLook(l.id);
    row.appendChild(bRename); row.appendChild(b1); row.appendChild(b2);
    p.appendChild(row);

    box.appendChild(p);
  });
}

/* ------------------------- 13. 衣橱清单（给角色看） -------------------------
 * 脱离平台后不再需要「供稿」——角色就在这个 App 里，聊天时直接把衣橱清单
 * 拼进 system prompt 就行。这里只保留生成清单文本的函数，供聊天层调用。 */

/* 衣橱概况统计：件数 + 各维度分布。给「只给概况」模式用，也给统计面板用。 */
function buildWardrobeSummary() {
  const L = live();
  if (!L.length) return '（她的衣柜还是空的）';
  const lines = ['一共 ' + L.length + ' 件。'];

  const byCat = {};
  L.forEach(i => {
    const c = i.category || '未分类';
    byCat[c] = (byCat[c] || 0) + 1;
  });
  lines.push('分类：' + Object.keys(byCat).map(c => c + ' ' + byCat[c] + ' 件').join('，'));

  /* 按标签维度汇总，让他知道你的衣柜偏什么风格 */
  tagGroups().forEach(g => {
    const all = g.preset.concat(g.custom);
    if (!all.length) return;
    const hits = [];
    all.forEach(tg => {
      const c = L.filter(i => (i.tags || []).indexOf(tg) >= 0).length;
      if (c) hits.push(tg + ' ' + c);
    });
    if (hits.length) lines.push(g.group + '：' + hits.join('，'));
  });

  const looks = (S.looks || []).length;
  if (looks) lines.push('已经存了 ' + looks + ' 套搭配。');
  return lines.join('\n');
}

/* 一件衣服压成一行：[id] 名字·分类·标签·备注 */
function itemOneLiner(it) {
  const parts = [it.name || '未命名'];
  if (it.category) parts.push(it.category);
  if (it.tags && it.tags.length) parts.push(it.tags.join('/'));
  if (it.note) parts.push(it.note);
  return '[' + it.id + '] ' + parts.join('·');
}

/* 整个衣橱的完整清单。角色靠这个知道你到底有哪些衣服，
 * 才能说出「穿你那件黑色蕾丝吊带」这种具体的话。 */
function buildWardrobeList(limitChars) {
  const L = live();
  if (!L.length) return '（她的衣柜还是空的）';
  const byCat = {};
  L.forEach(i => {
    const c = i.category || '未分类';
    if (!byCat[c]) byCat[c] = [];
    byCat[c].push(i);
  });
  const blocks = [];
  Object.keys(byCat).sort().forEach(c => {
    blocks.push('【' + c + '】(' + byCat[c].length + '件)');
    byCat[c].forEach(i => blocks.push('  ' + itemOneLiner(i)));
  });
  let out = blocks.join('\n');
  const cap = limitChars || 9000;
  if (out.length > cap) {
    out = out.slice(0, cap) + '\n…（还有一些，篇幅原因省略）';
  }
  return out;
}


/* ------------------------- 14. 导出 / 导入 ------------------------- */
async function exportAll() {
  const t = toast('正在打包高清图…', { loading: true });
  try {
    const items = [];
    for (const it of S.items) {
      const full = await Store.get('im:' + it.id);
      items.push(Object.assign({}, it, { full: full || '' }));
    }
    const payload = {
      app: 'boudoir-closet',
      version: 3,
      exportedAt: new Date().toISOString(),
      cats: S.cats,
      pool: normalizePool(S.pool),
      items: items,
      looks: S.looks
    };
    const blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'my_closet.json';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    t.close();
    toast('已导出 ' + items.length + ' 件');
  } catch (e) {
    t.close();
    toast('导出失败：' + ((e && e.message) || e));
  }
}

async function importAll(file) {
  const t = toast('正在导入…', { loading: true });
  try {
    const data = JSON.parse(await file.text());
    if (!data || !Array.isArray(data.items)) { t.close(); return toast('这个文件不是衣橱备份'); }

    if (Array.isArray(data.cats)) {
      const set = [];
      S.cats.concat(data.cats).forEach(c => { if (set.indexOf(c) < 0) set.push(c); });
      S.cats = set;
      if (S.cats.indexOf('未分类') < 0) S.cats.push('未分类');
    }
    /* 标签池：兼容旧版扁平数组与新版按维度归档 */
    const inPool = normalizePool(data.pool);
    Object.keys(inPool).forEach(g => {
      inPool[g].forEach(t => { if (!groupOfTag(t)) addToPool(t, g); });
    });
    await saveCfg();

    let n = 0;
    for (const raw of data.items) {
      const full = raw.full || '';
      const it = cleanItemTags(Object.assign({}, raw), data.pool);
      delete it.full;
      if (!it.id || S.items.some(x => x.id === it.id)) it.id = uid('it_');
      if (typeof it.createdAt !== 'number') it.createdAt = Date.now();
      it.isDeleted = !!it.isDeleted;
      S.items.push(it);
      await saveMeta(it);
      if (full) await Store.set('im:' + it.id, full);
      n++;
    }
    if (Array.isArray(data.looks)) {
      for (const raw of data.looks) {
        const l = Object.assign({}, raw);
        if (!l.id || S.looks.some(x => x.id === l.id)) l.id = uid('lk_');
        S.looks.push(l);
        await Store.set('lk:' + l.id, enc(l));
      }
      S.looks.sort((a, b) => b.createdAt - a.createdAt);
    }
    t.close();
    drawCats(); drawGrid(); drawStats(); drawLooks();
    toast('已导入 ' + n + ' 件衣服');
  } catch (e) {
    t.close();
    console.error(e);
    toast('导入失败，文件可能损坏了');
  }
}

/* ------------------------- 15. 统计 / 环境信息 ------------------------- */
function drawStats() {
  const L = live();
  const el = $('#statText');
  el.innerHTML = '';

  /* 总计 */
  const sum = document.createElement('div');
  sum.className = 'stat-line';
  sum.innerHTML = '<b>总计</b>在柜 ' + L.length + ' 件，回收站 ' + (S.items.length - L.length) + ' 件，搭配册 ' + S.looks.length + ' 套';
  el.appendChild(sum);

  /* 服装分类 */
  const byCat = {};
  L.forEach(i => { const k = i.category || '未分类'; byCat[k] = (byCat[k] || 0) + 1; });
  const catLine = S.cats.map(c => byCat[c] ? c + ' ' + byCat[c] + ' 件' : null).filter(Boolean).join('，');
  if (catLine) {
    const d = document.createElement('div');
    d.className = 'stat-line';
    d.innerHTML = '<b>服装分类</b>' + catLine;
    el.appendChild(d);
  }

  /* 按标签维度统计：遍历所有维度（预设 + 自建），每个维度单独一行 */
  const groups = tagGroups();
  groups.forEach(g => {
    const allTags = g.preset.concat(g.custom);
    if (!allTags.length) return;
    const counts = {};
    allTags.forEach(t => { counts[t] = 0; });
    L.forEach(i => (i.tags || []).forEach(t => { if (t in counts) counts[t]++; }));
    const parts = allTags.map(t => counts[t] ? t + ' ' + counts[t] : null).filter(Boolean);
    if (!parts.length) return;
    const d = document.createElement('div');
    d.className = 'stat-line';
    d.innerHTML = '<b>' + g.group + '</b>' + parts.join('，');
    el.appendChild(d);
  });

  /* 不属于任何维度的散标签 */
  const knownTags = new Set();
  groups.forEach(g => { g.preset.forEach(t => knownTags.add(t)); g.custom.forEach(t => knownTags.add(t)); });
  const misc = {};
  L.forEach(i => (i.tags || []).forEach(t => { if (!knownTags.has(t)) misc[t] = (misc[t] || 0) + 1; }));
  const miscParts = Object.keys(misc).sort((a, b) => misc[b] - misc[a]).map(t => t + ' ' + misc[t]);
  if (miscParts.length) {
    const d = document.createElement('div');
    d.className = 'stat-line';
    d.innerHTML = '<b>其它标签</b>' + miscParts.join('，');
    el.appendChild(d);
  }
}

function drawStoreInfo() {
  const map = {
    'indexedDB': 'IndexedDB（容量按百兆算，够存几千张衣服照片）',
    'localStorage': 'localStorage（降级模式，只有约 5MB，建议少存大图）',
    'memory': '内存模式（当前浏览器不让存，刷新就丢，先别录入重要数据）'
  };
  const txt = '存储：' + (map[Store.driver] || Store.driver)
    + '。照片和 API Key 都只在这台设备上，不上传任何服务器。';
  const a = $('#storeInfo'); if (a) a.textContent = txt;
  const b = $('#storeInfo2'); if (b) b.textContent = txt;
}

/* 顶栏那颗小药丸：显示接口状态，一眼知道能不能用 AI */
function drawEnvPill() {
  const el = $('#envPill');
  if (!el) return;
  if (!AI.url || !AI.key) { el.textContent = '未配接口'; el.style.color = '#ff9b9b'; return; }
  if (!AI.model) { el.textContent = '缺模型'; el.style.color = '#ff9b9b'; return; }
  el.textContent = AI.model.length > 14 ? AI.model.slice(0, 13) + '…' : AI.model;
  el.style.color = '';
}

/* ------------------------- 16. 页面切换与事件 ------------------------- */
const PAGE_MAP = {
  closet: '#pgCloset', fitting: '#pgFitting',
  chat: '#pgChat', archive: '#pgArchive', set: '#pgSet', roleSet: '#pgRoleSet'
};
function go(page) {
  if (!PAGE_MAP[page]) page = 'closet';
  S.page = page;
  $$('.page').forEach(p => p.classList.remove('on'));
  $$('.nav button').forEach(b => b.classList.remove('on'));
  $(PAGE_MAP[page]).classList.add('on');
  const nb = $('.nav button[data-page="' + page + '"]');
  if (nb) nb.classList.add('on');

  /* 只有衣橱页需要浮动按钮和分类条；搜索框也只对衣橱有意义 */
  $('#fabs').style.display = page === 'closet' ? 'flex' : 'none';
  $('#cats').style.display = page === 'closet' ? 'flex' : 'none';

  /* 聊天页自己管滚动（消息区独立滚），外层 scroll 要让位 */
  const sc = $('#scroll');
  if (page === 'chat') {
    sc.style.overflowY = 'hidden';
    sc.style.padding = '10px 14px 4px';
  } else {
    sc.style.overflowY = 'auto';
    sc.style.padding = '';
    sc.scrollTop = 0;
  }

  if (page === 'fitting') drawPickInfo();
  if (page === 'archive') { drawStats(); drawLooks(); }
  if (page === 'chat') {
    /* 从别处切过来时回到会话列表；已经在某个聊天室里就保持不动 */
    if (chatView === 'room' && Chat.cur) {
      applyChatLook(); drawMsgs(); scrollMsgsToEnd(); updateReplyBadge();
    } else {
      chatView = 'list';
      $('#chatRoom').classList.remove('on');
      $('#chatList').classList.remove('hide');
      drawChatList();
    }
  }
  if (page === 'set' || page === 'roleSet') {
    drawSettings(); drawStoreInfo();
    if (page === 'roleSet') {
      const role = Roles.active;
      $('#roleSettingsTitle').textContent = (role ? role.name : '') + ' · 私人设置';
      drawWb(); drawMem();
      $('.nav button[data-page="set"]').classList.add('on');
    }
  }
}

function bind() {
  $('#btnBack').onclick = () => Bridge.close();
  $('#btnMore').onclick = () => { closeDw(); drawStoreInfo(); openDw('#dwMore'); };
  $('#btnTrash').onclick = () => { closeDw(); drawTrash(); openDw('#dwTrash'); };

  $('#kw').addEventListener('input', (e) => { S.kw = e.target.value.trim(); drawGrid(); });

  $('#fabAdd').onclick = () => openItem(null);
  $('#fabChar').onclick = () => go('fitting');

  $('#mask').onclick = closeDw;
  $('#itemCancel').onclick = () => { S.pending = []; closeDw(); };
  $('#itemSave').onclick = saveItem;
  $('#btnAutoTag').onclick = autoTag;
  $('#btnAutoTagAll').onclick = autoTagAll;
  $('#catDone').onclick = closeDw;
  $('#addCat').onclick = addCat;
  $('#trashDone').onclick = closeDw;
  $('#trashPurge').onclick = purge;
  $('#moreDone').onclick = closeDw;
  $('#btnCatMgr').onclick = openCats;
  $('#btnExport').onclick = exportAll;
  $('#btnImport').onclick = () => $('#importFile').click();
  $('#importFile').onchange = (e) => {
    if (e.target.files && e.target.files[0]) importAll(e.target.files[0]);
    e.target.value = '';
  };
  $('#newCat').addEventListener('keydown', e => { if (e.key === 'Enter') addCat(); });

  /* 上传：统一走 Bridge.pickImages（App 内自建 input，一次最多多选 20 张），
     选完直接交给 ingest() 走统一的压缩 + 数量上限逻辑，跟拖拽/粘贴共用同一条路。 */
  $('#drop').onclick = async () => {
    try {
      const files = await Bridge.pickImages();
      if (!files || !files.length) return;
      await ingest(files);
    } catch (e) {
      toast(humanErr(e));
    }
  };
  $('#file').onchange = (e) => { ingest(e.target.files); e.target.value = ''; };

  const dz = $('#drop');
  ['dragenter', 'dragover'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add('hot'); }));
  ['dragleave', 'drop'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove('hot'); }));
  dz.addEventListener('drop', e => { if (e.dataTransfer) ingest(e.dataTransfer.files); });
  window.addEventListener('paste', e => {
    if (!$('#dwItem').classList.contains('open')) return;
    const its = (e.clipboardData && e.clipboardData.items) || [];
    const fs = [];
    for (let i = 0; i < its.length; i++) {
      if (its[i].kind === 'file') { const f = its[i].getAsFile(); if (f) fs.push(f); }
    }
    if (fs.length) ingest(fs);
  });

  /* 多选条 */
  $('#selAll').onclick = () => {
    const list = shown();
    if (S.picked.size === list.length) S.picked.clear();
    else list.forEach(i => S.picked.add(i.id));
    drawGrid(); drawPickInfo();
  };
  $('#selExit').onclick = exitPick;
  $('#selDel').onclick = () => softDel(Array.from(S.picked));
  $('#selFit').onclick = () => {
    if (!S.picked.size) return toast('还没选衣服');
    S.pickMode = false;
    document.body.classList.remove('pickmode');
    drawGrid();
    go('fitting');
  };
  $('#selMove').onclick = async () => {
    if (!S.picked.size) return toast('还没选衣服');
    const r = window.prompt('移到哪个分类？\n可选：' + S.cats.join(' / '), S.cats[0]);
    if (r === null) return;
    const n = r.trim();
    if (S.cats.indexOf(n) < 0) return toast('没有这个分类，先去分类管理里建一个');
    let c = 0;
    for (const id of S.picked) {
      const it = S.items.find(x => x.id === id);
      it.category = n; await saveMeta(it); c++;
    }
    toast('已移动 ' + c + ' 件到「' + n + '」');
    exitPick();
  };
  $('#selTag').onclick = async () => {
    if (!S.picked.size) return toast('还没选衣服');
    const r = window.prompt('批量加标签（逗号分隔）：', '');
    if (!r) return;
    const tags = r.split(/[,，\s]+/).map(s => s.trim()).filter(Boolean);
    if (!tags.length) return;
    /* 新词要归栏；已存在的词沿用它原来的栏，不再追问 */
    const fresh = tags.filter(t => !groupOfTag(t));
    let group = MISC_GROUP;
    if (fresh.length) {
      const all = PRESET_GROUPS.concat(Object.keys(S.pool).filter(g => PRESET_GROUPS.indexOf(g) < 0));
      const g = window.prompt('「' + fresh.join('、') + '」是哪一类？\n可选：'
        + all.join(' / ') + '\n（留空或乱填都会进「' + MISC_GROUP + '」）', all[0]);
      if (g === null) return;
      const picked = g.trim();
      group = (picked && (PRESET_GROUPS.indexOf(picked) >= 0 || S.pool[picked])) ? picked : MISC_GROUP;
    }
    for (const id of S.picked) {
      const it = S.items.find(x => x.id === id);
      it.tags = Array.from(new Set((it.tags || []).concat(tags)));
      await saveMeta(it);
    }
    fresh.forEach(t => addToPool(t, group));
    await saveCfg();
    toast('已批量打上 ' + tags.length + ' 个标签');
    exitPick();
  };

  /* 试衣间：模式切换（自己搭 / 角色搭） */
  function syncWhoMode() {
    const isSelf = $('#modeSelf').checked;
    $('#modeRowSelf').classList.toggle('on', isSelf);
    $('#modeRowChar').classList.toggle('on', !isSelf);
    $('#panelSelf').style.display = isSelf ? 'block' : 'none';
    $('#panelChar').style.display = isSelf ? 'none' : 'block';
    $('#panelCharMode').style.display = isSelf ? 'none' : 'block';
    $('#panelCharAsk').style.display = isSelf ? 'none' : 'block';
    /* 自己搭模式下更新提示 */
    if (isSelf) {
      const n = S.picked.size;
      $('#selfHint').textContent = n
        ? '已选 ' + n + ' 件。可以直接存进搭配册，也可以让角色点评一下。'
        : '还没选衣服，回衣橱长按选几件，或点上面的随机抽卡。';
    }
  }
  $('#modeSelf').onchange = syncWhoMode;
  $('#modeChar').onchange = syncWhoMode;
  syncWhoMode();

  /* 选衣服抽屉 */
  $('#btnPickDrawer').onclick = () => PickDrawer.open();
  $('#pickSearch').addEventListener('input', (e) => {
    PickDrawer.kw = e.target.value.trim();
    PickDrawer.drawGrid();
  });
  $('#pickDone').onclick = () => {
    closeDw();
    drawPickInfo();
  };

  /* 自己搭配：直接存 */
  $('#btnSelfSave').onclick = () => {
    const chosen = S.items.filter(i => S.picked.has(i.id) && !i.isDeleted);
    if (!chosen.length) return toast('先选几件衣服');
    const comment = ($('#selfComment').value || '').trim();
    const v = {
      name: '',
      charId: '',
      charName: '我自己',
      itemIds: chosen.map(i => i.id),
      comment: comment || '自己搭的一套',
      promptEn: buildPromptEn(chosen),
      genImage: '',
      mode: 'self',
      looked: 0
    };
    LookNamer.open('create', v);
  };

  /* 自己搭配：请角色点评 —— 先展示点评，看完再存 */
  let selfReviewData = null;

  async function doSelfReview() {
    const chosen = S.items.filter(i => S.picked.has(i.id) && !i.isDeleted);
    if (!chosen.length) return toast('先选几件衣服');
    if (!S.charId) return toast('先切到「让角色帮我搭」模式选一位角色，或者先在那边选好角色再切回来');

    const btn = $('#btnSelfAskChar');
    btn.disabled = true;
    const t = toast('正在请 ' + (S.charName || '他') + ' 点评你的搭配…', { loading: true });

    try {
      const comment = ($('#selfComment').value || '').trim();
      const sys = '你是用户的私人穿搭顾问。用户已经自己搭好了一套衣服，'
        + '请你点评她搭得怎么样，给出你的看法和建议。保持你自己的说话方式。\n'
        + '按下面两段输出：\n'
        + '【点评】三到五句你的真实看法，可以夸也可以毒舌\n'
        + '【英文提示词】一行英文，逗号分隔的生图关键词，描述人穿着这套衣服的画面';

      const user = '这是我自己搭的一套：\n'
        + chosen.map(describe).join('\n')
        + (comment ? '\n\n我的想法：' + comment : '')
        + '\n\n你觉得怎么样？';

      const text = await Bridge.chat(
        [{ role: 'system', content: sys }, { role: 'user', content: user }],
        S.charId
      );

      t.close();
      toast('他的点评来了，看看满不满意');

      /* 展示点评 */
      const promptEn = pickSection(text, '英文提示词') || buildPromptEn(chosen);
      selfReviewData = {
        name: '',
        charId: S.charId,
        charName: S.charName,
        itemIds: chosen.map(i => i.id),
        comment: text || '（没有拿到点评）',
        promptEn: promptEn,
        genImage: '',
        mode: 'self-review',
        looked: 0
      };
      $('#selfVerdict').textContent = text || '（没有拿到点评）';
      $('#selfReviewBox').style.display = 'block';
      /* 滚动到点评区让用户看到 */
      $('#selfReviewBox').scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (e) {
      t.close();
      toast(humanErr(e), { duration: 4000 });
    } finally {
      btn.disabled = false;
    }
  }

  $('#btnSelfAskChar').onclick = doSelfReview;
  $('#btnSelfReviewRetry').onclick = doSelfReview;
  $('#btnSelfReviewSave').onclick = () => {
    if (!selfReviewData) return toast('先请他点评');
    LookNamer.open('create', selfReviewData);
  };

  /* 角色搭配 */
  $('#btnAsk').onclick = askChar;
  $('#btnGenImg').onclick = genImage;
  $('#btnSendChat').onclick = sendToChat;

  /* 搭配模式：文本 / 识图 + 张数 */
  $('#modeText').onchange = () => { syncModeUI(); saveCfg(); };
  $('#modeVision').onchange = () => { syncModeUI(); saveCfg(); };
  $('#visionMinus').onclick = () => { stepVision(-1); saveCfg(); };
  $('#visionPlus').onclick = () => { stepVision(1); saveCfg(); };
  $('#visionCount').addEventListener('input', syncModeUI);
  /* 失焦才收敛数值，输入过程中不打断用户（清空重填时不会被强行填回去） */
  $('#visionCount').addEventListener('blur', () => {
    $('#visionCount').value = visionCount();
    syncModeUI();
    saveCfg();
  });
  $('#btnCopyPrompt').onclick = async () => {
    const p = (S.lastVerdict && S.lastVerdict.promptEn) || buildPromptEn(S.items.filter(i => S.picked.has(i.id)));
    if (!p) return toast('还没有可复制的英文提示词');
    try {
      await navigator.clipboard.writeText(p);
      toast('提示词已复制');
    } catch (e) { toast('复制失败：' + ((e && e.message) || e)); }
  };
  $('#btnSaveLook').onclick = () => {
    if (!S.lastVerdict) return toast('先让他点评一套');
    LookNamer.open('create', S.lastVerdict);
  };
  $('#lookNameSave').onclick = () => LookNamer.confirm();
  $('#lookNameCancel').onclick = () => closeDw();
  $('#lookNameInput').addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); LookNamer.confirm(); }
  });
  /* 随机抽一套：按分类各抽一件，凑一整套真正能穿出门的搭配。
     一套衣服本来就不止 3 件（内搭+外套+下装+鞋+袜+首饰…），
     所以按你衣橱里有多少个分类来抽，最多 PICK_MAX 件。 */
  $('#btnRandom').onclick = () => {
    const L = live();
    if (L.length < 2) return toast('衣柜里至少要有两件才抽得动');
    S.picked.clear();

    /* 先按分类分桶 */
    const buckets = {};
    L.forEach(i => {
      const c = i.category || '未分类';
      if (!buckets[c]) buckets[c] = [];
      buckets[c].push(i);
    });

    /* 每个分类随机抽一件——这样抽出来的是「一套」而不是「三件随机衣服」 */
    const cats = Object.keys(buckets);
    for (let i = cats.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const tmp = cats[i]; cats[i] = cats[j]; cats[j] = tmp;
    }
    cats.forEach(c => {
      if (S.picked.size >= PICK_MAX) return;
      const b = buckets[c];
      S.picked.add(b[Math.floor(Math.random() * b.length)].id);
    });

    /* 分类太少（比如衣服都堆在「未分类」）就随机补到至少 3 件 */
    if (S.picked.size < 3) {
      const rest = L.filter(i => !S.picked.has(i.id));
      while (S.picked.size < Math.min(3, L.length) && rest.length) {
        const k = Math.floor(Math.random() * rest.length);
        S.picked.add(rest[k].id);
        rest.splice(k, 1);
      }
    }

    drawGrid(); drawPickInfo();
    toast('抽了 ' + S.picked.size + ' 件，凑齐 ' + Math.min(cats.length, S.picked.size)
      + ' 个类别。不满意可以再抽，或点「选取衣服」自己加减');
  };
  $('#btnClearPick').onclick = () => { S.picked.clear(); drawGrid(); drawPickInfo(); };

  $('#lb').onclick = (e) => { if (e.target.id === 'lb' || e.target.id === 'lbImg') closeLb(); };
  $$('.nav button').forEach(b => { b.onclick = () => go(b.dataset.page); });

  /* 键盘：独立 PWA 里用 visualViewport，把聚焦的输入框顶到可见区 */
  if (window.visualViewport) {
    let lastH = window.visualViewport.height;
    window.visualViewport.addEventListener('resize', () => {
      const h = window.visualViewport.height;
      const kbUp = h < lastH - 80;
      lastH = h;
      if (!kbUp) return;
      const el = document.activeElement;
      if (el && el.scrollIntoView && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA')) {
        setTimeout(() => { try { el.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch (e) {} }, 60);
      }
    });
  }

  setupSettingsPages();
  bindSettings();
  bindChat();
}

/* ------------------------- 16.5 设置面板 ------------------------- */
async function saveAI() {
  AI.url = normApiUrl(AI.url);
  await Store.set('ai:cfg', enc(AI));
  drawEnvPill();
}
async function saveAIFromForm() {
  AI.url = normApiUrl($('#apiUrl').value);
  AI.key = $('#apiKey').value.trim();
  AI.model = $('#apiModel').value.trim();
  AI.visionModel = $('#visionModel').value.trim();
  AI.visionQuality = $('#visionQ').value;
  AI.streamMode = $('#apiStreamMode').value;
  AI.autoResolved = '';
  await saveAI();
}

function drawSettings() {
  /* —— 接口 —— */
  const ps = $('#apiPreset');
  if (ps) {
    const keep = ps.value;
    ps.innerHTML = '';
    if (MyPresets.length) {
      const g1 = document.createElement('optgroup');
      g1.label = '我存的';
      MyPresets.forEach((x, i) => {
        const o = document.createElement('option');
        o.value = 'my:' + i;
        o.textContent = x.name + (x.model ? '（' + cut(x.model, 18) + '）' : '');
        g1.appendChild(o);
      });
      ps.appendChild(g1);
    }
    const g2 = document.createElement('optgroup');
    g2.label = '内置';
    API_PRESETS.forEach((x, i) => {
      const o = document.createElement('option');
      o.value = 'sys:' + i; o.textContent = x.name;
      g2.appendChild(o);
    });
    ps.appendChild(g2);
    if (keep) ps.value = keep;
  }
  const set = (id, v) => { const el = $(id); if (el) el.value = v == null ? '' : v; };
  set('#apiUrl', AI.url);
  set('#apiKey', AI.key);
  set('#apiModel', AI.model);
  set('#visionModel', AI.visionModel);
  set('#visionQ', AI.visionQuality || 'high');
  set('#apiStreamMode', AI.streamMode || 'auto');
  set('#rpTemp', String(RolePrefs.temp || 0.95));
  set('#rpMode', RolePrefs.rpMode || 'immersive');
  set('#wardrobeShare', RolePrefs.wardrobeShare || 'all');
  set('#memRounds', String(RolePrefs.memRounds || 40));
  set('#memAuto', String(RolePrefs.memAuto == null ? 20 : RolePrefs.memAuto));

  /* —— 聊天外观 —— */
  set('#bgDim', String(Look.dim == null ? 55 : Look.dim));
  set('#chatFs', String(Look.fs || 13.5));
  set('#chatFf', Look.ff || '');
  set('#aiTextColor', Look.aiText || '#ececf0');
  set('#meTextColor', Look.meText || '#ffffff');
  const bdv = $('#bgDimVal'); if (bdv) bdv.textContent = (Look.dim == null ? 55 : Look.dim) + '%';
  const cfv = $('#chatFsVal'); if (cfv) cfv.textContent = (Look.fs || 13.5) + 'px';
  const bgp = $('#bgPreview');
  if (bgp) {
    bgp.style.backgroundImage = Look.bg ? 'url("' + Look.bg + '")' : '';
    bgp.textContent = Look.bg ? '' : '';
  }

  const st = $('#apiState');
  if (st) {
    st.textContent = apiReady() ? '已配置' : '未配置';
    st.style.color = apiReady() ? '' : '#ff9b9b';
  }
  const fs2 = $('#feedState');
  if (fs2) {
    fs2.textContent = { all: '全部', stats: '只给概况', none: '不给' }[RolePrefs.wardrobeShare || 'all'];
  }

  /* —— 我 —— */
  set('#meNameInput', Me.name);
  set('#mePersona', Me.persona);
  set('#meBubble', Me.bubble || '#ff7597');
  const ma = $('#meAvatar'); if (ma) ma.src = Me.avatar || defaultAvatar(Me.name || '我', '#4a2b38');
  const mn = $('#meName'); if (mn) mn.textContent = Me.name || '未设置';

  drawRoleList();
}

function drawRoleList() {
  const box = $('#roleList');
  if (!box) return;
  box.innerHTML = '';
  const cnt = $('#roleCount');
  if (cnt) cnt.textContent = Roles.list.length + ' 位';

  if (!Roles.list.length) {
    const d = document.createElement('div');
    d.className = 'hint';
    d.style.margin = '0';
    d.textContent = '还没有角色。建一位，他就能翻你的衣柜、给你搭配、陪你聊天。';
    box.appendChild(d);
    return;
  }

  Roles.list.forEach(r => {
    const card = document.createElement('div');
    card.className = 'rolecard' + (r.id === Roles.activeId ? ' on' : '');

    const img = document.createElement('img');
    img.src = r.avatar || defaultAvatar(r.name, '#3a2f38');
    img.alt = r.name;
    img.title = '点击换头像';
    img.onclick = () => pickAvatarFor(r.id);

    const meta = document.createElement('div');
    meta.className = 'meta';
    const b = document.createElement('b');
    b.textContent = r.name || '未命名';
    const sp = document.createElement('span');
    sp.textContent = (r.prompt || '还没写人设').replace(/\s+/g, ' ').slice(0, 40);
    meta.appendChild(b); meta.appendChild(sp);

    const ops = document.createElement('div');
    ops.className = 'ops';
    const bEdit = document.createElement('button');
    bEdit.textContent = '设置'; bEdit.title = '打开该角色的独立设置';
    bEdit.style.width = 'auto';
    bEdit.style.padding = '0 8px';
    bEdit.onclick = () => openRoleSettings(r.id);
    const bDel = document.createElement('button');
    bDel.textContent = '✕'; bDel.title = '删除';
    bDel.onclick = async () => {
      if (roleSwitchBlocked()) return;
      if (Roles.list.length <= 1) return toast('至少留一位');
      if (!confirm('删掉「' + (r.name || '这位') + '」？他的聊天记录和记忆也会一起删掉。')) return;
      await Roles.remove(r.id);
      if (S.charId === r.id) S.charId = Roles.activeId;
      if (Chat.cur === r.id) { chatView = 'list'; }
      await Chat.open(Roles.activeId);
      drawRoleList(); drawChatList(); drawMsgs();
      try { await drawChars(); } catch (e) {}
      toast('已删除');
    };
    ops.appendChild(bEdit); ops.appendChild(bDel);

    meta.onclick = () => openRoleSettings(r.id);

    card.appendChild(img); card.appendChild(meta); card.appendChild(ops);
    box.appendChild(card);
  });
}

/* 给某个角色换头像 */
let avatarTargetRole = '';
function pickAvatarFor(roleId) {
  avatarTargetRole = roleId;
  $('#roleAvatarFile').click();
}

/* 读一张图 → 居中裁成正方形头像。
 * 走 squareCrop，所以竖图不会被压扁、横图不会被拉长。
 * 384px 足够头像放大看也清楚，体积约 30KB。 */
async function fileToAvatar(file) {
  const raw = await readFile(file);
  const img = await loadImg(raw);
  let out = squareCrop(img, 384, 0.88);
  /* 极端情况下（比如超大分辨率）再压一档 */
  if (out.length > 120000) out = squareCrop(img, 288, 0.82);
  if (out.length > 120000) out = squareCrop(img, 224, 0.78);
  return out;
}

/* 聊天背景图：铺满用，横屏竖屏都可能，所以等比缩不裁切 */
async function fileToBg(file) {
  const raw = await readFile(file);
  const img = await loadImg(raw);
  return shrinkTo(img, 1400, 700000).url;   // ≈ 510KB
}

/* ---------- 角色编辑抽屉 ---------- */
const RoleEditor = {
  id: '',
  open(id) {
    if (roleSwitchBlocked()) return;
    this.id = id || '';
    const r = id ? Roles.byId(id) : null;
    $('#roleEditTitle').textContent = r ? '编辑角色' : '新建角色';
    $('#roName').value = r ? (r.name || '') : '';
    $('#roPrompt').value = r ? (r.prompt || '') : '';
    $('#roGreeting').value = r ? (r.greeting || '') : '';
    $('#roBubble').value = (r && r.bubble) || '#1b1b20';
    $('#roAvatarPv').src = (r && r.avatar) || defaultAvatar(r ? r.name : '新', '#3a2f38');
    this.pendingAvatar = '';
    closeDw();
    openDw('#dwRole');
  },
  pendingAvatar: '',
  async confirm() {
    const name = $('#roName').value.trim();
    if (!name) return toast('给他起个名字');
    const patch = {
      name: name,
      prompt: $('#roPrompt').value,
      greeting: $('#roGreeting').value,
      bubble: $('#roBubble').value || '#1b1b20'
    };
    if (this.pendingAvatar) patch.avatar = this.pendingAvatar;

    if (this.id) {
      await Roles.update(this.id, patch);
    } else {
      const r = await Roles.add(patch);
      Roles.activeId = r.id;
      S.charId = r.id;
      S.charName = r.name;
      await Roles.save();
      await saveCfg();
      await Chat.open(r.id);
    }
    closeDw();
    drawRoleList(); drawChatList();
    /* 正在跟他聊就顺手把聊天室头部也更新了 */
    if (chatView === 'room' && Chat.cur) {
      const cr = Roles.byId(Chat.cur);
      if (cr) {
        $('#roomAvatar').src = cr.avatar || defaultAvatar(cr.name, '#3a2f38');
        $('#roomName').textContent = cr.name || '未命名';
      }
      drawMsgs();
    }
    try { await drawChars(); } catch (e) {}
    toast('已保存');
  }
};

/* ---------- 世界书 ---------- */
let WB = [];
async function loadWb() {
  const rid = Roles.activeId;
  WB = rid ? (dec(await Store.get('wb:' + rid), []) || []) : [];
  if (!Array.isArray(WB)) WB = [];
}
async function saveWb() {
  if (!Roles.activeId) return;
  await Store.set('wb:' + Roles.activeId, enc(WB));
}
function drawWb() {
  const box = $('#wbList');
  if (!box) return;
  box.innerHTML = '';
  const c = $('#wbCount');
  if (c) c.textContent = WB.length + ' 条';
  if (!WB.length) {
    const d = document.createElement('div');
    d.className = 'hint'; d.style.margin = '0';
    d.textContent = '还没有条目。';
    box.appendChild(d);
    return;
  }
  WB.forEach((w, i) => {
    const el = document.createElement('div');
    el.className = 'wbitem';
    const hd = document.createElement('div');
    hd.className = 'hd';
    const b = document.createElement('b');
    b.textContent = w.name || '未命名条目';
    const tg = document.createElement('button');
    tg.className = 'tgl' + (w.enabled === false ? '' : ' on');
    tg.onclick = async () => { w.enabled = (w.enabled === false); await saveWb(); drawWb(); };
    const del = document.createElement('button');
    del.textContent = '✕';
    del.style.cssText = 'background:none;border:none;color:#ff6b6b;font-size:13px;cursor:pointer';
    del.onclick = async () => { WB.splice(i, 1); await saveWb(); drawWb(); };
    hd.appendChild(b); hd.appendChild(tg); hd.appendChild(del);

    const kw = document.createElement('div');
    kw.className = 'kw';
    kw.textContent = w.constant ? '常驻（总是给他看）' : ('关键词：' + (w.keywords || []).join('、'));
    const ct = document.createElement('div');
    ct.className = 'ct';
    ct.textContent = w.content || '';

    el.appendChild(hd); el.appendChild(kw); el.appendChild(ct);
    el.onclick = (e) => {
      if (e.target === tg || e.target === del) return;
      WbEditor.open(i);
    };
    box.appendChild(el);
  });
}

const WbEditor = {
  idx: -1,
  open(i) {
    this.idx = (i == null ? -1 : i);
    const w = this.idx >= 0 ? WB[this.idx] : null;
    $('#wbEditTitle').textContent = w ? '编辑条目' : '新增条目';
    $('#wbName').value = w ? (w.name || '') : '';
    $('#wbKeys').value = w ? (w.keywords || []).join('，') : '';
    $('#wbContent').value = w ? (w.content || '') : '';
    $('#wbConst').checked = !!(w && w.constant);
    closeDw();
    openDw('#dwWb');
  },
  async confirm() {
    const name = $('#wbName').value.trim();
    const content = $('#wbContent').value.trim();
    if (!content) return toast('内容不能为空');
    const keys = $('#wbKeys').value.split(/[，,、\s]+/).map(x => x.trim()).filter(Boolean);
    const w = {
      name: name || (keys[0] || '条目'),
      keywords: keys,
      content: content,
      constant: $('#wbConst').checked,
      enabled: true
    };
    if (this.idx >= 0) WB[this.idx] = Object.assign(WB[this.idx], w);
    else WB.push(w);
    await saveWb();
    closeDw();
    drawWb();
    toast('已保存');
  }
};

/* ---------- 长期记忆 ---------- */
let MEM = [];
async function loadMem() {
  const rid = Roles.activeId;
  MEM = rid ? (dec(await Store.get('mem:' + rid), []) || []) : [];
  if (!Array.isArray(MEM)) MEM = [];
}
async function saveMem() {
  if (!Roles.activeId) return;
  await Store.set('mem:' + Roles.activeId, enc(MEM));
}
function drawMem() {
  const box = $('#memList');
  if (!box) return;
  box.innerHTML = '';
  const c = $('#memCount');
  if (c) c.textContent = MEM.length + ' 条';
  if (!MEM.length) {
    const d = document.createElement('div');
    d.className = 'hint'; d.style.margin = '0';
    d.textContent = '还没有记忆。聊够设定的轮数后会自动总结。';
    box.appendChild(d);
    return;
  }
  MEM.slice().reverse().forEach((m) => {
    const realIdx = MEM.indexOf(m);
    const el = document.createElement('div');
    el.className = 'memitem';
    const mh = document.createElement('div');
    mh.className = 'mh';
    const d = new Date(m.createdAt || Date.now());
    mh.appendChild(document.createTextNode(
      (d.getMonth() + 1) + '/' + d.getDate() + ' ' +
      String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0')));
    const del = document.createElement('button');
    del.textContent = '删除';
    del.onclick = async () => { MEM.splice(realIdx, 1); await saveMem(); drawMem(); };
    mh.appendChild(del);
    el.appendChild(mh);
    el.appendChild(document.createTextNode(m.text || ''));
    box.appendChild(el);
  });
}

function bindSettings() {
  /* 预设选择：sys:N = 内置（只填地址和模型），my:N = 我存的（连 Key 一起还原） */
  const ps = $('#apiPreset');
  if (ps) ps.onchange = async () => {
    const v = String(ps.value || '');
    if (v.indexOf('my:') === 0) {
      const x = MyPresets[Number(v.slice(3))];
      if (!x) return;
      AI.url = x.url || '';
      AI.key = x.key || '';
      AI.model = x.model || '';
      AI.visionModel = x.visionModel || '';
      AI.streamMode = x.streamMode || 'auto';
      AI.autoResolved = '';
      drawSettings();
      await saveAI();
      toast('已切到「' + x.name + '」');
      return;
    }
    const x = API_PRESETS[Number(v.slice(4)) || 0];
    if (!x || !x.url) return;
    AI.url = x.url;
    if (x.model) AI.model = x.model;
    AI.autoResolved = '';
    drawSettings();
    await saveAI();
    toast('已填入 ' + x.name + ' 的地址，把 Key 补上就能用');
  };

  /* 存为预设：把当前这一整套（含 Key）存下来 */
  const bsp = $('#btnSavePreset');
  if (bsp) bsp.onclick = async () => {
    if (!AI.url) return toast('先把 Base URL 填上');
    const def = AI.model ? cut(AI.model, 16) : '我的接口';
    const name = (prompt('给这套配置起个名字', def) || '').trim();
    if (!name) return;
    const item = {
      name: name, url: AI.url, key: AI.key, model: AI.model,
      visionModel: AI.visionModel || '', streamMode: AI.streamMode || 'auto'
    };
    const same = MyPresets.findIndex(x => x.name === name);
    if (same >= 0) {
      if (!confirm('已经有一个叫「' + name + '」的预设，覆盖它？')) return;
      MyPresets[same] = item;
    } else {
      MyPresets.push(item);
    }
    await savePresets();
    drawSettings();
    const sel = $('#apiPreset');
    if (sel) sel.value = 'my:' + (same >= 0 ? same : MyPresets.length - 1);
    toast('已存为预设「' + name + '」');
  };

  /* 删掉当前选中的「我存的」预设 */
  const bdp = $('#btnDelPreset');
  if (bdp) bdp.onclick = async () => {
    const sel = $('#apiPreset');
    const v = String((sel && sel.value) || '');
    if (v.indexOf('my:') !== 0) return toast('内置预设删不掉，选一个「我存的」再删');
    const i = Number(v.slice(3));
    const x = MyPresets[i];
    if (!x) return;
    if (!confirm('删掉预设「' + x.name + '」？当前正在用的配置不受影响。')) return;
    MyPresets.splice(i, 1);
    await savePresets();
    drawSettings();
    toast('已删掉');
  };

  const bindField = (id, key, isNum) => {
    const el = $(id);
    if (!el) return;
    el.addEventListener('change', async () => {
      const privateField = Object.prototype.hasOwnProperty.call(CHAT_DEFAULT, key);
      (privateField ? RolePrefs : AI)[key] = isNum ? Number(el.value) : el.value;
      if (privateField) await Roles.save();
      else await saveAI();
      if (id === '#apiUrl') { el.value = AI.url; AI.autoResolved = ''; }
      if (id === '#apiStreamMode') AI.autoResolved = '';
      drawSettings();
    });
  };
  bindField('#apiUrl', 'url');
  bindField('#apiKey', 'key');
  bindField('#apiModel', 'model');
  bindField('#visionModel', 'visionModel');
  bindField('#visionQ', 'visionQuality');
  bindField('#apiStreamMode', 'streamMode');
  bindField('#rpTemp', 'temp', true);
  bindField('#rpMode', 'rpMode');
  bindField('#wardrobeShare', 'wardrobeShare');
  bindField('#memRounds', 'memRounds', true);
  bindField('#memAuto', 'memAuto', true);

  /* 模型选择器：点输入框右边的 ⌄ 打开可搜索列表 */
  const amp = $('#apiModelPick');
  if (amp) amp.onclick = () => ModelPicker.open('#apiModel');
  const vmp = $('#visionModelPick');
  if (vmp) vmp.onclick = () => ModelPicker.open('#visionModel');
  const ms = $('#modelSearch');
  if (ms) ms.addEventListener('input', () => ModelPicker.draw(ms.value));
  const mc = $('#modelCancel');
  if (mc) mc.onclick = closeDw;

  /* 拉模型列表 */
  const bp = $('#btnPullModels');
  if (bp) bp.onclick = async () => {
    const out = $('#apiTestOut');
    out.style.display = 'block';
    out.textContent = '正在拉取…';
    bp.disabled = true;
    try {
      const list = await aiListModels();
      ModelList = list;
      try { await Store.set('ai:models', enc(list)); } catch (e) { /* 存不下也不影响用 */ }
      out.textContent = '拿到 ' + list.length + ' 个模型。点模型框右边的 ⌄ 就能挑。'
        + (list.length ? '' : '（这个接口没返回列表，手填模型名也行）');
    } catch (e) {
      out.textContent = '拉取失败：' + humanErr(e)
        + (e.detail ? '（' + String(e.detail).slice(0, 120) + '）' : '');
    } finally { bp.disabled = false; }
  };

  /* 测试连接 */
  const bt = $('#btnTestApi');
  if (bt) bt.onclick = async () => {
    const out = $('#apiTestOut');
    out.style.display = 'block';
    out.textContent = '正在测试…';
    bt.disabled = true;
    try {
      const t0 = Date.now();
      const txt = await aiRequest(
        [{ role: 'user', content: '只回答两个字：收到' }],
        { stream: false, temp: 0, maxTokens: 20 }
      );
      const ms = Date.now() - t0;
      out.textContent = '✅ 通了（' + ms + 'ms）。它说：' + String(txt || '').trim().slice(0, 40);
    } catch (e) {
      out.textContent = '❌ ' + humanErr(e)
        + (e.detail ? '\n详情：' + String(e.detail).slice(0, 160) : '');
    } finally { bt.disabled = false; }
  };

  /* 我的头像 */
  const maf = $('#meAvatarFile');
  if (maf) maf.onchange = async (e) => {
    const f = e.target.files && e.target.files[0];
    e.target.value = '';
    if (!f) return;
    try {
      Me.avatar = await fileToAvatar(f);
      await saveMe();
      drawSettings();
      drawMsgs();
    } catch (err) { toast('头像处理失败'); }
  };
  const ma = $('#meAvatar');
  if (ma) ma.onclick = () => $('#meAvatarFile').click();

  const bindMe = (id, key) => {
    const el = $(id);
    if (!el) return;
    el.addEventListener('change', async () => {
      Me[key] = el.value;
      await saveMe();
      drawSettings();
      drawMsgs();
    });
  };
  bindMe('#meNameInput', 'name');
  bindMe('#mePersona', 'persona');
  bindMe('#meBubble', 'bubble');

  /* 角色 */
  const bar = $('#btnAddRole');
  if (bar) bar.onclick = () => RoleEditor.open('');
  const raf = $('#roleAvatarFile');
  if (raf) raf.onchange = async (e) => {
    const f = e.target.files && e.target.files[0];
    e.target.value = '';
    if (!f) return;
    try {
      const av = await fileToAvatar(f);
      if (avatarTargetRole) {
        await Roles.update(avatarTargetRole, { avatar: av });
        avatarTargetRole = '';
        drawRoleList(); drawChatList(); drawMsgs();
      }
    } catch (err) { toast('头像处理失败'); }
  };
  const reAv = $('#roAvatarPv');
  if (reAv) reAv.onclick = () => $('#roEditAvatarFile').click();
  const reAvF = $('#roEditAvatarFile');
  if (reAvF) reAvF.onchange = async (e) => {
    const f = e.target.files && e.target.files[0];
    e.target.value = '';
    if (!f) return;
    try {
      RoleEditor.pendingAvatar = await fileToAvatar(f);
      $('#roAvatarPv').src = RoleEditor.pendingAvatar;
    } catch (err) { toast('头像处理失败'); }
  };
  const rs = $('#roleSave'); if (rs) rs.onclick = () => RoleEditor.confirm();
  const rc = $('#roleCancel'); if (rc) rc.onclick = () => closeDw();

  /* 世界书 */
  const baw = $('#btnAddWb');
  if (baw) baw.onclick = () => WbEditor.open(null);
  const ws = $('#wbSave'); if (ws) ws.onclick = () => WbEditor.confirm();
  const wc = $('#wbCancel'); if (wc) wc.onclick = () => closeDw();
  const fw = $('#foldWb');
  if (fw) fw.addEventListener('toggle', async () => { if (fw.open) { await loadWb(); drawWb(); } });

  /* 记忆 */
  const fm = $('#foldMem');
  if (fm) fm.addEventListener('toggle', async () => { if (fm.open) { await loadMem(); drawMem(); } });
  const bsn = $('#btnSummarizeNow');
  if (bsn) bsn.onclick = () => summarizeNow();
  const bcm = $('#btnClearMem');
  if (bcm) bcm.onclick = async () => {
    if (!confirm('清空这位角色的全部长期记忆？')) return;
    MEM = [];
    await saveMem();
    drawMem();
    toast('已清空');
  };

  /* 数据（设置页里的那几个，跟旧抽屉共用实现） */
  const c2 = $('#btnCatMgr2'); if (c2) c2.onclick = openCats;
  const e2 = $('#btnExport2'); if (e2) e2.onclick = exportAll;
  const i2 = $('#btnImport2'); if (i2) i2.onclick = () => $('#importFile2').click();
  const if2 = $('#importFile2');
  if (if2) if2.onchange = (e) => {
    if (e.target.files && e.target.files[0]) importAll(e.target.files[0]);
    e.target.value = '';
  };
  const bi = $('#btnInstallPwa'); if (bi) bi.onclick = promptInstall;
  const idn = $('#installDone'); if (idn) idn.onclick = closeDw;

  /* ---------- 聊天外观 ---------- */
  const bgp = $('#bgPreview');
  if (bgp) bgp.onclick = () => $('#chatBgFile').click();
  const bgf = $('#chatBgFile');
  if (bgf) bgf.onchange = async (e) => {
    const f = e.target.files && e.target.files[0];
    e.target.value = '';
    if (!f) return;
    const t = toast('正在处理背景图…', { loading: true });
    try {
      Look.bg = await fileToBg(f);
      await saveLookCfg();
      t.close();
      drawSettings();
      applyChatLook();
      toast('背景换好了');
    } catch (err) { t.close(); console.warn(err); toast('这张图处理不了，换一张试试'); }
  };
  const bcb = $('#btnClearBg');
  if (bcb) bcb.onclick = async () => {
    Look.bg = '';
    await saveLookCfg();
    drawSettings();
    applyChatLook();
    toast('已去掉背景图');
  };

  const bindLook = (id, key, isNum, live) => {
    const el = $(id);
    if (!el) return;
    const apply = async () => {
      Look[key] = isNum ? Number(el.value) : el.value;
      await saveLookCfg();
      applyChatLook();
      if (chatView === 'room') drawMsgs();
      if (live) live(el.value);
    };
    el.addEventListener('change', apply);
    /* 滑块拖动时实时预览 */
    if (el.type === 'range') el.addEventListener('input', () => {
      Look[key] = isNum ? Number(el.value) : el.value;
      applyChatLook();
      if (live) live(el.value);
    });
  };
  bindLook('#bgDim', 'dim', true, (v) => { const o = $('#bgDimVal'); if (o) o.textContent = v + '%'; });
  bindLook('#chatFs', 'fs', true, (v) => { const o = $('#chatFsVal'); if (o) o.textContent = v + 'px'; });
  bindLook('#chatFf', 'ff');
  bindLook('#aiTextColor', 'aiText');
  bindLook('#meTextColor', 'meText');

  const brl = $('#btnResetLook');
  if (brl) brl.onclick = async () => {
    Object.assign(Look, LOOK_DEFAULT);
    await saveLookCfg();
    drawSettings();
    applyChatLook();
    if (chatView === 'room') drawMsgs();
    toast('外观恢复默认了');
  };

  /* ---------- 危险操作 ---------- */
  const bcc = $('#btnClearChats');
  if (bcc) bcc.onclick = async () => {
    if (!confirm('清空「所有角色」的聊天记录？\n\n'
      + '角色本身、人设、长期记忆、世界书、衣橱都不会动，只删对话。\n'
      + '删了找不回来。')) return;
    const t = toast('正在清空…', { loading: true });
    try {
      for (const r of Roles.list) await Store.remove('msg:' + r.id);
      Chat.msgs = [];
      await Chat.persist();
      t.close();
      drawMsgs();
      drawChatList();
      updateReplyBadge();
      toast('所有聊天记录已清空');
    } catch (e) { t.close(); toast('清空失败：' + ((e && e.message) || e)); }
  };

  const bwa = $('#btnWipeAll');
  if (bwa) bwa.onclick = async () => {
    if (!confirm('⚠️ 删除所有数据\n\n'
      + '衣服照片、搭配册、角色、聊天、记忆、世界书、接口配置——全部删掉，\n'
      + '等于把 App 恢复成刚装好的样子。\n\n'
      + '这一步没有后悔药。确定吗？')) return;
    const word = prompt('最后确认：请输入「删除」两个字');
    if (String(word || '').trim() !== '删除') return toast('已取消');

    const t = toast('正在删除…', { loading: true });
    try {
      const all = await Store.all();
      for (const k of Object.keys(all)) await Store.remove(k);
      try { localStorage.clear(); } catch (e) { /* ignore */ }
      t.close();
      alert('已全部删除。点确定后页面会重新加载。');
      location.reload();
    } catch (e) {
      t.close();
      toast('删除失败：' + ((e && e.message) || e));
    }
  };
}

/* ------------------------- 16.6 聊天 -------------------------
 * 两级结构：
 *   一级 #chatList  —— 会话列表，每位角色一行，显示最后一句和时间
 *   二级 #chatRoom  —— 跟某一位的对话，其他人完全看不见
 * 发送和回复分开：
 *   ↑ 只把你这句加进对话（可以连发好几句）
 *   ✦ 让他把你攒的这几句一起看完再回
 */

/* 当前处在哪一级：'list' | 'room' */
let chatView = 'list';

/* ---------- 一级：会话列表 ---------- */
function drawChatList() {
  const box = $('#chatList');
  if (!box) return;
  box.innerHTML = '';

  if (!Roles.list.length) {
    const d = document.createElement('div');
    d.className = 'panel';
    d.innerHTML = '<h3>还没有角色</h3>'
      + '<p style="font-size:12.5px;color:var(--text-sub);line-height:1.7">'
      + '去「设置 → 角色」建一位，他就能翻你的衣柜、给你搭配、陪你聊天了。</p>';
    const b = document.createElement('button');
    b.className = 'btn pri sm';
    b.style.marginTop = '10px';
    b.textContent = '＋ 去建一位';
    b.onclick = () => { go('set'); const f = $('#foldRoles'); if (f) f.open = true; RoleEditor.open(''); };
    d.appendChild(b);
    box.appendChild(d);
    return;
  }

  Roles.list.forEach(r => {
    const el = document.createElement('div');
    el.className = 'convo' + (r.id === Chat.cur ? ' on' : '');

    const img = document.createElement('img');
    img.src = r.avatar || defaultAvatar(r.name, '#3a2f38');
    img.alt = '';

    const meta = document.createElement('div');
    meta.className = 'cmeta';

    const nameRow = document.createElement('div');
    nameRow.className = 'cname';
    const nb = document.createElement('b');
    nb.textContent = r.name || '未命名';
    nameRow.appendChild(nb);
    const ts = document.createElement('span');
    ts.className = 't';
    nameRow.appendChild(ts);

    const last = document.createElement('div');
    last.className = 'clast';
    meta.appendChild(nameRow);
    meta.appendChild(last);

    el.appendChild(img);
    el.appendChild(meta);
    el.onclick = () => openRoom(r.id);
    box.appendChild(el);

    /* 最后一句 + 时间：异步读，避免列表渲染卡住 */
    chatPreview(r.id).then(pv => {
      if (pv.text) {
        last.textContent = pv.text;
        last.classList.remove('empty');
      } else {
        last.textContent = r.greeting || '还没聊过';
        last.classList.add('empty');
      }
      ts.textContent = pv.ts ? shortTime(pv.ts) : '';
    });
  });
}

/* 读某个角色的最后一句（当前打开的那位直接用内存，其余读存储） */
async function chatPreview(roleId) {
  let arr;
  if (roleId === Chat.cur) arr = Chat.msgs;
  else arr = dec(await Store.get('msg:' + roleId), []) || [];
  if (!Array.isArray(arr) || !arr.length) return { text: '', ts: 0 };
  const m = arr[arr.length - 1];
  let t = m.text || '';
  if (m.look) t = '[搭配] ' + (m.look.name || m.look.plan || '一套搭配');
  if (m.role === 'user') t = '我：' + t;
  return { text: cut(t.replace(/\s+/g, ' '), 40), ts: m.ts || 0 };
}

/* 今天只显示时分，昨天显示「昨天」，更早显示月/日 */
function shortTime(ts) {
  const d = new Date(ts), now = new Date();
  const sameDay = d.toDateString() === now.toDateString();
  if (sameDay) return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
  const y = new Date(now.getTime() - 86400000);
  if (d.toDateString() === y.toDateString()) return '昨天';
  return (d.getMonth() + 1) + '/' + d.getDate();
}

/* ---------- 进出聊天室 ---------- */
async function openRoom(roleId) {
  const r = Roles.byId(roleId);
  if (!r || roleSwitchBlocked()) return;
  Chat.switching = true;
  try {
    chatView = 'room';
    Roles.activeId = r.id;
    S.charId = r.id;
    S.charName = r.name;
    await Chat.open(r.id);
    await Roles.save();
    await saveCfg();
    $('#chatList').classList.add('hide');
    $('#chatRoom').classList.add('on');
    $('#roomAvatar').src = r.avatar || defaultAvatar(r.name, '#3a2f38');
    $('#roomName').textContent = r.name || '未命名';
    applyChatLook();
    drawMsgs();
    scrollMsgsToEnd();
    updateReplyBadge();
    await drawChars();
  } catch (e) { toast('聊天室加载失败：' + humanErr(e)); }
  finally { Chat.switching = false; }
}

function closeRoom() {
  chatView = 'list';
  $('#chatRoom').classList.remove('on');
  $('#chatList').classList.remove('hide');
  drawChatList();
}

/* ---------- 外观（背景 / 字号 / 字体 / 文字色）---------- */
function applyChatLook() {
  const room = $('#chatRoom');
  if (!room) return;
  const bg = $('#chatBg');
  if (bg) {
    if (Look.bg) {
      bg.style.backgroundImage = 'url("' + Look.bg + '")';
      bg.style.display = 'block';
    } else {
      bg.style.backgroundImage = '';
      bg.style.display = 'none';
    }
  }
  room.style.setProperty('--bg-dim', (Look.dim == null ? 55 : Look.dim) / 100);
  const msgs = $('#msgs');
  if (msgs) {
    msgs.style.setProperty('--chat-fs', (Look.fs || 13.5) + 'px');
    msgs.style.setProperty('--chat-ff', Look.ff || 'inherit');
  }
}

/* ---------- 消息渲染 ---------- */
function drawMsgs() {
  const box = $('#msgs');
  if (!box) return;
  box.innerHTML = '';
  const role = Roles.byId(Chat.cur);
  if (!role) return;

  if (!Chat.msgs.length) {
    const greet = role.greeting || '（还没聊过。说句话开始吧）';
    box.appendChild(buildMsgEl({ role: 'ai', text: greet, ts: 0 }, role, -1));
    return;
  }

  let lastTs = 0;
  Chat.msgs.forEach((m, i) => {
    if (m.ts && m.ts - lastTs > 300000) {
      const t = document.createElement('div');
      t.className = 'ts';
      const d0 = new Date(m.ts);
      t.textContent = (d0.getMonth() + 1) + '月' + d0.getDate() + '日 '
        + String(d0.getHours()).padStart(2, '0') + ':' + String(d0.getMinutes()).padStart(2, '0');
      box.appendChild(t);
      lastTs = m.ts;
    }
    box.appendChild(buildMsgEl(m, role, i));
    if (m.ts) lastTs = m.ts;
  });
}

function buildMsgEl(m, role, idx) {
  const wrap = document.createElement('div');

  if (m.role === 'sys') {
    wrap.className = 'msg sys';
    const b = document.createElement('div');
    b.className = 'bub';
    b.textContent = m.text || '';
    wrap.appendChild(b);
    return wrap;
  }

  const mine = m.role === 'user';
  wrap.className = 'msg' + (mine ? ' me' : '');

  const av = document.createElement('img');
  av.className = 'av';
  av.src = mine
    ? (Me.avatar || defaultAvatar(Me.name || '我', '#4a2b38'))
    : (role.avatar || defaultAvatar(role.name, '#3a2f38'));
  av.alt = '';

  const bub = document.createElement('div');
  bub.className = 'bub';
  /* 气泡底色 + 文字色都可自定义，避免出现「黑底黑字」 */
  if (mine) {
    if (Me.bubble) bub.style.background = hexA(Me.bubble, .17);
    if (Look.meText) bub.style.color = Look.meText;
  } else {
    if (role.bubble) bub.style.background = role.bubble;
    if (Look.aiText) bub.style.color = Look.aiText;
  }

  let html = '';
  if (!mine) html += '<div class="nm">' + escHtml(role.name || '他') + '</div>';
  html += renderRich(m.text || '');
  bub.innerHTML = html;

  if (m.look) bub.appendChild(buildLookCardEl(m.look));

  /* 长按删除（开场白那条 idx<0 不给删） */
  if (idx >= 0) {
    let timer = null;
    const start = () => {
      timer = setTimeout(async () => {
        if (!confirm('删掉这条消息？')) return;
        Chat.msgs.splice(idx, 1);
        await Chat.persist();
        drawMsgs();
        updateReplyBadge();
      }, 700);
    };
    const cancel = () => { if (timer) { clearTimeout(timer); timer = null; } };
    bub.addEventListener('touchstart', start, { passive: true });
    ['touchend', 'touchmove', 'mouseup', 'mouseleave'].forEach(ev => bub.addEventListener(ev, cancel));
    bub.addEventListener('mousedown', start);
  }

  wrap.appendChild(av);
  wrap.appendChild(bub);
  return wrap;
}

function buildLookCardEl(look) {
  const card = document.createElement('div');
  card.className = 'lookcard';
  if (look.thumbs && look.thumbs.length) {
    const th = document.createElement('div');
    th.className = 'thumbs';
    look.thumbs.forEach(u => {
      const im = document.createElement('img');
      im.src = u; im.alt = '';
      th.appendChild(im);
    });
    card.appendChild(th);
  }
  const cap = document.createElement('div');
  cap.className = 'cap';
  let capHtml = '';
  if (look.name) capHtml += '<b>' + escHtml(look.name) + '</b>';
  if (look.plan) capHtml += escHtml(look.plan);
  else if (look.names && look.names.length) capHtml += escHtml(look.names.join(' + '));
  cap.innerHTML = capHtml || '一套搭配';
  card.appendChild(cap);
  return card;
}

function escHtml(s) {
  return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
function hexA(hex, a) {
  const m = /^#?([0-9a-f]{6})$/i.exec(String(hex || '').trim());
  if (!m) return hex;
  const v = parseInt(m[1], 16);
  return 'rgba(' + ((v >> 16) & 255) + ',' + ((v >> 8) & 255) + ',' + (v & 255) + ',' + a + ')';
}
function renderRich(text) {
  const esc = escHtml(text);
  if ((RolePrefs.rpMode || 'immersive') !== 'immersive') return esc;
  return esc.replace(/\*([^*\n]{1,120})\*/g, '<i class="act">$1</i>');
}
function scrollMsgsToEnd() {
  const box = $('#msgs');
  if (box) requestAnimationFrame(() => { box.scrollTop = box.scrollHeight; });
}

/* ---------- 打字指示 ---------- */
function showTyping() {
  const box = $('#msgs');
  if (!box) return null;
  const role = Roles.byId(Chat.cur);
  const wrap = document.createElement('div');
  wrap.className = 'msg';
  wrap.id = 'typingRow';
  const av = document.createElement('img');
  av.className = 'av';
  av.src = (role && role.avatar) || defaultAvatar(role ? role.name : '他', '#3a2f38');
  const bub = document.createElement('div');
  bub.className = 'bub';
  if (role && role.bubble) bub.style.background = role.bubble;
  if (Look.aiText) bub.style.color = Look.aiText;
  bub.innerHTML = '<div class="typing"><i></i><i></i><i></i></div>';
  wrap.appendChild(av); wrap.appendChild(bub);
  box.appendChild(wrap);
  scrollMsgsToEnd();
  return bub;
}
function removeTyping() {
  const r = document.getElementById('typingRow');
  if (r && r.parentNode) r.parentNode.removeChild(r);
}

/* ---------- system prompt ---------- */
function buildChatSystem(role) {
  const parts = [];
  const cn = role.name || '他';
  const un = Me.name || '你';

  parts.push('你正在进行沉浸式角色扮演。你就是「' + cn + '」，'
    + '你不是 AI、不是助手，不要以任何方式暴露自己是程序。');

  if ((RolePrefs.rpMode || 'immersive') === 'immersive') {
    parts.push('可以用 *动作* 的形式穿插神态和动作描写，但别写成小说，'
      + '一条消息里最多一两处，重点还是对话。');
  } else {
    parts.push('只输出说出口的话。不要任何括号、星号、动作描写、神态描写、旁白。');
  }

  if (role.prompt) parts.push('【你的人设】\n' + applyVars(role.prompt, role));
  if (Me.name || Me.persona) {
    parts.push('【关于' + un + '】\n' + (Me.persona ? applyVars(Me.persona, role) : '（她没多说）'));
  }

  const wbTxt = pickWorldBook();
  if (wbTxt) parts.push('【你知道的设定】\n' + wbTxt);

  if (MEM.length) {
    let mt = MEM.slice(-60).map(m => '· ' + m.text).join('\n');
    if (mt.length > 4000) mt = mt.slice(-4000);
    parts.push('【你们之前的事】\n' + mt);
  }

  const share = RolePrefs.wardrobeShare || 'all';
  if (share === 'all') {
    parts.push('【她的衣柜】\n' + buildWardrobeList(9000)
      + '\n聊穿搭时请直接说出具体衣服的名字，别笼统地说「你的裙子」。'
      + '需要的话可以用 [id] 指代，但说话时用名字。');
  } else if (share === 'stats') {
    parts.push('【她的衣柜概况】\n' + buildWardrobeSummary());
  }

  parts.push('【怎么说话】\n'
    + '· 长短随意，像真人发消息，别每条都一样长\n'
    + '· 不要总结、不要说教、不要问「还有什么可以帮你」\n'
    + '· 不要复述她说过的话\n'
    + '· 她可能一次连发好几条，你要把它们当成一整段话来回应，而不是逐条回复\n'
    + '· 她发穿搭卡片过来时，就针对那套具体点评');

  return parts.join('\n\n');
}

function pickWorldBook() {
  if (!WB.length) return '';
  const recent = Chat.msgs.slice(-6).map(m => (m.text || '') + ' ' + (m.raw || '')).join(' ');
  const out = [];
  WB.forEach(w => {
    if (w.enabled === false) return;
    if (w.constant) { out.push('· ' + (w.content || '')); return; }
    const keys = w.keywords || [];
    if (!keys.length) return;
    if (keys.some(k => k && recent.indexOf(k) >= 0)) out.push('· ' + (w.content || ''));
  });
  let t = out.join('\n');
  if (t.length > 3000) t = t.slice(0, 3000);
  return t;
}

function buildChatHistory() {
  const rounds = Number(RolePrefs.memRounds || 40);
  const arr = Chat.msgs.filter(m => m.role === 'user' || m.role === 'ai').slice(-rounds * 2);
  /* 连着发的几条合并成一条，免得模型把它们当成多轮对话 */
  const out = [];
  arr.forEach(m => {
    const role = m.role === 'user' ? 'user' : 'assistant';
    const content = (m.role === 'user' && m.raw) ? m.raw : (m.text || '');
    if (!content) return;
    const last = out[out.length - 1];
    if (last && last.role === role) last.content += '\n' + content;
    else out.push({ role: role, content: content });
  });
  return out;
}

/* ---------- 发送（不触发回复）---------- */
/* 从最后一条 AI 消息之后数，我攒了几句还没让他回 */
function pendingCount() {
  let c = 0;
  for (let i = Chat.msgs.length - 1; i >= 0; i--) {
    if (Chat.msgs[i].role === 'ai') break;
    if (Chat.msgs[i].role === 'user') c++;
  }
  return c;
}
function updateReplyBadge() {
  const btn = $('#chatReply');
  if (!btn) return;
  const old = btn.querySelector('.pend');
  if (old) old.remove();
  const n = pendingCount();
  if (n > 0) {
    const s = document.createElement('span');
    s.className = 'pend';
    s.textContent = String(n);
    btn.appendChild(s);
  }
}

async function sendChat() {
  if (Chat.busy) return;
  const role = Roles.byId(Chat.cur);
  if (!role) return toast('先去「设置 → 角色」建一位');

  const ta = $('#chatInput');
  const text = (ta.value || '').trim();
  if (!text) return;

  ta.value = '';
  ta.style.height = 'auto';

  Chat.msgs.push({ role: 'user', text: text, ts: Date.now() });
  await Chat.persist();
  drawMsgs();
  scrollMsgsToEnd();
  updateReplyBadge();
}

/* ---------- 让他回复 ---------- */
async function replyChat() {
  if (Chat.busy) return;
  const role = Roles.byId(Chat.cur);
  if (!role) return toast('先去「设置 → 角色」建一位');
  if (!apiReady()) {
    go('set');
    const f = $('#foldApi'); if (f) f.open = true;
    return toast('先配 AI 接口');
  }

  /* 输入框里还有没发出去的字：先当成一条发出去，再让他回 */
  const ta = $('#chatInput');
  const pending = (ta.value || '').trim();
  if (pending) {
    ta.value = '';
    ta.style.height = 'auto';
    Chat.msgs.push({ role: 'user', text: pending, ts: Date.now() });
    await Chat.persist();
    drawMsgs();
    scrollMsgsToEnd();
  }

  if (!Chat.msgs.filter(m => m.role === 'user').length) {
    return toast('先说点什么，再让他回');
  }
  await runAiReply();
}

async function runAiReply() {
  const role = Roles.byId(Chat.cur);
  if (!role || Chat.busy) return;
  Chat.busy = true;
  const sendBtn = $('#chatSend');
  const replyBtn = $('#chatReply');
  if (sendBtn) sendBtn.disabled = true;
  if (replyBtn) { replyBtn.disabled = true; replyBtn.classList.add('busy'); }

  const bub = showTyping();
  let acc = '';
  try {
    const messages = [{ role: 'system', content: buildChatSystem(role) }].concat(buildChatHistory());
    const txt = await aiRequest(messages, {
      temp: Number(RolePrefs.temp || 0.95),
      onDelta: (piece, full) => {
        acc = full;
        if (bub) {
          bub.innerHTML = '<div class="nm">' + escHtml(role.name || '他') + '</div>' + renderRich(full);
          scrollMsgsToEnd();
        }
      }
    });
    removeTyping();
    const finalText = (txt || acc || '').trim();
    if (!finalText) {
      Chat.msgs.push({ role: 'sys', text: '（他没说话，可能是模型返回空。再试一次？）', ts: Date.now() });
    } else {
      Chat.msgs.push({ role: 'ai', text: finalText, ts: Date.now() });
    }
    await Chat.persist();
    drawMsgs();
    scrollMsgsToEnd();
    maybeAutoSummarize();
  } catch (e) {
    removeTyping();
    console.error('聊天失败', e);
    Chat.msgs.push({
      role: 'sys',
      text: '发送失败：' + humanErr(e) + (e.detail ? '（' + String(e.detail).slice(0, 100) + '）' : ''),
      ts: Date.now()
    });
    await Chat.persist();
    drawMsgs();
    scrollMsgsToEnd();
  } finally {
    Chat.busy = false;
    if (sendBtn) sendBtn.disabled = false;
    if (replyBtn) { replyBtn.disabled = false; replyBtn.classList.remove('busy'); }
    updateReplyBadge();
  }
}

/* ---------- 记忆总结 ---------- */
function unsummarizedCount() {
  const last = MEM.length ? (MEM[MEM.length - 1].to || 0) : 0;
  return Chat.msgs.filter((m, i) => i >= last && m.role === 'user').length;
}
function maybeAutoSummarize() {
  const every = Number(RolePrefs.memAuto == null ? 20 : RolePrefs.memAuto);
  if (!every) return;
  if (unsummarizedCount() >= every) summarizeNow(true);
}

async function summarizeNow(silent) {
  const role = Roles.byId(Chat.cur);
  if (!role) return;
  if (!apiReady()) { if (!silent) toast('先配 AI 接口'); return; }
  const last = MEM.length ? (MEM[MEM.length - 1].to || 0) : 0;
  const seg = Chat.msgs.slice(last).filter(m => m.role === 'user' || m.role === 'ai');
  if (seg.length < 4) { if (!silent) toast('聊得还太少，没什么可总结的'); return; }

  const t = silent ? null : toast('正在总结…', { loading: true });
  try {
    const convo = seg.map(m =>
      (m.role === 'user' ? (Me.name || '她') : (role.name || '他')) + '：' +
      ((m.role === 'user' && m.raw) ? m.raw : m.text)
    ).join('\n').slice(-6000);

    const txt = await aiRequest([
      { role: 'system', content: '你是记忆整理助手。把下面的对话压缩成第三人称的记忆要点，'
        + '只保留以后还用得上的事实、约定、偏好、情绪转折。'
        + '每条一行，以「· 」开头，最多 6 条，不要复述寒暄。' },
      { role: 'user', content: convo }
    ], { stream: false, temp: 0.4 });

    const clean = String(txt || '').trim();
    if (clean) {
      MEM.push({ text: clean, createdAt: Date.now(), from: last, to: Chat.msgs.length });
      if (MEM.length > 150) MEM = MEM.slice(-150);
      await saveMem();
      drawMem();
      if (t) t.close();
      if (!silent) toast('记下来了');
      else console.info('已自动总结一条记忆');
    } else {
      if (t) t.close();
      if (!silent) toast('没拿到总结内容');
    }
  } catch (e) {
    if (t) t.close();
    console.warn('总结失败', e);
    if (!silent) toast('总结失败：' + humanErr(e));
  }
}

/* ---------- 事件绑定 ---------- */
function bindChat() {
  const ta = $('#chatInput');
  const sb = $('#chatSend');
  const rb = $('#chatReply');
  if (sb) sb.onclick = sendChat;
  if (rb) rb.onclick = replyChat;

  const back = $('#roomBack');
  if (back) back.onclick = closeRoom;

  const re = $('#roomEdit');
  if (re) { re.textContent = '角色设置'; re.onclick = () => { if (Chat.cur) openRoleSettings(Chat.cur); }; }

  const rc = $('#roomClear');
  if (rc) rc.onclick = async () => {
    const r = Roles.byId(Chat.cur);
    if (!r) return;
    if (!confirm('清空跟「' + (r.name || '他') + '」的聊天记录？\n（长期记忆和世界书不会动）')) return;
    Chat.msgs = [];
    await Chat.persist();
    drawMsgs();
    updateReplyBadge();
    toast('已清空');
  };

  if (ta) {
    ta.addEventListener('input', () => {
      ta.style.height = 'auto';
      ta.style.height = Math.min(ta.scrollHeight, 110) + 'px';
    });
    /* 电脑上：回车发送（不触发回复），Ctrl/Cmd+回车让他回 */
    ta.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || e.shiftKey) return;
      if ('ontouchstart' in window) return;       // 手机上回车就是换行
      e.preventDefault();
      if (e.ctrlKey || e.metaKey) replyChat();
      else sendChat();
    });
  }
}


/* ------------------------- 16.7 PWA ------------------------- */
let installEvt = null;

/* 桌面图标：把 logo 画到 canvas 再导出 PNG。
 * 为什么不直接用那张 JPEG：
 *   1) 有些平台的 manifest 只认 PNG
 *   2) maskable 图标会被系统裁成圆角/圆形，四周要留安全边距，
 *      所以这里把图缩到 78% 居中放，四周补深色底，怎么裁都不会切到主体 */
function buildAppIcon(size, maskable) {
  return new Promise((resolve) => {
    const c = document.createElement('canvas');
    c.width = c.height = size;
    const g = c.getContext('2d');
    g.fillStyle = '#0a0a0c';
    g.fillRect(0, 0, size, size);
    const im = new Image();
    im.onload = () => {
      const inset = maskable ? size * 0.11 : 0;   // maskable 留安全区
      const d = size - inset * 2;
      const scale = Math.min(d / im.naturalWidth, d / im.naturalHeight);
      const width = im.naturalWidth * scale;
      const height = im.naturalHeight * scale;
      g.drawImage(im, (size - width) / 2, (size - height) / 2, width, height);
      resolve(c.toDataURL('image/png'));
    };
    im.onerror = () => resolve(c.toDataURL('image/png'));
    im.src = LOGO_SRC;
  });
}

async function initPwa() {
  try {
    const iconAny = await buildAppIcon(512, false);
    const iconMask = await buildAppIcon(512, true);
    const icon = iconAny;

    const mf = {
      name: '私享衣橱',
      short_name: '衣橱',
      start_url: location.pathname + location.search,
      scope: './',
      display: 'standalone',
      orientation: 'portrait',
      background_color: '#0a0a0c',
      theme_color: '#0a0a0c',
      icons: [
        { src: iconAny,  sizes: '512x512', type: 'image/png', purpose: 'any' },
        { src: iconMask, sizes: '512x512', type: 'image/png', purpose: 'maskable' }
      ]
    };
    const blob = new Blob([JSON.stringify(mf)], { type: 'application/manifest+json' });
    const link = document.createElement('link');
    link.rel = 'manifest';
    link.href = URL.createObjectURL(blob);
    document.head.appendChild(link);

    const ai = document.createElement('link');
    ai.rel = 'apple-touch-icon';
    ai.href = icon;
    document.head.appendChild(ai);
  } catch (e) { console.warn('manifest 注入失败', e); }

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    installEvt = e;
  });

  /* Service Worker：只有 http(s) 下才有意义，file:// 打开时跳过 */
  if ('serviceWorker' in navigator && location.protocol.indexOf('http') === 0) {
    const swCode = [
      "const C='bc-v1';",
      "self.addEventListener('install',e=>{self.skipWaiting()});",
      "self.addEventListener('activate',e=>{e.waitUntil(self.clients.claim())});",
      "self.addEventListener('fetch',e=>{",
      "  const r=e.request;",
      "  if(r.method!=='GET')return;",
      "  const u=new URL(r.url);",
      "  if(u.origin!==location.origin)return;",   // 跨域（AI 接口）完全放行
      "  if(r.mode==='navigate'){",
      "    e.respondWith(fetch(r).then(res=>{caches.open(C).then(c=>c.put(r,res.clone()));return res})",
      "      .catch(()=>caches.match(r)));return;",
      "  }",
      "  e.respondWith(caches.match(r).then(hit=>hit||fetch(r).then(res=>{",
      "    caches.open(C).then(c=>c.put(r,res.clone()));return res})));",
      "});"
    ].join('\n');
    try {
      const url = URL.createObjectURL(new Blob([swCode], { type: 'text/javascript' }));
      navigator.serviceWorker.register(url).catch(e => console.warn('SW 注册失败', e));
    } catch (e) { console.warn('SW 失败', e); }
  }
}

async function promptInstall() {
  const standalone = window.matchMedia('(display-mode: standalone)').matches
    || window.navigator.standalone;
  if (standalone) return toast('已经装好了——你现在用的就是桌面版');

  /* 安卓 / 桌面 Chrome：系统原生安装弹窗 */
  if (installEvt) {
    installEvt.prompt();
    const r = await installEvt.userChoice.catch(() => null);
    installEvt = null;
    if (r && r.outcome === 'accepted') toast('装好了，去桌面看看');
    else toast('没关系，想装的时候再点一次');
    return;
  }
  openInstallGuide();
}

/* iOS 装 PWA 比较绕，用图文一步步说清楚，比一句 toast 有用得多 */
function openInstallGuide() {
  const ua = navigator.userAgent;
  const isIOS = /iPhone|iPad|iPod/i.test(ua)
    || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);  // iPadOS 伪装成 Mac
  const isSafari = /^((?!chrome|android|crios|fxios|edgios).)*safari/i.test(ua);
  const inApp = /MicroMessenger|QQ\/|WeiBo|Alipay|DingTalk|Feishu|Lark/i.test(ua);
  const isLocal = location.protocol.indexOf('http') !== 0;

  const box = $('#installSteps');
  let h = '';

  if (isLocal) {
    h = step('!', '现在是「直接打开文件」的方式，装不了',
      '手机桌面 App 需要一个网址。把这个 index.html 传到任意静态托管就行，都免费：<br>'
      + '· GitHub Pages（你已经在往这边弄了）<br>· Cloudflare Pages<br>· Vercel / Netlify<br>'
      + '传好之后用手机浏览器打开那个网址，再回来点这个按钮。');
  } else if (inApp) {
    h = step('!', '微信/QQ 里装不了',
      '这些 App 自带的浏览器不支持安装。<br>'
      + '点右上角「···」→ 选「在浏览器打开」（iPhone 选 Safari），再回来点这个按钮。');
  } else if (isIOS && !isSafari) {
    h = step('!', 'iPhone 上只有 Safari 能装',
      '你现在用的不是 Safari。<br>'
      + '复制这个网址，用 <b>Safari</b> 打开，再按下面的步骤做。')
      + urlRow();
  } else if (isIOS) {
    h = step('1', '点屏幕底部中间的「分享」按钮',
      '就是那个<b>方框里一支向上箭头</b>的图标 <span style="font-size:15px">&#x2B06;</span>。<br>'
      + '如果底部工具栏不见了，往下滑一点页面就会出来。')
      + step('2', '在弹出的菜单里往下滑，找「添加到主屏幕」',
        '英文系统显示为 <i>Add to Home Screen</i>，图标是一个<b>带加号的方框</b>。<br>'
        + '它通常在「拷贝」「添加书签」这些下面，要滑一段。')
      + step('3', '右上角点「添加」', '桌面上就会出现「私享衣橱」的图标了。')
      + tip('装好后从桌面图标打开，会是全屏的，没有 Safari 的地址栏和工具栏。<br>'
        + '你的衣服、角色、聊天记录都还在——数据跟浏览器是同一份。');
  } else if (/Android/i.test(ua)) {
    h = step('1', '点浏览器右上角的「⋮」菜单', '')
      + step('2', '选「安装应用」或「添加到主屏幕」',
        '不同浏览器叫法不一样：Chrome 叫「安装应用」，其它的多半叫「添加到主屏幕」。')
      + step('3', '确认', '桌面上就会出现图标。')
      + tip('如果菜单里找不到这一项，多半是网址不是 https 开头。');
  } else {
    h = step('1', '看地址栏右侧',
      'Chrome / Edge 在地址栏右边会有一个<b>带下箭头的小屏幕</b>图标，点它就能装。')
      + step('2', '或者从菜单进', '右上角「⋮」→「投放、保存和共享」→「安装页面为应用」。')
      + tip('装完会变成一个独立窗口的应用，没有浏览器地址栏。');
  }

  box.innerHTML = h;
  closeDw();
  openDw('#dwInstall');

  function step(num, title, body) {
    return '<div class="istep"><div class="inum">' + num + '</div>'
      + '<div class="ibody"><b>' + title + '</b>'
      + (body ? '<p>' + body + '</p>' : '') + '</div></div>';
  }
  function tip(t) {
    return '<div class="hint" style="margin:10px 0 0">' + t + '</div>';
  }
  function urlRow() {
    return '<div class="f" style="margin-top:10px">'
      + '<label>这个网址</label>'
      + '<input type="text" id="installUrl" readonly value="' + escHtml(location.href) + '">'
      + '</div>';
  }
}

/* ------------------------- 17. 启动 ------------------------- */
async function boot() {
  /* logo 先塞进去，开屏第一帧就能看到 */
  const sl = $('#splashLogo'); if (sl) sl.src = LOGO_SRC;
  const bl = $('#brandLogo');  if (bl) bl.src = LOGO_SRC;

  /* 先绑事件、先画界面。任何存储/网络问题都不能让界面变成点不动的死页。 */
  S.cats = DEFAULT_CATS.slice();
  bind();
  drawCats();
  drawGrid();
  drawStats();
  drawLooks();
  drawPickInfo();
  go('closet');

  /* 再加载数据，失败只降级并提示，不中断 */
  try {
    await Store.init();
    const all = await Store.all();
    const cfg = dec(all['cfg'], null) || {};
    if (Array.isArray(cfg.cats) && cfg.cats.length) S.cats = cfg.cats.slice();
    if (S.cats.indexOf('未分类') < 0) S.cats.push('未分类');
    S.pool = normalizePool(cfg.pool);
    S.charId = cfg.charId || null;
    if (cfg.fitMode === 'vision') $('#modeVision').checked = true;
    else $('#modeText').checked = true;
    if (cfg.visionCount) $('#visionCount').value = cfg.visionCount;

    /* 接口配置 */
    const savedAI = dec(all['ai:cfg'], null);
    if (savedAI && typeof savedAI === 'object') AI = Object.assign(AI, savedAI);

    Object.keys(all).forEach(k => {
      if (k.indexOf('it:') === 0) {
        const it = dec(all[k], null);
        if (it && it.id) S.items.push(cleanItemTags(it, cfg.pool));
      } else if (k.indexOf('lk:') === 0) {
        const l = dec(all[k], null);
        if (l && l.id) S.looks.push(l);
      }
    });
    S.items.forEach(i => { if (typeof i.createdAt !== 'number') i.createdAt = 0; });
    S.looks.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));

    /* 外观 / 我存的接口预设 / 模型列表 */
    await loadLook();
    await loadPresets();
    await loadModelList();

    /* 角色 / 我 */
    await Roles.load();
    await loadMe();
    Roles.list.forEach(r => ensureRoleSettings(r, !r.settings));
    await Roles.save();
    /* 头一次用：先建一位，免得聊天页空着没法验证 */
    if (!Roles.list.length) {
      await Roles.add({
        name: '他',
        prompt: '你是{{user}}的私人穿搭顾问，也是她很亲近的人。'
          + '说话有自己的态度，不客套、不端着，会真心夸也会毒舌。'
          + '你能看到她整个衣柜，聊穿搭时会具体说出衣服的名字。',
        greeting: '衣柜我都看过了。今天想穿成什么样？'
      });
    }
    if (!Roles.activeId && Roles.list.length) Roles.activeId = Roles.list[0].id;
    /* 试衣间的角色选择跟聊天保持同一个人 */
    if (!S.charId && Roles.activeId) S.charId = Roles.activeId;
    await Chat.open(Roles.activeId);
  } catch (e) {
    console.error('读取存档失败', e);
    toast('读取存档失败，这次以空衣橱启动（已有数据没有被删）', { duration: 5000 });
  }

  drawCats();
  drawGrid();
  drawStats();
  drawStoreInfo();
  drawLooks();
  syncModeUI();
  drawEnvPill();
  drawSettings();
  drawChatList();
  applyChatLook();
  try { await drawChars(); } catch (e) { console.warn('角色条', e); }

  chatView = 'list';

  /* 没配接口就直接把设置页推到脸前，省得用户对着「识图失败」猜半天 */
  if (!apiReady()) {
    go('set');
    const f = $('#foldApi'); if (f) f.open = true;
    toast('先配一下 AI 接口，识图和聊天都要用它', { duration: 6000 });
  }

  /* 界面已经就绪，收开屏。留一点点时间让首屏画完，不然会闪。 */
  hideSplash(260);

  initPwa();
}

/* 收开屏。做成独立函数是因为启动失败时也要收，否则用户对着 logo 干等。 */
let splashHidden = false;
function hideSplash(delay) {
  if (splashHidden) return;
  splashHidden = true;
  setTimeout(() => {
    const sp = $('#splash');
    if (!sp) return;
    sp.classList.add('gone');
    /* 淡出动画结束后彻底移除，省得它一直挂在 DOM 上挡事件 */
    setTimeout(() => { if (sp.parentNode) sp.parentNode.removeChild(sp); }, 600);
  }, delay || 0);
}

boot().catch(e => {
  console.error('启动失败', e);
  hideSplash(0);   // 出错了也得把开屏收掉，不然用户对着 logo 干瞪眼
  toast('启动出错了：' + ((e && e.message) || e), { duration: 6000 });
});

/* 兜底：万一 boot 卡在某个 await 上（比如存储权限弹窗），
   4 秒后强制收开屏，至少让用户能操作界面。 */
setTimeout(() => hideSplash(0), 4000);
</script>
</body>
</html>
